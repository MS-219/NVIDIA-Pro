.tab-bar { position: fixed; z-index: 9999; left: 0; right: 0; bottom: 0; height: 60px; padding-bottom: env(safe-area-inset-bottom); display: grid; grid-template-columns: repeat(4,1fr); background: rgba(255,255,255,.82); border-top: 1px solid rgba(28,33,27,.1); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
.tab-bar-item { min-width: 0; min-height: 60px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #737a70; font-size: 11px; font-weight: 600; }
.cover-image { width: 24px; height: 24px; opacity: .52; filter: grayscale(1); }.cover-image.is-active { opacity: 1; filter: none; }
.scan-btn { width: 38px; height: 30px; display: flex; align-items: center; justify-content: center; background: #76b900; border-radius: 6px; }.scan-icon { width: 19px; height: 19px; filter: brightness(0); }.scan-text { color: #548600; }.tab-bar-item:active { opacity: .62; }
