.tab-bar { position: fixed; z-index: 9999; left: 0; right: 0; bottom: 0; height: 60px; padding-bottom: env(safe-area-inset-bottom); display: grid; grid-template-columns: repeat(4,1fr); background: rgba(8,10,8,.88); border-top: 1px solid rgba(255,255,255,.11); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
.tab-bar-item { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #858d81; font-size: 10px; font-weight: 600; }
.cover-image { width: 23px; height: 23px; opacity: .58; filter: grayscale(1) brightness(2.2); }.cover-image.is-active { opacity: 1; filter: none; }
.scan-btn { width: 34px; height: 27px; display: flex; align-items: center; justify-content: center; background: #76b900; border-radius: 6px; }.scan-icon { width: 18px; height: 18px; filter: brightness(0); }.scan-text { color: #8dd214; }.tab-bar-item:active { opacity: .62; }
