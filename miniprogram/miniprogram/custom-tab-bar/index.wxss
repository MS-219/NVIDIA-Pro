.tab-bar {
  position: fixed;
  z-index: 100;
  left: 10px;
  right: 10px;
  bottom: 8px;
  height: 64px;
  padding: 0 5px env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: rgba(255, 255, 255, .94);
  border: 1px solid rgba(51, 72, 56, .1);
  border-radius: 20px;
  box-shadow: 0 14px 38px rgba(35, 55, 40, .16), inset 0 1px rgba(255, 255, 255, .92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.tab-bar-item {
  position: relative;
  min-width: 0;
  min-height: 64px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: #7d887f;
  font-size: 10px;
  font-weight: 600;
  transition: opacity .18s ease, transform .18s ease;
}

.tab-bar-item:active {
  opacity: .7;
  transform: scale(.96);
}

.cover-image {
  width: 23px;
  height: 23px;
  opacity: .5;
  filter: grayscale(1);
  transition: opacity .18s ease, transform .18s ease, filter .18s ease;
}

.cover-image.is-active {
  opacity: 1;
  filter: none;
  transform: translateY(-1px);
}

.tab-bar-item:not(.scan-btn-wrapper) view:last-child {
  line-height: 14px;
}

.scan-btn-wrapper {
  justify-content: flex-start;
  padding-top: 2px;
  box-sizing: border-box;
}

.scan-btn {
  width: 52px;
  height: 52px;
  margin-top: -18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #7bc000, #5c9300);
  border: 5px solid #f7f9f6;
  border-radius: 18px;
  box-shadow: 0 10px 22px rgba(84, 132, 8, .27);
}

.scan-icon {
  width: 23px;
  height: 23px;
  filter: brightness(0) invert(1);
}

.scan-text {
  margin-top: 1px;
  color: #527f0b;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 340px) {
  .tab-bar { left: 7px; right: 7px; }
  .tab-bar-item { font-size: 9px; }
}
