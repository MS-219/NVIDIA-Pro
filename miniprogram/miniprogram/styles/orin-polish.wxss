/* Shared polish layer for every secondary mini-program workflow. */
page {
  background: var(--jx-canvas, #f4f7f3) !important;
  color: var(--jx-ink, #1c211b);
}

.container {
  box-sizing: border-box;
}

.custom-nav,
.nav-bar {
  background: rgba(255, 255, 255, .82) !important;
  border-bottom: 1px solid rgba(28, 33, 27, .08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.nav-title {
  color: #1c211b !important;
  font-weight: 700 !important;
}

.nav-back,
.back-btn {
  min-width: 44px;
  min-height: 44px;
  border-radius: 11px !important;
}

/* Glass surfaces */
.form-card,
.section,
.chart-card,
.reward-card,
.monthly-card,
.daily-card,
.team-stats-card,
.team-list-card,
.summary-card,
.member-card,
.filter-card,
.device-item,
.device-card,
.owner-card,
.earnings-card,
.faq-item,
.contact-section,
.content-area,
.notice-content,
.detail-card,
.product-card,
.address-card,
.order-card,
.section-card,
.addr-card,
.record-item,
.withdraw-form-card,
.payment-card,
.limit-card,
.withdraw-limit-card,
.contract-card,
.rule-card,
.tips-card,
.agreement-card {
  background: rgba(255, 255, 255, .94) !important;
  border: 1px solid rgba(28, 33, 27, .075) !important;
  border-radius: 15px !important;
  box-shadow: 0 12px 30px rgba(35, 55, 40, .055) !important;
}

.card,
.input-card,
.contract-manage-card,
.inviter-card,
.members-card,
.users-card,
.rules-card,
.stats-card,
.qty-card,
.qr-upload-box,
.modal-content,
.daily-table,
.monthly-table,
.sub-tabs-bar,
.tab-scroll,
.pending-banner,
.level-tip,
.level-badge-bar,
.form-section,
.submit-section,
.safe-footer,
.bind-prompt {
  background: rgba(255, 255, 255, .94) !important;
  border: 1px solid rgba(28, 33, 27, .075) !important;
  border-radius: 15px !important;
  box-shadow: 0 12px 30px rgba(35, 55, 40, .055) !important;
}

/* Branded feature headers remain the single high-contrast surface per page. */
.balance-card,
.hero-card,
.status-card,
.status-hero,
.hashrate-info {
  background: #151a14 !important;
  border: 1px solid rgba(118, 185, 0, .24) !important;
  border-radius: 16px !important;
  box-shadow: 0 16px 38px rgba(22, 32, 24, .14) !important;
}

.balance-card::before,
.hero-card::before,
.status-card::before,
.status-hero::before,
.hashrate-info::before {
  background: #76b900 !important;
}

.balance-card,
.balance-card text,
.hero-card,
.hero-card text,
.status-card,
.status-card text,
.status-hero,
.status-hero text {
  color: #f7f9f5;
}

.hashrate-info,
.hashrate-info text {
  color: #f7f9f5 !important;
}

.hashrate-info .hashrate-amount,
.hashrate-info .hashrate-icon {
  color: #8dd214 !important;
}

/* Inputs and choice controls */
.nickname-input,
.content-input,
.contact-input,
.amount-input,
.form-input,
.input-field,
.textarea,
.address-input,
.picker-field,
.select-field,
.bank-input {
  min-height: 44px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .72) !important;
  border: 1px solid rgba(28, 33, 27, .1) !important;
  border-radius: 11px !important;
  color: #252a24 !important;
  font-size: 13px !important;
  box-shadow: none !important;
}

.field-input,
.account-input,
.card-input,
.picker-input,
.code-input,
.modal-input {
  min-height: 44px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .72) !important;
  border: 1px solid rgba(28, 33, 27, .1) !important;
  border-radius: 11px !important;
  color: #252a24 !important;
  font-size: 13px !important;
  box-shadow: none !important;
}

.type-item,
.filter-tab,
.tab-item,
.quick-btn,
.qty-btn,
.price-row,
.popup-addr-item {
  min-height: 44px;
  border-radius: 11px !important;
}

.type-option,
.radio-item,
.switch-item,
.sub-tab {
  min-height: 44px;
  box-sizing: border-box;
  border-radius: 11px !important;
}

.type-item.active,
.filter-tab.active,
.tab-active,
.price-row-active,
.addr-active {
  background: rgba(118, 185, 0, .13) !important;
  border-color: rgba(118, 185, 0, .34) !important;
  color: #4f7f00 !important;
  box-shadow: none !important;
}

/* Primary and secondary commands */
page .save-btn,
page .submit-btn,
page .action-btn,
page .primary-btn,
page .contact-btn,
page .share-btn,
page .invite-btn,
page .exchange-btn,
page .confirm-btn,
page .add-btn,
page .bind-btn,
page .contract-btn {
  min-height: 44px;
  background: #76b900 !important;
  border: 0 !important;
  border-radius: 11px !important;
  color: #0b0e0a !important;
  box-shadow: 0 9px 20px rgba(82, 129, 9, .16) !important;
  font-size: 13px !important;
  font-weight: 700 !important;
}

page button[disabled],
page .btn-disabled,
page .submit-btn.disabled,
page .save-btn.disabled {
  background: #d9ded6 !important;
  border-color: #d9ded6 !important;
  color: #737b70 !important;
  box-shadow: none !important;
  opacity: .82;
  transform: none !important;
}

page .skip-btn,
page .cancel-btn,
page .record-btn,
page .secondary-btn,
page .edit-card-btn,
page .modal-btn,
page .popup-add {
  min-height: 44px;
  background: rgba(255, 255, 255, .7) !important;
  border: 1px solid rgba(28, 33, 27, .1) !important;
  border-radius: 11px !important;
  color: #5f675d !important;
  font-size: 13px !important;
  box-shadow: none !important;
}

page .danger-btn,
page .cancel-contract-btn {
  min-height: 44px;
  background: rgba(190, 79, 68, .1) !important;
  border: 1px solid rgba(190, 79, 68, .24) !important;
  border-radius: 11px !important;
  color: #a14f47 !important;
  box-shadow: none !important;
}

page .save-btn:active,
page .submit-btn:active,
page .action-btn:active,
page .primary-btn:active,
page .contact-btn:active,
page .share-btn:active,
page .invite-btn:active,
page .exchange-btn:active,
page .confirm-btn:active,
page .add-btn:active,
page .bind-btn:active,
page .contract-btn:active,
page .secondary-btn:active,
page .record-btn:active,
page .modal-btn:active {
  opacity: .78;
  transform: scale(.985);
}

.copy-btn,
.addr-default,
.price-current-badge,
.popup-addr-default,
.level-badge,
.current-level,
.order-status,
.record-status,
.device-status,
.hero-badge,
.fail-badge {
  min-height: 22px;
  box-sizing: border-box;
  font-size: 11px !important;
  border-radius: 999px !important;
}

.copy-btn,
.addr-default,
.price-current-badge,
.popup-addr-default,
.current-level {
  background: rgba(118, 185, 0, .13) !important;
  color: #4f7f00 !important;
}

/* Product, avatar and upload media */
.detail-image,
.product-image,
.order-product-img,
.product-thumb,
.notice-image,
.image-item,
.add-image,
.device-icon {
  border-radius: 13px !important;
}

.member-avatar,
.owner-avatar,
.avatar-wrapper,
.avatar-btn,
.avatar-img,
.avatar-placeholder {
  border-radius: 50% !important;
}

/* Flat status treatments replacing legacy gradients. */
.success-bg,
.status-bg-3 {
  background: #e8f3d9 !important;
  color: #477400 !important;
}

.pending-bg,
.status-bg-0 {
  background: #fff3d9 !important;
  color: #8b610e !important;
}

.fail-bg,
.status-bg-4 {
  background: #fbe5e2 !important;
  color: #9a4e46 !important;
}

.cancel-bg,
.status-bg-2 {
  background: #ecefeb !important;
  color: #666e63 !important;
}

.status-bg-1 {
  background: #e2f0ef !important;
  color: #216f6a !important;
}

.bottom-bar,
.bottom-actions,
.fixed-bottom,
.action-footer {
  background: rgba(255, 255, 255, .84) !important;
  border-top: 1px solid rgba(28, 33, 27, .09) !important;
  box-shadow: none !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.address-popup {
  background: rgba(247, 249, 246, .94) !important;
  border-radius: 20px 20px 0 0 !important;
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.empty-state,
.loading-state {
  color: #7b8378 !important;
}

/* Premium secondary-page system */
.container,
.detail-page,
.scrollarea {
  background:
    radial-gradient(circle at 92% 2%, rgba(118, 185, 0, .075), transparent 21%),
    #f4f7f3 !important;
}

.custom-nav,
.nav-bar,
.detail-nav {
  background: rgba(255, 255, 255, .91) !important;
  border-bottom-color: rgba(52, 73, 57, .075) !important;
  box-shadow: 0 7px 22px rgba(35, 55, 40, .035) !important;
}

.nav-title,
.navbar-title,
.nav-heading {
  color: #18231b !important;
  font-size: 18px !important;
  font-weight: 720 !important;
  letter-spacing: -.025em;
}

.section-heading,
.section-head,
.section-header,
.card-header,
.summary-header,
.notice-header {
  color: #1d2921;
}

.section-heading text:first-child,
.section-head text:first-child,
.section-header .section-title,
.card-title,
.summary-title,
.notice-title {
  color: #1d2921 !important;
  font-weight: 700 !important;
  letter-spacing: -.02em;
}

.section-heading text:nth-child(2),
.section-code,
.section-kicker,
.console-kicker,
.detail-kicker,
.identity-kicker,
.telemetry-kicker,
.card-kicker,
.anchor-kicker,
.notice-kicker {
  color: #718077 !important;
  font-family: inherit !important;
  letter-spacing: .04em !important;
}

.overview-card,
.invite-card,
.node-hero,
.product-hero,
.order-anchor,
.ledger-anchor,
.identity-panel,
.status-gate {
  border: 1px solid rgba(58, 78, 63, .1) !important;
  border-radius: 18px !important;
  box-shadow: 0 17px 42px rgba(35, 55, 40, .08) !important;
}

.product-card,
.order-card,
.addr-card,
.record-item,
.device-item,
.member-card,
.owner-card,
.detail-card,
.section-card,
.form-card,
.section,
.faq-item,
.contact-section,
.content-area,
.notice-content {
  border-color: rgba(58, 78, 63, .09) !important;
  border-radius: 16px !important;
  background: rgba(255, 255, 255, .96) !important;
  box-shadow: 0 12px 31px rgba(35, 55, 40, .06) !important;
}

.product-card:active,
.order-card:active,
.addr-card:active,
.record-item:active,
.device-item:active,
.member-card:active,
.faq-item:active {
  opacity: .82;
  transform: scale(.99);
}

.filter-tabs,
.tab-bar,
.sub-tabs-bar,
.tab-scroll {
  border-radius: 13px !important;
}

.filter-tab,
.tab-item,
.sub-tab {
  min-height: 44px !important;
  border-radius: 10px !important;
}

.filter-tab.active,
.tab-active,
.sub-tab.active {
  color: #4f7f06 !important;
  background: #ffffff !important;
  box-shadow: 0 5px 15px rgba(39, 58, 44, .08) !important;
}

.state-mark,
.error-mark,
.gate-error-mark,
.empty-icon,
.status-glyph,
.notice-mark,
.tip-mark,
.section-mark,
.anchor-icon {
  border-radius: 11px !important;
}

.page-error,
.error-state,
.empty-state,
.loading-state,
.page-loading,
.status-gate {
  color: #748078 !important;
}

.state-title,
.error-title,
.gate-title,
.empty-text {
  color: #1e2a22 !important;
  font-size: 16px !important;
  font-weight: 700 !important;
}

.state-desc,
.error-message,
.gate-desc {
  color: #7d8981 !important;
  font-size: 12px !important;
  line-height: 1.7 !important;
}

.bottom-bar,
.bottom-actions,
.fixed-bottom,
.action-footer {
  background: rgba(255, 255, 255, .92) !important;
  border-top-color: rgba(52, 73, 57, .08) !important;
  box-shadow: 0 -10px 30px rgba(35, 55, 40, .07) !important;
}

.modal-content,
.address-popup {
  box-shadow: 0 -16px 48px rgba(27, 44, 32, .16) !important;
}

.jx-skeleton,
.skeleton {
  border-radius: 11px;
}
