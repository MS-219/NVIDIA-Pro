<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px; height: {{navBarHeight}}px;">
        <view class="nav-back" bindtap="onGoBack" hover-class="tap-muted" aria-role="button" aria-label="返回上一页"><text>‹</text></view>
        <text class="nav-title">订单详情</text><view class="nav-placeholder"></view>
    </view>

    <view class="page-loading" wx:if="{{loading && !loaded}}"><view class="status-skeleton jx-skeleton"></view><view class="panel-skeleton jx-skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view></view>

    <view class="page-error" wx:elif="{{errorMessage && !order}}"><view class="state-mark"><view></view><text>ORDER LINK</text></view><text class="state-title">订单详情同步中断</text><text class="state-desc">{{errorMessage}}</text><button bindtap="retryDetail">重新加载</button></view>

    <block wx:elif="{{order}}">
        <view class="status-card status-tone-{{order.status}}">
            <view class="status-glyph"><view></view><view></view><view></view></view>
            <view class="status-copy"><text>DELIVERY STATUS</text><text>{{statusTexts[order.status]}}</text><text>订单 {{order.orderNo}}</text></view>
            <view class="status-live"><view></view><text>{{loading ? '更新中' : '已同步'}}</text></view>
        </view>

        <view class="section-card" wx:if="{{order.expressNo}}">
            <view class="section-heading"><view><text>物流信息</text><text>DELIVERY LINK</text></view></view>
            <view class="express-row"><text class="express-label">快递公司</text><text class="express-value">{{order.expressCompany || '--'}}</text></view>
            <view class="express-row"><text class="express-label">快递单号</text><view class="express-copy-row"><text class="express-value mono">{{order.expressNo}}</text><button class="copy-btn" bindtap="copyExpressNo">复制</button></view></view>
        </view>

        <view class="section-card" wx:if="{{order.expressNo}}">
            <view class="section-heading"><view><text>实时物流</text><text>TRACKING FEED</text></view><text wx:if="{{expressLogistics.length}}">{{expressLogistics.length}} 条</text></view>
            <view class="inline-state" wx:if="{{logisticsLoading}}"><view class="mini-spinner"></view><text>轨迹同步中</text></view>
            <view class="inline-state is-error" wx:elif="{{logisticsError}}"><text>{{logisticsError}}</text><button bindtap="retryLogistics">重试</button></view>
            <view class="timeline" wx:elif="{{expressLogistics.length}}">
                <view class="timeline-item {{index === 0 ? 'timeline-active' : ''}}" wx:for="{{expressLogistics}}" wx:key="index"><view class="timeline-dot"></view><view class="timeline-line" wx:if="{{index < expressLogistics.length - 1}}"></view><view class="timeline-content"><text class="timeline-desc">{{item.status}}</text><text class="timeline-time">{{item.time}}</text></view></view>
            </view>
            <view class="inline-state" wx:else><text>物流轨迹待承运方更新</text></view>
        </view>

        <view class="section-card">
            <view class="section-heading"><view><text>收货信息</text><text>DESTINATION</text></view></view>
            <view class="info-row"><text class="info-label">收货人</text><text class="info-value">{{order.receiverName}} {{order.receiverPhone}}</text></view>
            <view class="info-row"><text class="info-label">地址</text><text class="info-value">{{order.receiverAddress}}</text></view>
        </view>

        <view class="section-card">
            <view class="section-heading"><view><text>设备信息</text><text>HARDWARE</text></view></view>
            <view class="product-row"><image class="product-thumb" src="{{order.productImage || '/images/product.png'}}" mode="aspectFit"></image><view class="product-detail"><text class="product-name">{{order.productName}}</text><text class="product-qty">兑换数量 {{order.quantity}}</text></view></view>
        </view>

        <view class="section-card">
            <view class="section-heading"><view><text>订单档案</text><text>ORDER IDENTITY</text></view></view>
            <view class="info-row"><text class="info-label">订单编号</text><text class="info-value mono">{{order.orderNo}}</text></view>
            <view class="info-row"><text class="info-label">消耗权益</text><view class="info-value cost-value"><image src="/images/menu/earnings.png" mode="aspectFit"></image><text>{{order.hashrateCost}}</text></view></view>
            <view class="info-row"><text class="info-label">等值金额</text><text class="info-value">¥{{order.totalPrice}}</text></view>
            <view class="info-row"><text class="info-label">下单时间</text><text class="info-value mono">{{order.createTime}}</text></view>
            <view class="info-row" wx:if="{{order.remark}}"><text class="info-label">备注</text><text class="info-value">{{order.remark}}</text></view>
        </view>

        <view class="bottom-actions" wx:if="{{order.status === 1 || order.status === 2}}"><button class="confirm-btn" bindtap="confirmReceive" loading="{{confirming}}" disabled="{{confirming}}">{{confirming ? '确认中' : '确认收到设备'}}</button></view>
        <view class="safe-space"></view>
    </block>
</view>
