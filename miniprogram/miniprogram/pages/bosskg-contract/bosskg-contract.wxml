<view class="container">
    <view class="status-gate" wx:if="{{!showForm && !statusError && (statusLoading || contractStatus === null)}}">
        <view class="gate-spinner"></view>
        <text class="gate-title">正在同步签约状态</text>
        <text class="gate-code">正在同步签约状态</text>
    </view>
    <view class="status-gate is-error" wx:elif="{{statusError && !showForm}}">
        <view class="gate-error-mark">!</view>
        <text class="gate-title">签约状态同步中断</text>
        <text class="gate-desc">{{statusError}}</text>
        <button class="retry-btn" bindtap="retryStatus">重新同步</button>
    </view>
    <view class="status-section" wx:elif="{{contractStatus !== null && !showForm}}">
        <block wx:if="{{contractStatus === 1}}">
            <view class="status-hero success-bg">
                <view class="status-head"><text>签约状态</text><view class="status-signal"></view></view>
                <view class="status-glyph success-glyph"></view>
                <text class="status-title">签约成功</text>
                <text class="status-subtitle">实名与收款信息已完成核验，提现通道已开放</text>
                <text class="status-code">已认证 · 生效中</text>
            </view>
        </block>
        <block wx:elif="{{contractStatus === 3}}">
            <view class="status-hero pending-bg">
                <view class="status-head"><text>签约状态</text><view class="status-signal"></view></view>
                <view class="status-glyph pending-glyph"><view></view></view>
                <text class="status-title">审核中</text>
                <text class="status-subtitle">申请已提交，通常在 1-5 分钟内完成审核</text>
                <text class="status-code">认证中 · 请等待</text>
            </view>
        </block>
        <block wx:elif="{{contractStatus === 2}}">
            <view class="status-hero fail-bg">
                <view class="status-head"><text>签约状态</text><view class="status-signal"></view></view>
                <view class="status-glyph fail-glyph"></view>
                <text class="status-title">审核失败</text>
                <text class="status-subtitle">{{failReason || '经审核，您的身份信息不符合要求'}}</text>
                <text class="status-code">需要重新处理</text>
            </view>
            <view class="action-area"><button class="action-btn" bindtap="resetForm">重新申请</button></view>
        </block>
        <block wx:elif="{{contractStatus === 5}}">
            <view class="status-hero cancel-bg">
                <view class="status-head"><text>签约状态</text><view class="status-signal"></view></view>
                <view class="status-glyph document-glyph"><view></view></view>
                <text class="status-title">签约已解除</text>
                <text class="status-subtitle">签约已失效，重新完成核验后可恢复提现</text>
                <text class="status-code">未生效 · 已关闭</text>
            </view>
            <view class="action-area"><button class="action-btn" bindtap="resetForm">重新申请</button></view>
        </block>
        <block wx:else>
            <view class="status-hero default-bg">
                <view class="status-head"><text>签约状态</text><view class="status-signal"></view></view>
                <view class="status-glyph document-glyph"><view></view></view>
                <text class="status-title">等待签约</text>
                <text class="status-subtitle">提交身份与银行卡信息后进入人脸识别</text>
                <text class="status-code">等待身份认证</text>
            </view>
            <view class="action-area"><button class="action-btn" bindtap="resetForm">开始签约</button></view>
        </block>
    </view>

    <view class="form-section" wx:else>
        <view class="form-telemetry">
            <view class="status-head"><text>身份认证流程</text><view class="status-signal"></view></view>
            <text class="telemetry-title">实名签约</text>
            <text class="telemetry-subtitle">一次录入身份与结算信息，下一步进入人脸识别</text>
            <view class="telemetry-meta">
                <text>银行卡结算</text>
                <text>安全加密连接</text>
            </view>
        </view>

        <view class="steps-bar">
            <view class="step active"><view class="step-num">1</view><text class="step-text">填写信息</text></view>
            <view class="step-line active-line"></view>
            <view class="step"><view class="step-num">2</view><text class="step-text">人脸识别</text></view>
            <view class="step-line"></view>
            <view class="step"><view class="step-num">3</view><text class="step-text">签约完成</text></view>
        </view>

        <view class="card">
            <view class="card-header">
                <view class="card-mark identity-mark"><view></view></view>
                <view>
                    <text class="card-kicker">身份信息</text>
                    <text class="card-title">身份信息</text>
                </view>
            </view>
            <view class="field">
                <text class="field-label">真实姓名</text>
                <input class="field-input" placeholder="请填写真实姓名" value="{{form.realName}}" bindinput="onInput" data-field="realName" />
            </view>
            <view class="field">
                <text class="field-label">身份证号</text>
                <input class="field-input" type="idcard" placeholder="请输入 18 位身份证号" value="{{form.idCard}}" bindinput="onInput" data-field="idCard" maxlength="18" />
            </view>
            <view class="field last">
                <text class="field-label">手机号</text>
                <input class="field-input" type="number" placeholder="请输入银行预留手机号" value="{{form.mobile}}" bindinput="onInput" data-field="mobile" maxlength="11" />
            </view>
        </view>

        <view class="card">
            <view class="card-header">
                <view class="card-mark identity-mark"><view></view></view>
                <view>
                    <text class="card-kicker">身份证件</text>
                    <text class="card-title">身份证照片</text>
                </view>
            </view>
            <view class="photo-grid">
                <view class="photo-upload" bindtap="uploadPhoto" data-side="front">
                    <image wx:if="{{form.idCardFront}}" src="{{form.idCardFront}}" mode="aspectFill"></image>
                    <view wx:else class="photo-placeholder"><text class="photo-plus">+</text><text>上传人像面</text></view>
                </view>
                <view class="photo-upload" bindtap="uploadPhoto" data-side="back">
                    <image wx:if="{{form.idCardBack}}" src="{{form.idCardBack}}" mode="aspectFill"></image>
                    <view wx:else class="photo-placeholder"><text class="photo-plus">+</text><text>上传国徽面</text></view>
                </view>
            </view>
            <text class="photo-tip">图片仅用于佣金保实名签约，请确保完整、清晰且小于 1MB</text>
        </view>

        <view class="card">
            <view class="card-header">
                <view class="card-mark bank-mark"><view></view></view>
                <view>
                    <text class="card-kicker">结算信息</text>
                    <text class="card-title">收款银行卡</text>
                </view>
            </view>
            <view class="field last">
                <text class="field-label">银行卡号</text>
                <input class="field-input" type="number" placeholder="请输入银行卡号" value="{{form.cardNo}}" bindinput="onInput" data-field="cardNo" />
            </view>
        </view>

        <view class="agreement">
            <view class="agree-row">
                <checkbox-group bindchange="onAgreementChange">
                  <label class="agree-toggle">
                    <checkbox value="agree" checked="{{agreed}}" color="#76B900" />
                    <text class="agree-text">我已阅读并同意</text>
                  </label>
                </checkbox-group>
                <text class="agree-link" catchtap="showProtocol">《灵活用工服务协议》</text>
            </view>
        </view>

        <button class="submit-btn {{!canSubmit ? 'btn-disabled' : ''}}" bindtap="submitForm" loading="{{submitting}}" disabled="{{!canSubmit || submitting}}">{{submitting ? '跳转中...' : '提交并进行人脸识别'}}</button>

        <view class="tips">
            <view class="tip-row"><text class="tip-index">01</text><text>身份信息仅用于劳务报酬实名核验</text></view>
            <view class="tip-row"><text class="tip-index">02</text><text>完成人脸识别后自动生成服务协议</text></view>
            <view class="tip-row"><text class="tip-index">03</text><text>审核通过后可发起提现申请</text></view>
        </view>
    </view>

    <view class="safe-footer">
        <view class="lock-mark"><view></view></view>
        <text class="safe-text">信息加密传输，仅用于合规核验</text>
    </view>
</view>
