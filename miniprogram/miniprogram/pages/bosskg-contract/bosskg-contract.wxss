@import "../../styles/orin-polish.wxss";

page {
    background: linear-gradient(180deg, #f0fdf4 0%, #f7f7f9 60%);
    min-height: 100vh;
}

.container {
    padding: 16px 20px 40px;
}

/* ========== 状态展示 ========== */
.status-section {
    padding-top: 20px;
}

.status-hero {
    border-radius: 20px;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
}

.success-bg {
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
}

.pending-bg {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.fail-bg {
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.cancel-bg {
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
}

.default-bg {
    background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
}

.status-emoji {
    font-size: 48px;
    margin-bottom: 16px;
}

.status-title {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
}

.status-subtitle {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
    max-width: 260px;
}

.action-area {
    margin-top: 24px;
}

.action-btn {
    width: 200px;
    height: 48px;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    border-radius: 24px;
    border: none;
    box-shadow: 0 4px 16px rgba(22, 163, 74, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
}

.action-btn:active {
    transform: scale(0.97);
    opacity: 0.9;
}

/* ========== 步骤条 ========== */
.steps-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    padding: 0 10px;
}

.step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.step.active .step-num {
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: #fff;
    box-shadow: 0 2px 8px rgba(22, 163, 74, 0.3);
}

.step-text {
    font-size: 11px;
    color: #94a3b8;
    font-weight: 500;
}

.step.active .step-text {
    color: #16a34a;
    font-weight: 600;
}

.step-line {
    width: 40px;
    height: 2px;
    background: #e2e8f0;
    margin: 0 8px;
    margin-bottom: 18px;
}

/* ========== 卡片 ========== */
.card {
    background: #fff;
    border-radius: 16px;
    padding: 0;
    margin-bottom: 16px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    overflow: hidden;
}

.card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 18px 0;
}

.card-icon {
    font-size: 18px;
}

.card-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
}

.field {
    padding: 14px 18px;
    border-bottom: 1px solid #f3f4f6;
}

.field.last {
    border-bottom: none;
}

.field-label {
    display: block;
    font-size: 12px;
    color: #9ca3af;
    margin-bottom: 8px;
    font-weight: 500;
}

.field-input {
    width: 100%;
    height: 44px;
    background: #f8fafb;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 15px;
    color: #1a1a1a;
    box-sizing: border-box;
    border: 1.5px solid #e5e7eb;
}

.field-input:focus {
    border-color: #16a34a;
}

/* ========== 单选 ========== */
.radio-row {
    display: flex;
    gap: 16px;
    margin-top: 4px;
}

.radio-option {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: #374151;
    padding: 8px 16px;
    background: #f8fafb;
    border-radius: 10px;
    border: 1.5px solid #e5e7eb;
}

.radio-option.selected {
    background: #f0fdf4;
    border-color: #16a34a;
    color: #15803d;
}

/* ========== 协议 ========== */
.agreement {
    margin: 20px 0 0;
}

.agree-row {
    display: flex;
    align-items: flex-start;
    font-size: 12px;
    color: #6b7280;
}

.agree-text {
    margin-top: 2px;
}

.agree-link {
    color: #16a34a;
    margin-top: 2px;
    font-weight: 500;
}

/* ========== 提交 ========== */
.submit-btn {
    margin: 24px 0 16px;
    width: 100%;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(22, 163, 74, 0.3);
    border: none;
    padding: 0;
}

.submit-btn:active {
    transform: scale(0.98);
    opacity: 0.9;
}

.btn-disabled {
    background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%) !important;
    box-shadow: none !important;
}

/* ========== 提示 ========== */
.tips {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.tips text {
    font-size: 12px;
    color: #9ca3af;
    line-height: 1.6;
}

/* ========== 底部安全 ========== */
.safe-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 30px 0 20px;
}

.safe-icon {
    font-size: 14px;
}

.safe-text {
    font-size: 12px;
    color: #c0c5cc;
    font-weight: 500;
}