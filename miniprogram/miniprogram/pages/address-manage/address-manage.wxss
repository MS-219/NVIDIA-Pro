@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed;
    color: #1c211b;
}

.container {
    min-height: 100vh;
    padding: 0 12px 40px;
    box-sizing: border-box;
}

.custom-nav {
    margin: 0 -12px 16px;
    padding-left: 12px;
    padding-right: 12px;
    box-sizing: content-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, .9);
    border-bottom: 1px solid rgba(28, 33, 27, .08);
}

.nav-back,
.nav-placeholder {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
}

.nav-back {
    display: flex;
    align-items: center;
    color: #343a32;
    font-size: 28px;
}

.nav-title {
    min-width: 0;
    color: #1c211b;
    font-size: 18px;
    font-weight: 700;
    text-align: center;
}

.addr-card {
    margin-bottom: 10px;
    overflow: hidden;
    background: #fff !important;
    border: 1px solid rgba(28, 33, 27, .075) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.addr-main {
    min-height: 82px;
    padding: 16px;
    box-sizing: border-box;
}

.addr-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
}

.addr-name {
    color: #1c211b;
    font-size: 16px;
    font-weight: 700;
}

.addr-phone {
    color: #737b70;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 13px;
}

.addr-default {
    min-height: 22px;
    padding: 0 7px;
    display: flex;
    align-items: center;
    background: rgba(118, 185, 0, .12) !important;
    color: #4f7f00 !important;
    font-size: 11px;
    font-weight: 700;
    border-radius: 4px !important;
}

.addr-detail {
    display: block;
    color: #7d8579;
    font-size: 13px;
    line-height: 20px;
}

.addr-actions {
    min-height: 56px;
    padding: 6px 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    background: #f8faf7;
    border-top: 1px solid rgba(28, 33, 27, .065);
}

.address-action {
    min-width: 72px;
    min-height: 44px;
    padding: 0 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef3ed;
    border: 1px solid rgba(28, 33, 27, .08);
    color: #4f665d;
    font-size: 12px;
    font-weight: 650;
    white-space: nowrap;
    border-radius: 6px;
}

.address-action.delete {
    min-width: 60px;
    background: rgba(198, 90, 82, .09);
    border-color: rgba(198, 90, 82, .2);
    color: #a7524a;
}

.empty-state {
    padding: 96px 0 54px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
}

.empty-icon {
    width: 68px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #121611;
    border: 1px solid rgba(118, 185, 0, .25);
    color: #9dda39;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
    font-weight: 800;
    border-radius: 8px;
}

.empty-text {
    color: #7d8579;
    font-size: 14px;
}

page .add-btn {
    width: 100% !important;
    height: 44px !important;
    margin: 16px 0 0 !important;
    padding: 0 !important;
    line-height: 44px !important;
    background: #76b900 !important;
    border-radius: 7px !important;
    color: #0b0e0a !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    box-shadow: none !important;
}

.form-card {
    overflow: hidden;
    background: #fff !important;
    border: 1px solid rgba(28, 33, 27, .075) !important;
    border-radius: 8px !important;
}

.form-item {
    min-height: 64px;
    padding: 10px 16px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(28, 33, 27, .065);
}

.form-item:last-child {
    border-bottom: 0;
}

.switch-item {
    justify-content: space-between;
}

.form-label {
    min-width: 76px;
    flex: 0 0 auto;
    color: #4f574d;
    font-size: 13px;
    font-weight: 650;
}

.form-input {
    min-width: 0;
    min-height: 44px;
    flex: 1;
    display: flex;
    align-items: center;
    color: #1c211b;
    font-size: 14px;
}

.picker-input {
    color: #737b70;
}

.form-actions {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

page .save-btn,
page .cancel-btn {
    width: 100% !important;
    height: 44px !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 44px !important;
    border-radius: 7px !important;
    font-size: 13px !important;
    box-shadow: none !important;
}
