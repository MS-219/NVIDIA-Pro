page { background: #080a08; color: #f5f7f3; }.device-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #080a08; }
.device-nav { box-sizing: content-box; flex: 0 0 auto; padding: 0 98px 0 18px; display: flex; align-items: center; background: rgba(8,10,8,.82); border-bottom: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.navbar-title,.navbar-subtitle { display: block; }.navbar-title { color: #fff; font-size: 18px; font-weight: 700; }.navbar-subtitle { margin-top: 2px; color: #8b9487; font-size: 9px; }
.device-summary { flex: 0 0 auto; margin: 10px 12px 0; display: grid; grid-template-columns: repeat(3,1fr); background: rgba(255,255,255,.065); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.device-summary > view { min-width: 0; padding: 14px 16px; border-right: 1px solid rgba(255,255,255,.09); }.device-summary > view:last-child { border-right: 0; }.device-summary text { display: block; }.device-summary > view > text:first-child { color: #fff; font-size: 21px; font-weight: 700; }.summary-label { margin-top: 5px; display: flex; align-items: center; color: #899185; font-size: 9px; }.device-summary .online-num { color: #8dd214; }.device-summary .offline-num { color: #ed8074; }.online-light,.offline-light { width: 5px; height: 5px; margin-right: 5px; border-radius: 50%; }.online-light { background: #76b900; }.offline-light { background: #ed8074; }
.device-toolbar { flex: 0 0 auto; padding: 12px; display: flex; }.search-box { min-width: 0; height: 40px; flex: 1; padding-left: 12px; display: flex; align-items: center; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.11); border-radius: 7px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }.search-input { min-width: 0; height: 40px; flex: 1; margin-left: 8px; color: #f5f7f3; font-size: 11px; }.placeholder { color: #7d8679; }.search-submit { height: 40px; padding: 0 13px; display: flex; align-items: center; color: #8dd214; font-size: 11px; font-weight: 700; }.refresh-control { flex: 0 0 auto; width: 40px; height: 40px; margin-left: 8px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.11); color: #b3bbb0; font-size: 19px; border-radius: 7px; }.refresh-control.loading { opacity: .45; }
.status-tabs { flex: 0 0 auto; height: 39px; margin: 0 12px; padding: 3px; box-sizing: border-box; display: grid; grid-template-columns: repeat(3,1fr); background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.08); border-radius: 7px; }.status-tab { display: flex; align-items: center; justify-content: center; color: #858e81; font-size: 11px; border-radius: 5px; }.status-tab.active { background: #76b900; color: #080a08; font-weight: 750; }
.device-scroll { flex: 1; min-height: 0; }.list-title { padding: 17px 16px 8px; display: flex; align-items: center; justify-content: space-between; }.list-title text:first-child { color: #f5f7f3; font-size: 14px; font-weight: 650; }.list-title text:last-child { color: #858e81; font-size: 9px; }.device-list { padding: 0 12px; }
.device-card { margin-bottom: 10px; overflow: hidden; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.device-main { min-height: 103px; padding: 13px; box-sizing: border-box; display: flex; }.product-wrap { flex: 0 0 auto; width: 89px; height: 77px; overflow: hidden; background: rgba(239,242,237,.92); border-radius: 7px; }.product-wrap image { width: 100%; height: 100%; }.device-info { min-width: 0; flex: 1; margin-left: 13px; padding-top: 2px; }.device-name-line { min-width: 0; display: flex; align-items: center; justify-content: space-between; }.device-name-line > text { max-width: 135px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-size: 13px; font-weight: 700; }.status-pill { flex: 0 0 auto; margin-left: 7px; padding: 4px 6px; display: flex; align-items: center; background: rgba(255,255,255,.08); color: #9aa297; font-size: 8px; border-radius: 4px; }.status-pill > view { width: 5px; height: 5px; margin-right: 4px; background: #8b9387; border-radius: 50%; }.status-pill.online { background: rgba(118,185,0,.14); color: #9dda39; }.status-pill.online > view { background: #76b900; }.device-sn { display: block; margin-top: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #788175; font-size: 9px; }.device-location { margin-top: 12px; display: grid; grid-template-columns: 55px minmax(0,1fr); font-size: 9px; }.device-location text:first-child { color: #7f887b; }.device-location text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #c5cbc1; text-align: right; }
.device-data { min-height: 58px; padding: 0 10px 0 14px; display: grid; grid-template-columns: .85fr .85fr 1.2fr 20px; align-items: center; background: rgba(0,0,0,.18); border-top: 1px solid rgba(255,255,255,.08); }.device-data > view { min-width: 0; border-right: 1px solid rgba(255,255,255,.08); }.device-data > view:nth-child(3) { border-right: 0; padding-left: 9px; }.device-data text { display: block; }.device-data view text:first-child { color: #7f887b; font-size: 8px; }.device-data view text:last-child { margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #e8ebe6; font-size: 10px; font-weight: 600; }.device-data .earning { color: #8dd214; }.open-arrow { color: #7d8679; font-size: 19px; }
.empty-state { padding: 65px 30px 0; display: flex; flex-direction: column; align-items: center; text-align: center; }.empty-visual { width: 120px; height: 92px; overflow: hidden; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; }.empty-visual image { width: 100%; height: 100%; opacity: .72; }.empty-state > text:nth-child(2) { margin-top: 18px; color: #fff; font-size: 15px; font-weight: 650; }.empty-state > text:last-child { width: 230px; margin-top: 7px; color: #858e81; font-size: 10px; line-height: 17px; }.scroll-safe-space { height: calc(82px + env(safe-area-inset-bottom)); }
