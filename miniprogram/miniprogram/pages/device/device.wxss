page { background: #f5f6f4; color: #1d211c; }
.device-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.device-nav { box-sizing: content-box; flex: 0 0 auto; padding: 0 98px 0 18px; display: flex; align-items: center; background: #fff; }.navbar-title,.navbar-subtitle { display: block; }.navbar-title { font-size: 18px; font-weight: 700; }.navbar-subtitle { margin-top: 2px; color: #91978e; font-size: 9px; }
.device-summary { flex: 0 0 auto; margin: 10px 12px 0; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border: 1px solid #e1e5df; border-radius: 8px; }.device-summary > view { min-width: 0; padding: 14px 16px; border-right: 1px solid #eaede8; }.device-summary > view:last-child { border-right: 0; }.device-summary text { display: block; }.device-summary > view > text:first-child { font-size: 21px; font-weight: 700; }.summary-label { margin-top: 5px; display: flex; align-items: center; color: #8b9188; font-size: 9px; }.device-summary .online-num { color: #5c9008; }.device-summary .offline-num { color: #aa665e; }.online-light,.offline-light { width: 5px; height: 5px; margin-right: 5px; border-radius: 50%; }.online-light { background: #76b900; }.offline-light { background: #d18177; }
.device-toolbar { flex: 0 0 auto; padding: 12px; display: flex; }.search-box { min-width: 0; height: 40px; flex: 1; padding-left: 12px; display: flex; align-items: center; background: #fff; border: 1px solid #dfe3dd; border-radius: 7px; }.search-input { min-width: 0; height: 40px; flex: 1; margin-left: 8px; color: #2b302a; font-size: 11px; }.placeholder { color: #a1a69e; }.search-submit { height: 40px; padding: 0 13px; display: flex; align-items: center; color: #58870c; font-size: 11px; font-weight: 650; }.refresh-control { flex: 0 0 auto; width: 40px; height: 40px; margin-left: 8px; display: flex; align-items: center; justify-content: center; background: #fff; border: 1px solid #dfe3dd; color: #727970; font-size: 19px; border-radius: 7px; }.refresh-control.loading { opacity: .45; }
.status-tabs { flex: 0 0 auto; height: 39px; margin: 0 12px; padding: 3px; box-sizing: border-box; display: grid; grid-template-columns: repeat(3,1fr); background: #e9ece7; border-radius: 7px; }.status-tab { display: flex; align-items: center; justify-content: center; color: #777e75; font-size: 11px; border-radius: 5px; }.status-tab.active { background: #fff; color: #2d332c; font-weight: 650; box-shadow: 0 1px 4px rgba(42,51,39,.08); }
.device-scroll { flex: 1; min-height: 0; }.list-title { padding: 17px 16px 8px; display: flex; align-items: center; justify-content: space-between; }.list-title text:first-child { font-size: 14px; font-weight: 650; }.list-title text:last-child { color: #92988f; font-size: 9px; }.device-list { padding: 0 12px; }
.device-card { margin-bottom: 10px; overflow: hidden; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.device-main { min-height: 103px; padding: 13px; box-sizing: border-box; display: flex; }.product-wrap { flex: 0 0 auto; width: 89px; height: 77px; overflow: hidden; background: #f0f2ef; border-radius: 7px; }.product-wrap image { width: 100%; height: 100%; }.device-info { min-width: 0; flex: 1; margin-left: 13px; padding-top: 2px; }.device-name-line { min-width: 0; display: flex; align-items: center; justify-content: space-between; }.device-name-line > text { max-width: 135px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 700; }.status-pill { flex: 0 0 auto; margin-left: 7px; padding: 4px 6px; display: flex; align-items: center; background: #f0f1ef; color: #81877f; font-size: 8px; border-radius: 4px; }.status-pill > view { width: 5px; height: 5px; margin-right: 4px; background: #a3a8a1; border-radius: 50%; }.status-pill.online { background: #edf5e2; color: #5c850f; }.status-pill.online > view { background: #76b900; }.device-sn { display: block; margin-top: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9a9f97; font-size: 9px; }.device-location { margin-top: 12px; display: grid; grid-template-columns: 55px minmax(0,1fr); font-size: 9px; }.device-location text:first-child { color: #939990; }.device-location text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #555c53; text-align: right; }
.device-data { min-height: 58px; padding: 0 10px 0 14px; display: grid; grid-template-columns: .85fr .85fr 1.2fr 20px; align-items: center; background: #fbfcfb; border-top: 1px solid #ebeee9; }.device-data > view { min-width: 0; border-right: 1px solid #e7eae6; }.device-data > view:nth-child(3) { border-right: 0; padding-left: 9px; }.device-data text { display: block; }.device-data view text:first-child { color: #969c93; font-size: 8px; }.device-data view text:last-child { margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #3b403a; font-size: 10px; font-weight: 600; }.device-data .earning { color: #a06b19; }.open-arrow { color: #a9afa6; font-size: 19px; }
.empty-state { padding: 65px 30px 0; display: flex; flex-direction: column; align-items: center; text-align: center; }.empty-visual { width: 120px; height: 92px; overflow: hidden; background: #ecefeb; border-radius: 8px; }.empty-visual image { width: 100%; height: 100%; opacity: .75; }.empty-state > text:nth-child(2) { margin-top: 18px; font-size: 15px; font-weight: 650; }.empty-state > text:last-child { width: 230px; margin-top: 7px; color: #92988f; font-size: 10px; line-height: 17px; }.scroll-safe-space { height: calc(80px + env(safe-area-inset-bottom)); }
