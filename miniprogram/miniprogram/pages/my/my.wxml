<scroll-view class="my-scroll" scroll-y type="list">
  <view class="my-page">
    <view class="account-nav" style="padding-top: {{navBarTop}}px; height: {{navBarHeight}}px;">
      <view><text class="nav-title">我的</text><text class="nav-subtitle">账户与服务</text></view>
    </view>

    <view class="profile-card" bindtap="{{!isLoggedIn ? 'onLogin' : ''}}">
      <view class="avatar-wrap">
        <button class="avatar-trigger" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" wx:if="{{isLoggedIn}}">
          <image class="avatar-image" src="{{userInfo.avatarUrl}}" mode="aspectFill" wx:if="{{userInfo.avatarUrl}}"></image>
          <view class="avatar-fallback" wx:else>JX</view>
        </button>
        <view class="avatar-fallback" wx:else>JX</view>
        <view class="avatar-status" wx:if="{{isLoggedIn}}"></view>
      </view>
      <view class="profile-copy" wx:if="{{isLoggedIn}}">
        <view class="name-line">
          <input class="nick-input" type="nickname" placeholder="设置昵称" value="{{userInfo.nickname}}" bindchange="onNicknameInput" wx:if="{{!userInfo.nickname || userInfo.nickname === '微信用户'}}" />
          <text class="profile-name" bindtap="onEditNickname" wx:else>{{userInfo.nickname}}</text>
          <text class="level-badge">L{{userInfo.level || 0}}</text>
        </view>
        <text class="account-id">用户 ID {{userInfo.id}}</text>
        <view class="phone-line" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
        <button class="bind-phone" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" wx:else>绑定手机号</button>
      </view>
      <view class="profile-copy" wx:else><text class="profile-name">登录聚芯 Orin</text><text class="account-id">管理设备、收益和结算信息</text><text class="login-link">微信快捷登录 ›</text></view>
      <text class="profile-arrow">›</text>
    </view>

    <navigator class="complete-notice" url="/pages/complete-profile/complete-profile" wx:if="{{isLoggedIn && needCompleteInfo}}"><view>!</view><text>完善账户资料，便于收益结算</text><text>去完善 ›</text></navigator>

    <block wx:if="{{isLoggedIn}}">
      <view class="wallet-card">
        <view class="wallet-head"><text>我的收益</text><view bindtap="onWalletDetail">查看明细 ›</view></view>
        <view class="wallet-main" bindtap="onWithdraw"><text>可提现余额（元）</text><view><text>¥</text><text>{{walletInfo.balance}}</text></view></view>
        <view class="wallet-stats"><view><text>累计收益</text><text>¥{{walletInfo.totalEarnings}}</text></view><view><text>节点权益</text><text>{{walletInfo.displayHashrate || 0}}</text></view></view>
        <view class="wallet-actions"><button bindtap="onWithdraw">申请提现</button><button bindtap="onWithdrawRecord">提现记录</button></view>
      </view>

      <view class="section-head"><text>设备概况</text><view bindtap="goToDevicePage">设备中心 ›</view></view>
      <view class="node-card" bindtap="goToDevicePage">
        <view><text>{{deviceStats.total}}</text><text>全部设备</text></view>
        <view><text class="online-num">{{deviceStats.online}}</text><text>在线运行</text></view>
        <view><text class="offline-num">{{deviceStats.offline}}</text><text>已离线</text></view>
      </view>
    </block>

    <block wx:for="{{menuList}}" wx:for-item="group" wx:key="index">
      <view class="section-head"><text>{{index === 0 ? '常用服务' : '帮助与支持'}}</text></view>
      <view class="menu-list">
        <view class="menu-row" wx:for="{{group}}" wx:for-item="item" wx:key="id" bindtap="onMenuTap" data-id="{{item.id}}">
          <view class="menu-code {{item.iconClass}}">{{item.icon}}</view>
          <view class="menu-copy"><text>{{item.text}}</text><text>{{item.desc}}</text></view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </block>

    <view class="logout-section" wx:if="{{isLoggedIn}}"><button bindtap="onLogout">退出当前账户</button></view>
    <view class="safe-space"></view>
  </view>
</scroll-view>
