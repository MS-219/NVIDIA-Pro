@import "../../styles/orin-polish.wxss";

page {
  background: #eef1ed;
  color: #1c211b;
}

.my-scroll {
  height: 100vh;
}

.my-page {
  min-height: 100%;
  background: #eef1ed;
}

.account-nav {
  box-sizing: content-box;
  padding: 0 98px 0 18px;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, .94);
  border-bottom: 1px solid rgba(28, 33, 27, .08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.nav-copy,
.nav-title,
.nav-subtitle {
  display: block;
}

.nav-title {
  color: #1c211b;
  font-size: 18px;
  font-weight: 700;
  line-height: 22px;
}

.nav-subtitle {
  margin-top: 1px;
  color: #7d8579;
  font-size: 10px;
  line-height: 14px;
}

.profile-card {
  position: relative;
  min-height: 124px;
  margin: 12px 14px 0;
  padding: 20px 38px 20px 18px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #11150f;
  border: 1px solid rgba(118, 185, 0, .22);
  border-radius: 8px;
  box-shadow: 0 10px 28px rgba(17, 21, 15, .11);
}

.profile-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: #76b900;
}

.profile-card-pressed,
.wallet-main-pressed,
.node-card-pressed,
.menu-tile-pressed,
.notice-pressed {
  opacity: .78;
}

.avatar-wrap {
  position: relative;
  width: 60px;
  height: 60px;
  flex: 0 0 60px;
  margin-right: 14px;
}

.avatar-trigger,
.avatar-image,
.avatar-fallback {
  width: 60px;
  height: 60px;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #233016;
  border: 2px solid rgba(141, 210, 20, .54);
  border-radius: 50%;
  color: #a4df3c;
  font-family: "DIN Alternate", Menlo, monospace;
  font-size: 16px;
  font-weight: 800;
}

.avatar-trigger {
  min-width: 60px;
  max-width: 60px;
  line-height: normal;
}

.avatar-trigger::after,
.bind-phone::after,
.wallet-actions button::after,
.logout-section button::after {
  border: 0;
}

.avatar-status {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 11px;
  height: 11px;
  box-sizing: border-box;
  background: #76b900;
  border: 2px solid #11150f;
  border-radius: 50%;
}

.profile-copy {
  min-width: 0;
  flex: 1;
}

.profile-copy-guest {
  padding: 3px 0;
}

.name-line {
  min-width: 0;
  min-height: 30px;
  display: flex;
  align-items: center;
}

.profile-name {
  max-width: 182px;
  overflow: hidden;
  color: #f7f9f5;
  font-size: 17px;
  font-weight: 700;
  line-height: 24px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nick-input {
  width: 152px;
  height: 34px;
  min-height: 34px;
  box-sizing: border-box;
  border-bottom: 1px solid rgba(255, 255, 255, .2);
  color: #ffffff;
  font-size: 15px;
}

.level-badge {
  flex: 0 0 auto;
  min-width: 24px;
  height: 20px;
  margin-left: 8px;
  padding: 0 5px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #76b900;
  border-radius: 4px;
  color: #0a0d09;
  font-family: "DIN Alternate", Menlo, monospace;
  font-size: 9px;
  font-weight: 800;
}

.account-id {
  display: block;
  margin-top: 5px;
  overflow: hidden;
  color: #8f988c;
  font-family: "DIN Alternate", Menlo, monospace;
  font-size: 11px;
  line-height: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-line {
  margin-top: 8px;
  color: #bcc4b8;
  font-size: 11px;
  line-height: 18px;
}

.bind-phone {
  min-width: 96px;
  height: 36px;
  margin: 2px 0 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  color: #93d51e;
  font-size: 12px;
  line-height: 36px;
  text-align: left;
}

.login-link {
  display: block;
  min-height: 32px;
  margin-top: 5px;
  color: #93d51e;
  font-size: 12px;
  font-weight: 650;
  line-height: 32px;
}

.profile-arrow {
  position: absolute;
  right: 17px;
  top: 50%;
  transform: translateY(-50%);
  color: #778074;
  font-size: 22px;
  line-height: 1;
}

.complete-notice {
  min-height: 46px;
  margin: 9px 14px 0;
  padding: 0 12px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #fffaf0;
  border: 1px solid rgba(166, 107, 16, .18);
  border-radius: 8px;
}

.notice-mark {
  width: 20px;
  height: 20px;
  margin-right: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #a66b10;
  border-radius: 4px;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
}

.notice-copy {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #6e5429;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-action {
  flex: 0 0 auto;
  margin-left: 8px;
  color: #8c5c0d;
  font-size: 12px;
  font-weight: 650;
}

.notice-arrow {
  margin-left: 4px;
  color: #a27a3c;
  font-size: 18px;
}

.section-head {
  height: 54px;
  padding: 0 17px 10px;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-head-first {
  height: 58px;
}

.section-head > text {
  color: #1c211b;
  font-size: 16px;
  font-weight: 700;
  line-height: 22px;
}

.section-head > view {
  min-height: 32px;
  display: flex;
  align-items: flex-end;
  padding-bottom: 1px;
  box-sizing: border-box;
  color: #4f7f00;
  font-size: 12px;
  line-height: 20px;
}

.section-head > view text {
  margin-left: 3px;
  color: #77964c;
  font-size: 17px;
}

.wallet-card {
  position: relative;
  margin: 0 14px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid rgba(28, 33, 27, .085);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(28, 33, 27, .045);
}

.wallet-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 3px;
  background: #76b900;
}

.wallet-main {
  min-height: 108px;
  padding: 20px 18px 17px;
  box-sizing: border-box;
}

.wallet-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wallet-label-row text:first-child {
  color: #687066;
  font-size: 12px;
}

.wallet-label-row text:last-child {
  color: #9aa097;
  font-family: "DIN Alternate", Menlo, monospace;
  font-size: 9px;
}

.wallet-amount {
  min-width: 0;
  margin-top: 8px;
  display: flex;
  align-items: baseline;
}

.wallet-currency {
  flex: 0 0 auto;
  margin-right: 6px;
  color: #4f7f00;
  font-family: "DIN Alternate", Menlo, monospace;
  font-size: 17px;
  font-weight: 700;
}

.wallet-number {
  max-width: calc(100% - 30px);
  overflow: hidden;
  color: #171b16;
  font-size: 34px;
  font-weight: 760;
  line-height: 40px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-stats {
  min-height: 68px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f5f7f3;
  border-top: 1px solid rgba(28, 33, 27, .07);
  border-bottom: 1px solid rgba(28, 33, 27, .07);
}

.wallet-stat {
  min-width: 0;
  padding: 13px 18px;
  box-sizing: border-box;
  border-right: 1px solid rgba(28, 33, 27, .07);
}

.wallet-stat:last-child {
  border-right: 0;
}

.wallet-stat text {
  display: block;
}

.wallet-stat text:first-child {
  color: #7d8579;
  font-size: 11px;
  line-height: 16px;
}

.wallet-stat text:last-child {
  margin-top: 5px;
  overflow: hidden;
  color: #272c26;
  font-size: 15px;
  font-weight: 700;
  line-height: 20px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-actions {
  min-height: 48px;
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.wallet-actions button {
  height: 48px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  font-size: 13px;
  line-height: 48px;
}

.withdraw-primary {
  background: #76b900;
  color: #0b0e0a;
  font-weight: 720;
}

.withdraw-secondary {
  background: #ffffff;
  border-left: 1px solid rgba(28, 33, 27, .07);
  color: #5f675d;
}

.node-card {
  margin: 0 14px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  overflow: hidden;
  background: #ffffff;
  border: 1px solid rgba(28, 33, 27, .085);
  border-radius: 8px;
}

.node-stat {
  min-width: 0;
  min-height: 84px;
  padding: 15px 16px 13px;
  box-sizing: border-box;
  border-right: 1px solid rgba(28, 33, 27, .075);
}

.node-stat:last-child {
  border-right: 0;
}

.node-value-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.node-value {
  overflow: hidden;
  color: #20251f;
  font-size: 23px;
  font-weight: 740;
  line-height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-label {
  display: block;
  margin-top: 7px;
  overflow: hidden;
  color: #7d8579;
  font-size: 11px;
  line-height: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-dot {
  width: 7px;
  height: 7px;
  margin-left: 8px;
  flex: 0 0 7px;
  border-radius: 50%;
}

.node-dot-total {
  background: #70786d;
}

.node-dot-online {
  background: #76b900;
}

.node-dot-offline {
  background: #b65f56;
}

.online-num {
  color: #4f7f00;
}

.offline-num {
  color: #a7524a;
}

.service-section-head {
  height: 58px;
}

.menu-grid {
  margin: 0 14px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
}

.menu-tile {
  position: relative;
  min-width: 0;
  min-height: 80px;
  padding: 12px 27px 12px 11px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid rgba(28, 33, 27, .085);
  border-radius: 8px;
}

.menu-code {
  width: 38px;
  height: 38px;
  margin-right: 10px;
  flex: 0 0 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(118, 185, 0, .14);
  border-radius: 6px;
}

.menu-code image {
  width: 21px;
  height: 21px;
}

.icon-payment,
.icon-orders {
  background: rgba(90, 128, 145, .13);
}

.icon-invite,
.icon-exchange {
  background: rgba(199, 135, 28, .13);
}

.icon-help,
.icon-feedback {
  background: rgba(47, 151, 143, .12);
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-copy text {
  display: block;
}

.menu-copy text:first-child {
  overflow: hidden;
  color: #252a24;
  font-size: 13px;
  font-weight: 680;
  line-height: 19px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-copy text:last-child {
  max-height: 30px;
  margin-top: 3px;
  overflow: hidden;
  color: #858d81;
  font-size: 10px;
  line-height: 15px;
}

.menu-arrow {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: #9ba198;
  font-size: 17px;
  line-height: 1;
}

.logout-section {
  margin: 20px 14px 0;
}

.logout-section button {
  height: 46px;
  margin: 0;
  background: transparent;
  border: 1px solid rgba(167, 82, 74, .2);
  border-radius: 8px;
  color: #9e514a;
  font-size: 12px;
  line-height: 46px;
}

.safe-space {
  height: calc(86px + env(safe-area-inset-bottom));
}

@media (max-width: 350px) {
  .profile-card,
  .complete-notice,
  .wallet-card,
  .node-card,
  .menu-grid,
  .logout-section {
    margin-left: 10px;
    margin-right: 10px;
  }

  .profile-card {
    padding-left: 14px;
    padding-right: 32px;
  }

  .avatar-wrap,
  .avatar-trigger,
  .avatar-image,
  .avatar-fallback {
    width: 54px;
    height: 54px;
  }

  .avatar-wrap,
  .avatar-trigger {
    min-width: 54px;
    max-width: 54px;
    flex-basis: 54px;
  }

  .avatar-wrap {
    margin-right: 11px;
  }

  .profile-name {
    max-width: 132px;
    font-size: 16px;
  }

  .nick-input {
    width: 124px;
  }

  .section-head {
    padding-left: 13px;
    padding-right: 13px;
  }

  .wallet-main {
    padding-left: 15px;
    padding-right: 15px;
  }

  .wallet-stat,
  .node-stat {
    padding-left: 12px;
    padding-right: 12px;
  }

  .menu-tile {
    min-height: 78px;
    padding-left: 9px;
    padding-right: 22px;
  }

  .menu-code {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    flex-basis: 34px;
  }

  .menu-code image {
    width: 19px;
    height: 19px;
  }

  .menu-arrow {
    right: 7px;
  }
}
