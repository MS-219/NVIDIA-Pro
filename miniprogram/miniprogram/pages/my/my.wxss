page { background: #f5f6f4; color: #1d211c; }.my-scroll { height: 100vh; }
.account-nav { box-sizing: content-box; padding: 0 98px 0 18px; display: flex; align-items: center; background: #fff; }.nav-title,.nav-subtitle { display: block; }.nav-title { font-size: 18px; font-weight: 700; }.nav-subtitle { margin-top: 2px; color: #91978e; font-size: 9px; }
.profile-card { position: relative; min-height: 105px; margin: 10px 12px 0; padding: 17px 15px; box-sizing: border-box; display: flex; align-items: center; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.avatar-wrap { position: relative; flex: 0 0 auto; margin-right: 13px; }.avatar-trigger,.avatar-image,.avatar-fallback { width: 62px; height: 62px; margin: 0; padding: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #eaf2e3; border: 0; color: #5f8d18; font-size: 16px; font-weight: 800; border-radius: 50%; }.avatar-trigger::after { border: 0; }.avatar-status { position: absolute; right: 1px; bottom: 1px; width: 10px; height: 10px; box-sizing: border-box; background: #76b900; border: 2px solid #fff; border-radius: 50%; }
.profile-copy { min-width: 0; flex: 1; }.name-line { display: flex; align-items: center; }.profile-name { max-width: 175px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 17px; font-weight: 700; }.nick-input { width: 150px; height: 28px; border-bottom: 1px solid #d7dcd4; color: #252a24; font-size: 15px; }.level-badge { margin-left: 7px; padding: 3px 5px; background: #ebf4df; color: #5a890c; font-size: 8px; font-weight: 700; border-radius: 4px; }.account-id { display: block; margin-top: 6px; color: #969c93; font-size: 9px; }.phone-line { margin-top: 7px; color: #6d746b; font-size: 9px; }.bind-phone { height: 24px; margin: 4px 0 0; padding: 0; line-height: 24px; background: transparent; color: #5d8c14; font-size: 9px; text-align: left; }.login-link { display: block; margin-top: 10px; color: #5b8a12; font-size: 10px; font-weight: 600; }.profile-arrow { color: #afb5ac; font-size: 20px; }
.complete-notice { min-height: 39px; margin: 8px 12px 0; padding: 0 12px; display: flex; align-items: center; background: #fff8ea; border: 1px solid #eddfc2; color: #835e20; font-size: 9px; border-radius: 7px; }.complete-notice view { width: 16px; height: 16px; margin-right: 7px; display: flex; align-items: center; justify-content: center; background: #c18b31; color: #fff; font-size: 9px; font-weight: 700; border-radius: 50%; }.complete-notice text:nth-child(2) { min-width: 0; flex: 1; }.complete-notice text:last-child { color: #a07226; }
.wallet-card { margin: 10px 12px 0; overflow: hidden; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.wallet-head { height: 48px; padding: 0 15px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #ecefeb; }.wallet-head > text { font-size: 14px; font-weight: 650; }.wallet-head view { color: #7f867c; font-size: 9px; }.wallet-main { padding: 18px 16px 15px; }.wallet-main > text { color: #8c9289; font-size: 9px; }.wallet-main > view { margin-top: 6px; display: flex; align-items: baseline; }.wallet-main > view text:first-child { margin-right: 4px; color: #65980f; font-size: 14px; }.wallet-main > view text:last-child { max-width: 290px; overflow: hidden; font-size: 28px; font-weight: 700; }.wallet-stats { min-height: 58px; display: grid; grid-template-columns: 1fr 1fr; background: #fafbfa; border-top: 1px solid #ecefeb; border-bottom: 1px solid #ecefeb; }.wallet-stats view { min-width: 0; padding: 12px 16px; border-right: 1px solid #e9ece8; }.wallet-stats view:last-child { border-right: 0; }.wallet-stats text { display: block; }.wallet-stats text:first-child { color: #92988f; font-size: 8px; }.wallet-stats text:last-child { margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 650; }.wallet-actions { height: 43px; display: grid; grid-template-columns: 1fr 1fr; }.wallet-actions button { height: 43px; margin: 0; padding: 0; line-height: 43px; background: #fff; color: #626960; font-size: 10px; border-radius: 0; }.wallet-actions button:first-child { color: #5a890c; font-weight: 650; border-right: 1px solid #e9ece8; }
.section-head { height: 55px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head text { font-size: 16px; font-weight: 700; }.section-head view { color: #7e857b; font-size: 9px; }.node-card { margin: 0 12px; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.node-card > view { min-width: 0; padding: 15px; border-right: 1px solid #eaede8; }.node-card > view:last-child { border-right: 0; }.node-card text { display: block; }.node-card text:first-child { font-size: 21px; font-weight: 700; }.node-card text:last-child { margin-top: 5px; color: #8e948b; font-size: 9px; }.node-card .online-num { color: #5e920a; }.node-card .offline-num { color: #a8645c; }
.menu-list { margin: 0 12px; overflow: hidden; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.menu-row { min-height: 60px; padding: 0 12px; display: flex; align-items: center; border-bottom: 1px solid #eaede8; }.menu-row:last-child { border-bottom: 0; }.menu-code { flex: 0 0 auto; width: 34px; height: 34px; margin-right: 12px; display: flex; align-items: center; justify-content: center; background: #eaf3df; color: #5b890f; font-size: 9px; font-weight: 800; border-radius: 7px; }.icon-payment,.icon-orders { background: #e9eef0; color: #536a74; }.icon-invite,.icon-exchange { background: #f7eddc; color: #996515; }.icon-help,.icon-feedback { background: #e3f2f0; color: #247a75; }.menu-copy { min-width: 0; flex: 1; }.menu-copy text { display: block; }.menu-copy text:first-child { font-size: 12px; font-weight: 650; }.menu-copy text:last-child { margin-top: 4px; color: #969c93; font-size: 8px; }.menu-arrow { color: #b0b5ad; font-size: 19px; }
.logout-section { margin: 20px 12px 0; }.logout-section button { height: 42px; line-height: 42px; background: #fff; border: 1px solid #e0e4de; color: #9c5a52; font-size: 10px; border-radius: 7px; }.safe-space { height: calc(80px + env(safe-area-inset-bottom)); }
