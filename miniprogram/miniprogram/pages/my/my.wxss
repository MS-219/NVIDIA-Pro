page { background: #080a08; color: #f5f7f3; }.my-scroll { height: 100vh; }.my-page { min-height: 100%; background: #080a08; }
.account-nav { box-sizing: content-box; padding: 0 98px 0 18px; display: flex; align-items: center; background: rgba(8,10,8,.82); border-bottom: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.nav-title,.nav-subtitle { display: block; }.nav-title { color: #fff; font-size: 18px; font-weight: 700; }.nav-subtitle { margin-top: 2px; color: #879083; font-size: 9px; }
.profile-card { position: relative; min-height: 105px; margin: 10px 12px 0; padding: 17px 15px; box-sizing: border-box; display: flex; align-items: center; background: rgba(255,255,255,.065); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.profile-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }.avatar-wrap { position: relative; flex: 0 0 auto; margin-right: 13px; }.avatar-trigger,.avatar-image,.avatar-fallback { width: 62px; height: 62px; margin: 0; padding: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; overflow: hidden; background: rgba(118,185,0,.16); border: 1px solid rgba(141,210,20,.32); color: #9dda39; font-size: 16px; font-weight: 800; border-radius: 50%; }.avatar-trigger::after { border: 0; }.avatar-status { position: absolute; right: 1px; bottom: 1px; width: 10px; height: 10px; box-sizing: border-box; background: #76b900; border: 2px solid #151915; border-radius: 50%; }.profile-copy { min-width: 0; flex: 1; }.name-line { display: flex; align-items: center; }.profile-name { max-width: 175px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-size: 17px; font-weight: 700; }.nick-input { width: 150px; height: 28px; border-bottom: 1px solid rgba(255,255,255,.18); color: #fff; font-size: 15px; }.level-badge { margin-left: 7px; padding: 3px 5px; background: #76b900; color: #080a08; font-size: 8px; font-weight: 800; border-radius: 4px; }.account-id { display: block; margin-top: 6px; color: #818a7d; font-size: 9px; }.phone-line { margin-top: 7px; color: #aeb6aa; font-size: 9px; }.bind-phone { height: 24px; margin: 4px 0 0; padding: 0; line-height: 24px; background: transparent; color: #8dd214; font-size: 9px; text-align: left; }.login-link { display: block; margin-top: 10px; color: #8dd214; font-size: 10px; font-weight: 650; }.profile-arrow { color: #788175; font-size: 20px; }
.complete-notice { min-height: 39px; margin: 8px 12px 0; padding: 0 12px; display: flex; align-items: center; background: rgba(213,148,36,.11); border: 1px solid rgba(224,168,72,.28); color: #e5bc73; font-size: 9px; border-radius: 7px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }.complete-notice view { width: 16px; height: 16px; margin-right: 7px; display: flex; align-items: center; justify-content: center; background: #c28b2e; color: #080a08; font-size: 9px; font-weight: 800; border-radius: 50%; }.complete-notice text:nth-child(2) { min-width: 0; flex: 1; }.complete-notice text:last-child { color: #e8c889; }
.wallet-card { margin: 10px 12px 0; overflow: hidden; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.wallet-head { height: 48px; padding: 0 15px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,.08); }.wallet-head > text { color: #fff; font-size: 14px; font-weight: 650; }.wallet-head view { color: #8dd214; font-size: 9px; }.wallet-main { padding: 18px 16px 15px; background: #76b900; color: #080a08; }.wallet-main > text { color: rgba(8,10,8,.62); font-size: 9px; }.wallet-main > view { margin-top: 6px; display: flex; align-items: baseline; }.wallet-main > view text:first-child { margin-right: 4px; font-size: 14px; }.wallet-main > view text:last-child { max-width: 290px; overflow: hidden; font-size: 28px; font-weight: 800; }.wallet-stats { min-height: 58px; display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid rgba(255,255,255,.08); }.wallet-stats view { min-width: 0; padding: 12px 16px; border-right: 1px solid rgba(255,255,255,.08); }.wallet-stats view:last-child { border-right: 0; }.wallet-stats text { display: block; }.wallet-stats text:first-child { color: #7f887b; font-size: 8px; }.wallet-stats text:last-child { margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #f3f5f1; font-size: 13px; font-weight: 650; }.wallet-actions { height: 43px; display: grid; grid-template-columns: 1fr 1fr; }.wallet-actions button { height: 43px; margin: 0; padding: 0; line-height: 43px; background: transparent; color: #aab2a6; font-size: 10px; border-radius: 0; }.wallet-actions button:first-child { color: #8dd214; font-weight: 700; border-right: 1px solid rgba(255,255,255,.08); }
.section-head { height: 55px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head text { color: #f5f7f3; font-size: 16px; font-weight: 700; }.section-head view { color: #8dd214; font-size: 9px; }.node-card { margin: 0 12px; display: grid; grid-template-columns: repeat(3,1fr); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.node-card > view { min-width: 0; padding: 15px; border-right: 1px solid rgba(255,255,255,.09); }.node-card > view:last-child { border-right: 0; }.node-card text { display: block; }.node-card text:first-child { color: #fff; font-size: 21px; font-weight: 700; }.node-card text:last-child { margin-top: 5px; color: #818a7d; font-size: 9px; }.node-card .online-num { color: #8dd214; }.node-card .offline-num { color: #ed8074; }
.menu-list { margin: 0 12px; overflow: hidden; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.menu-row { min-height: 60px; padding: 0 12px; display: flex; align-items: center; border-bottom: 1px solid rgba(255,255,255,.08); }.menu-row:last-child { border-bottom: 0; }.menu-code { flex: 0 0 auto; width: 34px; height: 34px; margin-right: 12px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.16); color: #9dda39; font-size: 9px; font-weight: 800; border-radius: 6px; }.icon-payment,.icon-orders { background: rgba(105,144,162,.16); color: #84b6ca; }.icon-invite,.icon-exchange { background: rgba(217,154,47,.14); color: #e2b35e; }.icon-help,.icon-feedback { background: rgba(57,174,166,.14); color: #65c9c2; }.menu-copy { min-width: 0; flex: 1; }.menu-copy text { display: block; }.menu-copy text:first-child { color: #f5f7f3; font-size: 12px; font-weight: 650; }.menu-copy text:last-child { margin-top: 4px; color: #7f887b; font-size: 8px; }.menu-arrow { color: #788175; font-size: 19px; }.logout-section { margin: 20px 12px 0; }.logout-section button { height: 42px; line-height: 42px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.1); color: #ee8a7f; font-size: 10px; border-radius: 7px; }.safe-space { height: calc(82px + env(safe-area-inset-bottom)); }
