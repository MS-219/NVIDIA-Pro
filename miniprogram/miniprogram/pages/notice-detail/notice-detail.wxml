<view class="container">
    <view class="nav-bar" style="padding-top: {{navBarTop}}px;">
        <view class="nav-content" style="height: {{navBarHeight}}px;">
            <view class="back-btn" bindtap="goBack"><text class="back-icon">‹</text></view>
            <text class="nav-title">公告详情</text>
            <view class="placeholder"></view>
        </view>
    </view>

    <view class="state-panel" wx:if="{{loading}}">
        <view class="state-spinner"></view>
        <text class="state-title">正在同步公告</text>
        <text class="state-code">正在同步公告内容</text>
    </view>
    <view class="state-panel is-error" wx:elif="{{errorMessage}}">
        <view class="state-error-mark">!</view>
        <text class="state-title">公告同步中断</text>
        <text class="state-desc">{{errorMessage}}</text>
        <button bindtap="retryNotice" wx:if="{{noticeId}}">重新同步</button>
    </view>

    <view class="content-area" wx:elif="{{notice}}">
        <view class="notice-header">
            <view class="notice-kicker"><text>平台公告</text><view><view></view><text>已发布</text></view></view>
            <text class="notice-title">{{notice.title}}</text>
            <text class="notice-time">{{notice.publishTime}}</text>
        </view>
        <image wx:if="{{notice.imageUrl}}" class="notice-image" src="{{notice.imageUrl}}" mode="widthFix"></image>
        <view class="notice-content"><text>{{notice.content}}</text></view>
        <view class="safe-space"></view>
    </view>
</view>
