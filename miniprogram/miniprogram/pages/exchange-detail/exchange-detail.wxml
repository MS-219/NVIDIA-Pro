<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px; height: {{navBarHeight}}px;">
        <view class="nav-back" bindtap="onGoBack" hover-class="tap-muted" aria-role="button" aria-label="返回上一页"><text>‹</text></view>
        <text class="nav-title">设备详情</text><view class="nav-placeholder"></view>
    </view>

    <view class="page-loading" wx:if="{{loading && !loaded}}">
        <view class="hero-skeleton jx-skeleton"></view><view class="panel-skeleton jx-skeleton"></view><view class="panel-skeleton short jx-skeleton"></view>
    </view>

    <view class="page-error" wx:elif="{{errorMessage && !product}}">
        <view class="state-mark"><view></view><text>商品连接异常</text></view>
        <text class="state-title">设备详情同步中断</text><text class="state-desc">{{errorMessage}}</text>
        <button bindtap="retryDetail">重新加载</button>
    </view>

    <block wx:elif="{{product}}">
        <view class="product-hero"><image class="detail-image" src="{{product.imageUrl || '/images/product.png'}}" mode="aspectFit"></image><view class="product-index">ORIN HARDWARE / {{product.id}}</view></view>

        <view class="detail-card">
            <view class="detail-kicker"><view></view><text>兑换报价</text></view>
            <text class="detail-name">{{product.name}}</text>
            <view class="detail-price-row"><image src="/images/menu/earnings.png" mode="aspectFit"></image><text class="detail-price-value">{{product.userHashratePrice}}</text><text class="detail-price-unit">节点权益</text></view>
            <view class="quote-meta"><text>约 ¥{{product.userPrice}}</text><text>可用 {{availableHashrate}}</text><text wx:if="{{product.stock !== null && product.stock !== undefined}}">库存 {{product.stock}}</text></view>
            <text class="detail-desc">{{product.description || '适用于边缘推理和节点任务的 Orin 设备'}}</text>
        </view>

        <view class="price-table-card" wx:if="{{currentPrice}}">
            <view class="section-heading"><view><text>等级报价</text><text>不同等级所需权益</text></view><text>当前等级 L{{userLevel}}</text></view>
            <view class="price-table">
                <view class="price-row price-row-active">
                    <text class="price-level-name">L{{currentPrice.level}} {{currentPrice.levelName}}</text>
                    <view class="price-values"><text class="price-hashrate">{{currentPrice.hashratePrice}}</text><text class="price-rmb">¥{{currentPrice.price}}</text><text class="price-current-badge">当前</text></view>
                </view>
            </view>
        </view>

        <view class="address-card" bindtap="toggleAddressPicker" hover-class="tap-muted">
            <view class="section-heading"><view><text>收货地址</text><text>设备配送地址</text></view><text class="address-arrow">›</text></view>
            <view class="address-state" wx:if="{{addressLoading}}"><view class="mini-spinner"></view><text>地址同步中</text></view>
            <view class="address-state is-error" wx:elif="{{addressError}}" catchtap="retryAddresses"><text>{{addressError}}</text><text>重试</text></view>
            <view class="address-content" wx:elif="{{selectedAddress}}"><view class="address-info"><text class="address-name">{{selectedAddress.receiverName}}</text><text class="address-phone">{{selectedAddress.phone}}</text></view><text class="address-detail">{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}}{{selectedAddress.detailAddress}}</text></view>
            <view class="address-empty" wx:else><text>选择收货地址</text></view>
        </view>

        <view class="qty-card">
            <view><text class="card-title">兑换数量</text><text class="card-subtitle">选择需要兑换的数量</text></view>
            <view class="qty-control"><view class="qty-btn" bindtap="decreaseQty" hover-class="tap-muted">−</view><text class="qty-value">{{quantity}}</text><view class="qty-btn" bindtap="increaseQty" hover-class="tap-muted">+</view></view>
        </view>

        <view class="bottom-bar">
            <view class="bottom-info"><text class="bottom-label">合计节点权益</text><view><image src="/images/menu/earnings.png" mode="aspectFit"></image><text class="bottom-total">{{product.userHashratePrice * quantity}}</text></view></view>
            <button class="exchange-btn {{userLevel < 1 ? 'btn-disabled' : ''}}" bindtap="confirmExchange" loading="{{submitting}}" disabled="{{submitting || userLevel < 1}}">{{userLevel < 1 ? '需升级等级' : (submitting ? '提交中' : '立即兑换')}}</button>
        </view>

        <view class="address-mask" wx:if="{{showAddressPicker}}" bindtap="toggleAddressPicker"></view>
        <view class="address-popup {{showAddressPicker ? 'popup-show' : ''}}">
            <view class="popup-header"><text class="popup-title">选择收货地址</text><view class="popup-close" bindtap="toggleAddressPicker" aria-role="button" aria-label="关闭"><icon type="clear" size="18" color="#697166" /></view></view>
            <scroll-view scroll-y class="popup-list">
                <view class="popup-addr-item {{selectedAddress && selectedAddress.id === item.id ? 'addr-active' : ''}}" wx:for="{{addresses}}" wx:key="id" bindtap="selectAddress" data-index="{{index}}">
                    <view class="popup-addr-info"><text class="popup-addr-name">{{item.receiverName}}</text><text class="popup-addr-phone">{{item.phone}}</text><text class="popup-addr-default" wx:if="{{item.isDefault === 1}}">默认</text></view>
                    <text class="popup-addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
                </view>
                <view class="popup-empty" wx:if="{{!addresses.length && !addressLoading}}">暂无收货地址</view>
            </scroll-view>
            <view class="popup-add" bindtap="goToAddressManage"><text>+</text><text>管理收货地址</text></view>
        </view>
        <view class="safe-space"></view>
    </block>
</view>
