<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px;">
        <view class="nav-back" bindtap="goBack" hover-class="tap-muted" aria-role="button" aria-label="返回上一页">
            <text class="back-icon">‹</text>
        </view>
        <text class="nav-title">提现记录</text>
    </view>

    <view class="list-container" style="padding-top: {{navBarTop + 56}}px;">
        <view class="ledger-anchor">
            <view><text>结算记录</text><text>收益处理进度</text></view>
            <view><text>{{list.length}}</text><text>已载入</text></view>
        </view>

        <view class="loading-state" wx:if="{{initialLoading}}">
            <view class="loading-line"><view></view></view>
            <text>正在同步结算记录</text>
        </view>

        <view class="error-state" wx:elif="{{loadError && list.length === 0}}">
            <view class="state-mark is-error"><view></view><text>连接异常</text></view>
            <text class="state-title">记录同步中断</text>
            <text class="state-desc">{{loadError}}</text>
            <button bindtap="retryLoad">重新加载</button>
        </view>

        <block wx:elif="{{list.length > 0}}">
            <view class="record-item" wx:for="{{list}}" wx:key="id">
                <view class="record-header">
                    <view class="record-type-wrap">
                        <view class="type-code type-{{item.type}}">{{item.type === 1 ? 'WX' : (item.type === 2 ? 'AP' : 'BK')}}</view>
                        <view><text class="record-type">{{item.type === 1 ? '微信提现' : (item.type === 2 ? '支付宝提现' : '银行卡提现')}}</text><text class="record-time">{{item.createTime || '--'}}</text></view>
                    </view>
                    <text class="record-amount">-¥{{item.amount}}</text>
                </view>
                <view class="record-info">
                    <text class="record-code">NO. {{item.id || '--'}}</text>
                    <view class="record-status status-{{item.status}}">
                        {{item.status === 0 ? '审核中' : (item.status === 1 ? '待打款' : (item.status === 2 ? '已驳回' : (item.status === 3 ? '已到账' : '处理中')))}}
                    </view>
                </view>
                <view class="record-fail-info" wx:if="{{item.bossKgFailed}}">
                    <view></view><text>曾打款失败 {{item.paymentFailCount || 1}} 次，已进入重新处理队列</text>
                </view>
                <view class="record-reason" wx:if="{{item.status === 2 && item.remark}}">驳回原因：{{item.remark}}</view>
                <view class="record-reason fail-reason" wx:if="{{item.bossKgFailed && item.rejectReason}}">失败原因：{{item.rejectReason}}</view>
            </view>
            <view class="loading-more" wx:if="{{hasMore}}">
                <view class="mini-spinner" wx:if="{{loading}}"></view>
                <text>{{loading ? '正在载入' : '上拉加载更多'}}</text>
            </view>
            <view class="no-more" wx:else>全部记录已载入</view>
        </block>

        <view class="empty-state" wx:else>
            <image src="/images/menu/orders.png" mode="aspectFit" class="empty-icon"></image>
            <text class="state-title">暂无提现记录</text>
            <text class="state-desc">提交提现后，审核和打款进度会显示在这里</text>
        </view>
    </view>
</view>
