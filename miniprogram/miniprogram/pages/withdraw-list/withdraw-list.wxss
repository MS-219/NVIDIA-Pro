@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed;
    color: #1c211b;
}

.container {
    min-height: 100vh;
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
    background: #eef1ed;
}

.custom-nav {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    box-sizing: content-box;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, .88);
    border-bottom: 1px solid rgba(28, 33, 27, .08);
}

.nav-back {
    width: 52px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.back-icon {
    color: #252a24;
    font-size: 28px;
    font-weight: 300;
}

.nav-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: #1c211b;
    font-size: 18px;
    font-weight: 700;
}

.list-container {
    padding-left: 12px;
    padding-right: 12px;
}

.ledger-anchor {
    min-height: 96px;
    margin: 12px 0;
    padding: 18px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #121611;
    border: 1px solid rgba(118, 185, 0, .25);
    border-left: 4px solid #76b900;
    border-radius: 8px;
    color: #f7f9f5;
}

.ledger-anchor text {
    display: block;
}

.ledger-anchor > view:first-child text:first-child {
    color: #9dda39;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
}

.ledger-anchor > view:first-child text:last-child {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 700;
}

.ledger-anchor > view:last-child {
    min-width: 64px;
    text-align: right;
}

.ledger-anchor > view:last-child text:first-child {
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 28px;
    font-weight: 800;
}

.ledger-anchor > view:last-child text:last-child {
    margin-top: 3px;
    color: #9ba39a;
    font-size: 11px;
}

.record-item {
    margin-bottom: 10px;
    padding: 14px;
    background: #fff;
    border: 1px solid rgba(28, 33, 27, .075);
    border-radius: 8px;
}

.record-header,
.record-info,
.record-type-wrap {
    display: flex;
    align-items: center;
}

.record-header,
.record-info {
    justify-content: space-between;
}

.type-code {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    margin-right: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(19, 117, 112, .11);
    border: 1px solid rgba(19, 117, 112, .18);
    border-radius: 7px;
    color: #137570;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
    font-weight: 800;
}

.type-code.type-1 {
    background: rgba(118, 185, 0, .12);
    border-color: rgba(118, 185, 0, .2);
    color: #548600;
}

.type-code.type-2 {
    background: rgba(192, 138, 47, .12);
    border-color: rgba(192, 138, 47, .2);
    color: #94671c;
}

.record-type,
.record-time {
    display: block;
}

.record-type {
    color: #252a24;
    font-size: 14px;
    font-weight: 700;
}

.record-time {
    margin-top: 5px;
    color: #7b8378;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
}

.record-amount {
    max-width: 130px;
    overflow: hidden;
    color: #1c211b;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 18px;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.record-info {
    min-height: 38px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(28, 33, 27, .07);
}

.record-code {
    color: #92998f;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
}

.record-status {
    min-height: 24px;
    padding: 0 9px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    background: #ecefeb;
    color: #666e63;
    font-size: 11px;
    font-weight: 700;
    border-radius: 999px;
}

.status-0 { background: #fff3d9; color: #8b610e; }
.status-1 { background: #e2f0ef; color: #216f6a; }
.status-2 { background: #fbe5e2; color: #9a4e46; }
.status-3 { background: #e8f3d9; color: #477400; }

.record-fail-info {
    min-height: 40px;
    margin-top: 10px;
    padding: 9px 10px;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    background: #fff3e2;
    border: 1px solid rgba(192, 138, 47, .18);
    border-radius: 6px;
    color: #845d1b;
    font-size: 12px;
    line-height: 18px;
}

.record-fail-info > view {
    flex: 0 0 auto;
    width: 4px;
    height: 18px;
    margin-right: 8px;
    background: #c08a2f;
}

.record-reason {
    margin-top: 8px;
    padding: 9px 10px;
    background: #f7f8f6;
    border-radius: 6px;
    color: #a7524a;
    font-size: 12px;
    line-height: 18px;
}

.loading-state,
.error-state,
.empty-state {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.loading-line {
    width: 96px;
    height: 3px;
    margin-bottom: 16px;
    overflow: hidden;
    background: #dce2da;
}

.loading-line view {
    width: 34px;
    height: 100%;
    background: #76b900;
    animation: loading-scan 1.1s ease-in-out infinite;
}

.loading-state > text,
.state-desc {
    color: #737b70;
    font-size: 12px;
}

.state-mark {
    width: 112px;
    height: 68px;
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #121611;
    border: 1px solid rgba(198, 90, 82, .32);
    border-radius: 8px;
}

.state-mark view {
    width: 26px;
    height: 3px;
    margin-bottom: 9px;
    background: #c65a52;
}

.state-mark text {
    color: #c9cec6;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
}

.state-title {
    color: #1c211b;
    font-size: 16px;
    font-weight: 700;
}

.state-desc {
    width: 250px;
    margin-top: 8px;
    line-height: 19px;
}

.error-state button {
    min-width: 128px;
    min-height: 44px;
    margin-top: 18px;
    background: #121611;
    color: #f7f9f5;
    font-size: 13px;
    font-weight: 700;
    border-radius: 7px;
}

.empty-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 16px;
    padding: 14px;
    box-sizing: border-box;
    background: rgba(90, 128, 145, .11);
    border-radius: 8px;
}

.loading-more,
.no-more {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #7b8378;
    font-size: 12px;
}

.mini-spinner {
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 2px solid #d7ddd4;
    border-top-color: #76b900;
    border-radius: 50%;
    animation: spin .8s linear infinite;
}

.tap-muted { opacity: .62; }

@keyframes loading-scan {
    from { transform: translateX(-38px); }
    to { transform: translateX(100px); }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
