<view class="container">
    <view class="header-actions">
        <view class="nav-right" bindtap="goRecords">提现记录</view>
    </view>
    <!-- 余额卡片 -->
    <view class="balance-card">
        <view class="balance-header">
            <text class="balance-label">可回收聚芯 Orin值</text>
        </view>
        <view class="balance-amount">
            <text class="currency">⚡</text>
            <text class="amount">{{walletInfo.hashrateBalance}}</text>
        </view>
        <view class="exchange-info">
            <text class="exchange-rate">
                ≈ ¥{{walletInfo.available}} 元（{{hashratePerYuan}}聚芯 Orin值=1元）
            </text>
        </view>
        <view class="balance-info">
            <text>累计聚芯 Orin值: ⚡{{walletInfo.totalHashrate}}</text>
            <text>待审核: ¥{{walletInfo.pending}}</text>
        </view>
    </view>
    <!-- 提现日期限制提示 -->
    <view class="withdraw-limit-card top-limit" wx:if="{{!canWithdraw && withdrawMessage}}">
        <view class="limit-icon">📅</view>
        <view class="limit-content">
            <text class="limit-title">暂不可提现</text>
            <text class="limit-message">{{withdrawMessage}}</text>
        </view>
    </view>
    <!-- 佣金保签约提示 -->
    <view class="contract-card top-limit" wx:if="{{bosskgEnabled && !contracted}}">
        <view class="limit-icon">🛡️</view>
        <view class="limit-content">
            <text class="limit-title">需完成实名签约</text>
            <text class="limit-message">根据合规要求，提现前需先签署劳务服务协议</text>
        </view>
        <button class="contract-btn" bindtap="goContract">去签约</button>
    </view>
    <!-- 提现表单 -->
    <view class="form-card">
        <view class="form-title">提现信息</view>
        <view class="form-item">
            <text class="form-label">提现方式</text>
            <view class="type-options">
                <view class="type-option {{form.type === 1 ? 'active' : ''}}" bindtap="selectType" data-type="1" wx:if="{{false}}">
                    <text class="type-icon">💳</text>
                    <text>微信</text>
                </view>
                <view class="type-option {{form.type === 2 ? 'active' : ''}}" bindtap="selectType" data-type="2" wx:if="{{false}}">
                    <text class="type-icon">📱</text>
                    <text>支付宝</text>
                </view>
                <view class="type-option {{form.type === 3 ? 'active' : ''}}" bindtap="selectType" data-type="3">
                    <text class="type-icon">🏦</text>
                    <text>银行卡</text>
                </view>
            </view>
        </view>
        <view class="form-item">
            <text class="form-label">提现金额</text>
            <view class="amount-input">
                <text class="input-prefix">¥</text>
                <input type="digit" placeholder="请输入提现金额" value="{{form.amount}}" bindinput="onAmountInput" />
            </view>
            <view class="quick-amounts">
                <view class="quick-btn" bindtap="setAmount" data-amount="50">50元</view>
                <view class="quick-btn" bindtap="setAmount" data-amount="100">100元</view>
                <view class="quick-btn" bindtap="setAmount" data-amount="200">200元</view>
                <view class="quick-btn all" bindtap="setAllAmount">全部提现</view>
            </view>
        </view>
        <view class="form-item" wx:if="{{form.type === 2 || form.type === 3}}">
            <text class="form-label">{{form.type === 2 ? '支付宝账号' : '银行卡号'}}</text>
            <view class="account-input-row">
                <input class="form-input account-input" placeholder="{{form.type === 2 ? '请输入支付宝账号(手机号/邮箱)' : '请输入银行卡号'}}" value="{{form.account}}" bindinput="onAccountInput" disabled="{{hasContract}}" />
                <view class="edit-card-btn" wx:if="{{hasContract}}" bindtap="showEditCardModal">
                    <text>修改</text>
                </view>
            </view>
            <text class="form-tip" wx:if="{{hasContract}}" style="font-size: 11px; color: #6366f1; margin-top: 4px;">
                * 签约账号，如需修改请点击右侧修改按钮
            </text>
        </view>
        <view class="form-item" wx:if="{{form.type === 1}}">
            <text class="form-label">收款二维码</text>
            <view class="qr-upload-box" bindtap="uploadQRCode">
                <image class="qr-preview" src="{{form.qrCode}}" mode="aspectFit" wx:if="{{form.qrCode}}"></image>
                <view class="upload-placeholder" wx:else>
                    <text class="upload-icon">+</text>
                    <text class="upload-text">点击上传收款码</text>
                </view>
            </view>
            <text class="qr-tip">上传后将自动保存，下次提现无需重复上传</text>
        </view>
        <view class="form-item">
            <text class="form-label">收款人姓名</text>
            <input class="form-input" placeholder="请输入收款人真实姓名" value="{{form.realName}}" bindinput="onRealNameInput" disabled="{{realNameDisabled}}" />
            <text class="form-tip" wx:if="{{realNameDisabled}}" style="font-size: 11px; color: #999; margin-top: 4px;">
                * 已自动锁定签约实名，保障打款安全
            </text>
        </view>
    </view>
    <!-- 修改卡号弹窗 -->
    <view class="modal-mask" wx:if="{{showEditCard}}" bindtap="hideEditCardModal">
        <view class="modal-content" catchtap="">
            <view class="modal-header">
                <text class="modal-title">修改收款账号</text>
                <view class="modal-close" bindtap="hideEditCardModal">×</view>
            </view>
            <view class="modal-body">
                <view class="form-group">
                    <text class="form-label">收款方式</text>
                    <view class="radio-row">
                        <view class="radio-item {{editCardType === 0 ? 'active' : ''}}" bindtap="selectEditCardType" data-type="0">
                            <text class="radio-icon">🏦</text>
                            <text>银行卡</text>
                        </view>
                        <view class="radio-item {{editCardType === 1 ? 'active' : ''}}" bindtap="selectEditCardType" data-type="1">
                            <text class="radio-icon">📱</text>
                            <text>支付宝</text>
                        </view>
                    </view>
                </view>
                <view class="form-group">
                    <text class="form-label">{{editCardType === 0 ? '新银行卡号' : '新支付宝账号'}}</text>
                    <input class="modal-input" placeholder="{{editCardType === 0 ? '请输入新的银行卡号' : '请输入新的支付宝账号'}}" value="{{editCardNo}}" bindinput="onEditCardInput" />
                </view>
                <view class="modal-tips">
                    <text>• 修改后将用于后续的提现打款</text>
                    <text>• 请确保账号信息准确无误</text>
                </view>
            </view>
            <view class="modal-footer">
                <button class="modal-btn cancel" bindtap="hideEditCardModal">取消</button>
                <button class="modal-btn confirm" bindtap="submitEditCard" loading="{{editingCard}}">
                    确认修改
                </button>
            </view>
        </view>
    </view>
    <!-- 提示信息 -->
    <view class="tips-card">
        <view class="tips-title">温馨提示</view>
        <view class="tips-content">
            <text class="tips-highlight">⚡ 回收比例：{{hashratePerYuan}} 聚芯 Orin值 = 1 元人民币</text>
            <text>1. 最低提现金额为 {{minWithdraw}} 元</text>
            <text>2. 线上打款手续费为 {{withdrawFee}}%，线下打款不扣手续费</text>
            <text>3. 提现申请将在 1-3 个工作日内处理</text>
        </view>
    </view>
    <!-- 提交按钮 -->
    <view class="submit-section">
        <view class="preview-info">
            <text>线上预计到账</text>
            <text class="preview-amount">¥{{previewAmount}}</text>
        </view>
        <button class="submit-btn {{(!canWithdraw || !walletReady) ? 'disabled' : ''}}" bindtap="submitWithdraw" loading="{{submitting}}" disabled="{{!canWithdraw || !walletReady || submitting}}">
            {{!canWithdraw ? '限制提现日' : !walletReady ? '余额刷新中...' : submitting ? '提交中...' : '确认提现'}}
        </button>
    </view>
    <!-- 签约管理区域 -->
    <view class="contract-manage-section" wx:if="{{contracted}}">
        <view class="contract-manage-card">
            <view class="contract-manage-info">
                <view class="contract-manage-left">
                    <text class="contract-manage-icon">🛡️</text>
                    <text class="contract-manage-label">签约状态</text>
                </view>
                <text class="contract-tag tag-success">已签约</text>
            </view>
            <button class="cancel-contract-btn" bindtap="cancelContract" loading="{{cancelling}}" disabled="{{cancelling}}">
                {{cancelling ? '解约中...' : '解除签约'}}
            </button>
        </view>
    </view>
</view>
