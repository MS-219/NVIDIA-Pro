<view class="container">
    <view class="header-actions">
        <view class="nav-right" bindtap="goRecords">
            <text>提现记录</text>
            <view class="nav-arrow"></view>
        </view>
    </view>

    <view class="balance-card">
        <view class="telemetry-head">
            <view>
                <text class="telemetry-kicker">SETTLEMENT TELEMETRY</text>
                <text class="balance-label">可回收聚芯 Orin 值</text>
            </view>
            <view class="live-state"><view class="live-dot"></view><text>READY</text></view>
        </view>
        <view class="balance-amount">
            <text class="currency">ORIN</text>
            <text class="amount">{{walletInfo.hashrateBalance}}</text>
        </view>
        <view class="exchange-info">
            <text class="exchange-rate">约 ¥{{walletInfo.available}} · {{hashratePerYuan}} Orin 值 = 1 元</text>
        </view>
        <view class="balance-info">
            <view class="metric-cell">
                <text class="metric-label">累计 Orin 值</text>
                <text class="metric-value">{{walletInfo.totalHashrate}}</text>
            </view>
            <view class="metric-cell align-right">
                <text class="metric-label">待审核金额</text>
                <text class="metric-value">¥{{walletInfo.pending}}</text>
            </view>
        </view>
    </view>

    <view class="withdraw-limit-card top-limit" wx:if="{{!canWithdraw && withdrawMessage}}">
        <view class="notice-mark calendar-mark"><view></view></view>
        <view class="limit-content">
            <text class="limit-title">当前时段暂停提现</text>
            <text class="limit-message">{{withdrawMessage}}</text>
        </view>
    </view>

    <view class="contract-card top-limit" wx:if="{{bosskgEnabled && !contracted}}">
        <view class="notice-mark identity-mark"><view></view></view>
        <view class="limit-content">
            <text class="limit-title">实名签约待完成</text>
            <text class="limit-message">提现前需签署劳务服务协议并完成身份核验</text>
        </view>
        <button class="contract-btn" bindtap="goContract">去签约</button>
    </view>

    <view class="form-card">
        <view class="form-heading">
            <view>
                <text class="section-kicker">SETTLEMENT INPUT</text>
                <text class="form-title">提现信息</text>
            </view>
            <view class="section-rule"></view>
        </view>

        <view class="form-item">
            <text class="form-label">提现方式</text>
            <view class="type-options">
                <view class="type-option {{form.type === 1 ? 'active' : ''}}" bindtap="selectType" data-type="1" wx:if="{{false}}">
                    <view class="method-glyph qr-glyph"><view></view></view>
                    <text>微信</text>
                </view>
                <view class="type-option {{form.type === 2 ? 'active' : ''}}" bindtap="selectType" data-type="2" wx:if="{{false}}">
                    <view class="method-glyph account-glyph"><view></view></view>
                    <text>支付宝</text>
                </view>
                <view class="type-option {{form.type === 3 ? 'active' : ''}}" bindtap="selectType" data-type="3">
                    <view class="method-glyph bank-glyph"><view></view></view>
                    <text>银行卡</text>
                    <text class="method-state">当前通道</text>
                </view>
            </view>
        </view>

        <view class="form-item">
            <text class="form-label">提现金额</text>
            <view class="amount-input">
                <text class="input-prefix">¥</text>
                <input type="digit" placeholder="请输入提现金额" value="{{form.amount}}" bindinput="onAmountInput" />
            </view>
            <view class="quick-amounts">
                <view class="quick-btn" bindtap="setAmount" data-amount="50">50 元</view>
                <view class="quick-btn" bindtap="setAmount" data-amount="100">100 元</view>
                <view class="quick-btn" bindtap="setAmount" data-amount="200">200 元</view>
                <view class="quick-btn all" bindtap="setAllAmount">全部</view>
            </view>
        </view>

        <view class="form-item" wx:if="{{form.type === 2 || form.type === 3}}">
            <text class="form-label">{{form.type === 2 ? '支付宝账号' : '银行卡号'}}</text>
            <view class="account-input-row">
                <input class="form-input account-input" placeholder="{{form.type === 2 ? '请输入支付宝账号（手机号或邮箱）' : '请输入银行卡号'}}" value="{{form.account}}" bindinput="onAccountInput" disabled="{{hasContract}}" />
                <view class="edit-card-btn" wx:if="{{hasContract}}" bindtap="showEditCardModal">修改</view>
            </view>
            <text class="form-tip teal-tip" wx:if="{{hasContract}}">签约账号已锁定，点击修改可提交变更申请</text>
        </view>

        <view class="form-item" wx:if="{{form.type === 1}}">
            <text class="form-label">收款二维码</text>
            <view class="qr-upload-box" bindtap="uploadQRCode">
                <image class="qr-preview" src="{{form.qrCode}}" mode="aspectFit" wx:if="{{form.qrCode}}"></image>
                <view class="upload-placeholder" wx:else>
                    <view class="upload-icon"></view>
                    <text class="upload-text">上传收款码</text>
                </view>
            </view>
            <text class="qr-tip">上传后自动保存，下次提现可直接使用</text>
        </view>

        <view class="form-item last-item">
            <text class="form-label">收款人姓名</text>
            <input class="form-input" placeholder="请输入收款人真实姓名" value="{{form.realName}}" bindinput="onRealNameInput" disabled="{{realNameDisabled}}" />
            <text class="form-tip" wx:if="{{realNameDisabled}}">已锁定签约实名，保障打款信息一致</text>
        </view>
    </view>

    <view class="modal-mask" wx:if="{{showEditCard}}" bindtap="hideEditCardModal">
        <view class="modal-content" catchtap="">
            <view class="modal-header">
                <text class="modal-title">修改收款账号</text>
                <view class="modal-close" bindtap="hideEditCardModal"><view></view></view>
            </view>
            <view class="modal-body">
                <view class="form-group">
                    <text class="form-label">收款方式</text>
                    <view class="radio-row">
                        <view class="radio-item {{editCardType === 0 ? 'active' : ''}}" bindtap="selectEditCardType" data-type="0">
                            <view class="method-glyph bank-glyph"><view></view></view>
                            <text>银行卡</text>
                        </view>
                        <view class="radio-item {{editCardType === 1 ? 'active' : ''}}" bindtap="selectEditCardType" data-type="1">
                            <view class="method-glyph account-glyph"><view></view></view>
                            <text>支付宝</text>
                        </view>
                    </view>
                </view>
                <view class="form-group">
                    <text class="form-label">{{editCardType === 0 ? '新银行卡号' : '新支付宝账号'}}</text>
                    <input class="modal-input" placeholder="{{editCardType === 0 ? '请输入新的银行卡号' : '请输入新的支付宝账号'}}" value="{{editCardNo}}" bindinput="onEditCardInput" />
                </view>
                <view class="modal-tips">
                    <text>修改后用于后续提现打款</text>
                    <text>提交前请再次核对账号信息</text>
                </view>
            </view>
            <view class="modal-footer">
                <button class="modal-btn cancel" bindtap="hideEditCardModal">取消</button>
                <button class="modal-btn confirm" bindtap="submitEditCard" loading="{{editingCard}}">确认修改</button>
            </view>
        </view>
    </view>

    <view class="tips-card">
        <view class="tips-title"><view class="tips-mark"></view><text>结算说明</text></view>
        <view class="tips-content">
            <text class="tips-highlight">回收比例：{{hashratePerYuan}} 聚芯 Orin 值 = 1 元人民币</text>
            <text>01 · 最低提现金额为 {{minWithdraw}} 元</text>
            <text>02 · 线上打款手续费为 {{withdrawFee}}%，线下打款不扣手续费</text>
            <text>03 · 提现申请将在 1-3 个工作日内处理</text>
        </view>
    </view>

    <view class="contract-manage-section" wx:if="{{contracted}}">
        <view class="contract-manage-card">
            <view class="contract-manage-info">
                <view class="contract-manage-left">
                    <view class="shield-mark"><view></view></view>
                    <view>
                        <text class="contract-manage-label">劳务服务签约</text>
                        <text class="contract-manage-sub">身份与收款信息已通过核验</text>
                    </view>
                </view>
                <text class="contract-tag tag-success">已签约</text>
            </view>
            <button class="cancel-contract-btn" bindtap="cancelContract" loading="{{cancelling}}" disabled="{{cancelling}}">{{cancelling ? '解约中...' : '解除签约'}}</button>
        </view>
    </view>

    <view class="submit-section">
        <view class="preview-info">
            <text>线上预计到账</text>
            <text class="preview-amount">¥{{previewAmount}}</text>
        </view>
        <button class="submit-btn {{(!canWithdraw || !walletReady) ? 'disabled' : ''}}" bindtap="submitWithdraw" loading="{{submitting}}" disabled="{{!canWithdraw || !walletReady || submitting}}">{{!canWithdraw ? '限制提现日' : !walletReady ? '余额刷新中...' : submitting ? '提交中...' : '确认提现'}}</button>
    </view>
</view>
