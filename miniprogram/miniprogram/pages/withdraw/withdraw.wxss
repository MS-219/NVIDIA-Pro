@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed;
    color: #1c211b;
}

.container {
    box-sizing: border-box;
    padding: 8px 18px 176px;
}

.header-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 8px;
}

.nav-right {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 4px 0 16px;
    color: #4f5950;
    font-size: 13px;
    font-weight: 600;
}

.nav-arrow {
    width: 7px;
    height: 7px;
    border-top: 1.5px solid #137570;
    border-right: 1.5px solid #137570;
    transform: rotate(45deg);
}

.balance-card {
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    margin-bottom: 14px;
    padding: 18px 20px 17px;
    background: #151a14 !important;
    border: 1px solid rgba(118, 185, 0, .28) !important;
    border-radius: 8px !important;
    color: #f7f9f5;
    box-shadow: none !important;
}

.balance-card::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: #76B900 !important;
}

.telemetry-head,
.balance-info,
.preview-info,
.contract-manage-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.telemetry-kicker,
.section-kicker {
    display: block;
    margin-bottom: 5px;
    color: #8f9a8d;
    font-size: 10px;
    line-height: 1.2;
}

.balance-label {
    display: block;
    color: #e4e9e1;
    font-size: 13px;
    font-weight: 600;
}

.live-state {
    min-height: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 8px;
    border: 1px solid rgba(118, 185, 0, .28);
    border-radius: 999px;
    color: #9ed73d;
    font-size: 10px;
}

.live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #76B900;
}

.balance-amount {
    min-height: 58px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
}

.currency {
    color: #76B900;
    font-size: 11px;
    font-weight: 800;
}

.amount {
    color: #ffffff;
    font-family: 'DIN Alternate', Menlo, monospace;
    font-size: 38px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
}

.exchange-info {
    margin-bottom: 14px;
}

.exchange-rate {
    color: #c8d0c5;
    font-size: 12px;
    line-height: 1.45;
}

.balance-info {
    padding-top: 13px;
    border-top: 1px solid rgba(255, 255, 255, .1);
}

.metric-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.metric-cell.align-right {
    align-items: flex-end;
}

.metric-label {
    color: #899287;
    font-size: 10px;
}

.metric-value {
    color: #f1f4ef;
    font-family: 'DIN Alternate', Menlo, monospace;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
}

.withdraw-limit-card,
.contract-card {
    min-height: 68px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    padding: 12px 13px;
    background: rgba(255, 255, 255, .94) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.withdraw-limit-card {
    border: 1px solid rgba(192, 138, 47, .28) !important;
}

.withdraw-limit-card.rule-open-card {
    border-color: rgba(19, 117, 112, .28) !important;
}

.withdraw-limit-card.rule-open-card .calendar-mark {
    border-color: rgba(19, 117, 112, .4);
    background: rgba(19, 117, 112, .08);
}

.withdraw-limit-card.rule-open-card .calendar-mark::before,
.withdraw-limit-card.rule-open-card .calendar-mark::after,
.withdraw-limit-card.rule-open-card .calendar-mark view {
    background: #137570;
}

.withdraw-limit-card.rule-open-card .calendar-mark view {
    box-shadow: 8px 0 0 rgba(19, 117, 112, .6), 0 8px 0 rgba(19, 117, 112, .6), 8px 8px 0 rgba(19, 117, 112, .6);
}

.contract-card {
    border: 1px solid rgba(19, 117, 112, .24) !important;
}

.top-limit {
    margin-top: 0 !important;
}

.notice-mark {
    position: relative;
    width: 44px;
    height: 44px;
    box-sizing: border-box;
    flex: 0 0 44px;
    border-radius: 6px;
}

.calendar-mark {
    border: 1px solid rgba(192, 138, 47, .4);
    background: rgba(192, 138, 47, .1);
}

.calendar-mark::before {
    content: '';
    position: absolute;
    top: 12px;
    right: 9px;
    left: 9px;
    height: 2px;
    background: #C08A2F;
}

.calendar-mark::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 13px;
    width: 2px;
    height: 5px;
    background: #C08A2F;
    box-shadow: 14px 0 0 #C08A2F;
}

.calendar-mark view {
    position: absolute;
    top: 20px;
    left: 13px;
    width: 4px;
    height: 4px;
    background: #C08A2F;
    box-shadow: 8px 0 0 rgba(192, 138, 47, .6), 0 8px 0 rgba(192, 138, 47, .6), 8px 8px 0 rgba(192, 138, 47, .6);
}

.identity-mark,
.shield-mark {
    border: 1px solid rgba(19, 117, 112, .34);
    background: rgba(19, 117, 112, .08);
}

.identity-mark::before,
.shield-mark::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 13px;
    width: 16px;
    height: 20px;
    border: 2px solid #137570;
    border-radius: 8px 8px 10px 10px;
}

.identity-mark view,
.shield-mark view {
    position: absolute;
    top: 15px;
    left: 20px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #137570;
    box-shadow: 0 7px 0 -1px #137570;
}

.limit-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.limit-title {
    color: #30372f;
    font-size: 13px;
    font-weight: 700;
}

.limit-message {
    color: #717a70;
    font-size: 11px;
    line-height: 1.45;
}

.contract-btn {
    min-width: 76px;
    min-height: 44px;
    margin: 0;
    padding: 0 13px;
    line-height: 44px;
}

.form-card,
.tips-card,
.contract-manage-card {
    box-sizing: border-box;
    margin-bottom: 14px;
    padding: 17px;
    background: rgba(255, 255, 255, .94) !important;
    border: 1px solid rgba(28, 33, 27, .08) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.form-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 18px;
}

.form-title {
    display: block;
    color: #20261f;
    font-size: 17px;
    font-weight: 700;
}

.section-rule {
    width: 42px;
    height: 3px;
    background: linear-gradient(90deg, #76B900 0 50%, #137570 50% 100%);
}

.form-item {
    margin-bottom: 20px;
}

.last-item {
    margin-bottom: 0;
}

.form-label,
.input-label {
    display: block;
    margin-bottom: 8px;
    color: #596257;
    font-size: 13px;
    font-weight: 600;
}

.type-options,
.quick-amounts,
.radio-row,
.account-input-row,
.modal-footer {
    display: flex;
    gap: 8px;
}

.type-option,
.radio-item {
    min-height: 54px;
    box-sizing: border-box;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 11px;
    background: #f5f7f3;
    border: 1px solid rgba(28, 33, 27, .1);
    border-radius: 8px;
    color: #454d43;
    font-size: 13px;
}

.type-option.active,
.radio-item.active {
    background: rgba(118, 185, 0, .1);
    border-color: rgba(118, 185, 0, .45);
    color: #3f6900;
}

.method-state {
    margin-left: auto;
    color: #4f7f00;
    font-size: 10px !important;
}

.method-glyph {
    position: relative;
    width: 30px;
    height: 30px;
    box-sizing: border-box;
    flex: 0 0 30px;
    color: #137570;
}

.bank-glyph {
    border-top: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
}

.bank-glyph::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 5px;
    width: 2px;
    height: 12px;
    background: currentColor;
    box-shadow: 8px 0 0 currentColor, 16px 0 0 currentColor;
}

.bank-glyph::after {
    content: '';
    position: absolute;
    top: -8px;
    left: 4px;
    border-right: 11px solid transparent;
    border-bottom: 5px solid currentColor;
    border-left: 11px solid transparent;
}

.account-glyph {
    width: 18px;
    height: 28px;
    margin: 1px 6px;
    border: 2px solid currentColor;
    border-radius: 4px;
}

.account-glyph::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 6px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
}

.qr-glyph::before,
.qr-glyph::after,
.qr-glyph view {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    border: 2px solid currentColor;
}

.qr-glyph::before { top: 2px; left: 2px; }
.qr-glyph::after { top: 2px; right: 2px; }
.qr-glyph view { right: 2px; bottom: 2px; }

.amount-input,
.form-input,
.modal-input {
    min-height: 48px;
    box-sizing: border-box;
    background: #f8faf7 !important;
    border: 1px solid rgba(28, 33, 27, .12) !important;
    border-radius: 8px !important;
}

.amount-input {
    display: flex;
    align-items: center;
    padding: 0 14px;
}

.input-prefix {
    color: #137570;
    font-size: 19px;
    font-weight: 700;
}

.amount-input input {
    height: 48px;
    flex: 1;
    padding-left: 9px;
    color: #20261f;
    font-family: 'DIN Alternate', Menlo, monospace;
    font-size: 23px;
    font-weight: 700;
}

.quick-amounts {
    margin-top: 9px;
}

.quick-btn {
    min-height: 44px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    background: #f2f4f0;
    border: 1px solid rgba(28, 33, 27, .08);
    border-radius: 6px !important;
    color: #50584e;
    font-size: 12px;
}

.quick-btn.all {
    background: rgba(19, 117, 112, .08);
    border-color: rgba(19, 117, 112, .22);
    color: #137570;
}

.form-input,
.modal-input {
    width: 100%;
    height: 48px;
    padding: 0 13px;
    color: #252b24;
    font-size: 13px !important;
}

.account-input-row {
    align-items: stretch;
}

.account-input {
    min-width: 0;
    flex: 1;
}

.edit-card-btn {
    min-width: 62px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    color: #137570 !important;
    font-size: 12px;
}

.form-tip,
.qr-tip {
    display: block;
    margin-top: 6px;
    color: #8b9389;
    font-size: 11px;
    line-height: 1.45;
}

.teal-tip {
    color: #137570;
}

.qr-upload-box {
    position: relative;
    width: 100%;
    height: 144px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #f6f8f5 !important;
    border: 1px dashed rgba(19, 117, 112, .35) !important;
    border-radius: 8px !important;
}

.qr-preview {
    width: 100%;
    height: 100%;
}

.upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
}

.upload-icon {
    position: relative;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(19, 117, 112, .28);
    border-radius: 6px;
}

.upload-icon::before,
.upload-icon::after {
    content: '';
    position: absolute;
    top: 16px;
    left: 9px;
    width: 16px;
    height: 2px;
    background: #137570;
}

.upload-icon::after {
    transform: rotate(90deg);
}

.upload-text {
    color: #137570;
    font-size: 12px;
}

.tips-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
    color: #58461f;
    font-size: 14px;
    font-weight: 700;
}

.tips-mark {
    width: 4px;
    height: 18px;
    background: #C08A2F;
}

.tips-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.tips-content text {
    color: #71674f;
    font-size: 12px;
    line-height: 1.5;
}

.tips-highlight {
    padding: 9px 10px;
    background: rgba(192, 138, 47, .08);
    border-left: 3px solid #C08A2F;
    border-radius: 4px;
    color: #75551f !important;
    font-size: 13px !important;
    font-weight: 700;
}

.contract-manage-section {
    margin-bottom: 14px;
}

.contract-manage-card {
    margin-bottom: 0;
}

.contract-manage-left {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 11px;
}

.shield-mark {
    position: relative;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: 6px;
}

.contract-manage-label,
.contract-manage-sub {
    display: block;
}

.contract-manage-label {
    color: #343b33;
    font-size: 13px;
    font-weight: 700;
}

.contract-manage-sub {
    margin-top: 3px;
    color: #7f887d;
    font-size: 11px;
}

.contract-tag {
    min-height: 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.tag-success {
    background: rgba(118, 185, 0, .12);
    color: #4f7f00;
}

.cancel-contract-btn {
    width: 100%;
    min-height: 44px;
    margin: 14px 0 0;
    font-size: 13px;
}

.submit-section {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    box-sizing: border-box;
    padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, .96) !important;
    border: 0 !important;
    border-top: 1px solid rgba(28, 33, 27, .1) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.preview-info {
    margin-bottom: 8px;
    color: #697267;
    font-size: 12px;
}

.preview-amount {
    color: #137570;
    font-family: 'DIN Alternate', Menlo, monospace;
    font-size: 19px;
    font-weight: 700;
}

.submit-btn {
    width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 0;
    font-size: 13px !important;
}

.submit-btn.disabled {
    background: #c9cec7 !important;
    color: #6f776d !important;
}

.modal-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 17, 13, .58);
}

.modal-content {
    width: 86%;
    max-width: 340px;
    overflow: hidden;
    background: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, .18) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.modal-header {
    min-height: 56px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px 6px 17px;
    border-bottom: 1px solid rgba(28, 33, 27, .08);
}

.modal-title {
    color: #252b24;
    font-size: 15px;
    font-weight: 700;
}

.modal-close {
    position: relative;
    width: 44px;
    height: 44px;
}

.modal-close::before,
.modal-close::after {
    content: '';
    position: absolute;
    top: 21px;
    left: 13px;
    width: 18px;
    height: 1.5px;
    background: #687066;
    transform: rotate(45deg);
}

.modal-close::after {
    transform: rotate(-45deg);
}

.modal-body {
    padding: 17px;
}

.form-group {
    margin-bottom: 17px;
}

.radio-row {
    margin-top: 8px;
}

.radio-item {
    justify-content: center;
}

.modal-input {
    margin-top: 8px;
}

.modal-tips {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px 11px;
    background: rgba(192, 138, 47, .08);
    border-left: 3px solid #C08A2F;
}

.modal-tips text {
    color: #77623c;
    font-size: 11px;
    line-height: 1.45;
}

.modal-footer {
    padding: 0 17px 17px;
}

.modal-btn {
    min-height: 44px;
    flex: 1;
    margin: 0;
    padding: 0;
    font-size: 13px !important;
}

page .modal-btn.cancel {
    background: #f3f5f1 !important;
    border-color: rgba(28, 33, 27, .1) !important;
    color: #687066 !important;
}

page .modal-btn.confirm {
    background: #76B900 !important;
    border-color: #76B900 !important;
    color: #0b0e0a !important;
    font-weight: 700;
}
