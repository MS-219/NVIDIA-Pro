@import "../../styles/orin-polish.wxss";

.container {
    min-height: 100vh;
    background-color: #f8f9ff;
    display: flex;
    flex-direction: column;
}

.nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
}

.nav-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #333333;
}

.content {
    flex: 1;
    padding: 60rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* 头部提示 */
.header-tip {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60rpx;
    text-align: center;
}

.tip-emoji {
    font-size: 100rpx;
    margin-bottom: 20rpx;
}

.tip-title {
    font-size: 40rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 12rpx;
}

.tip-desc {
    font-size: 28rpx;
    color: #999999;
}

/* 头像选择 - 保持正圆 */
.avatar-section {
    display: flex;
    justify-content: center;
    margin-bottom: 80rpx;
    width: 100%;
}

.avatar-wrapper {
    position: relative;
    width: 200rpx;
    height: 200rpx;
}

.avatar-btn {
    width: 200rpx !important;
    height: 200rpx !important;
    border-radius: 100rpx !important;
    padding: 0 !important;
    margin: 0 !important;
    background: #ffffff !important;
    border: 4rpx solid #eeeeee !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.avatar-btn::after {
    border: none !important;
}

.avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.avatar-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #cccccc;
}

.placeholder-icon {
    font-size: 60rpx;
    margin-bottom: 4rpx;
}

.placeholder-text {
    font-size: 20rpx;
}

.tip-emoji { width: 56px; height: 56px; margin-bottom: 14px; display: flex; align-items: center; justify-content: center; background: #121611; border: 1px solid rgba(118,185,0,.25); border-radius: 8px; color: #9dda39; font-family: "DIN Alternate", Menlo, monospace; font-size: 14px; font-weight: 800; }
.placeholder-icon { width: 32px; height: 32px; margin-bottom: 4px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.13); border-radius: 6px; color: #548600; font-size: 24px; }

.avatar-edit-badge {
    position: absolute;
    bottom: 0;
    right: 0;
    background: #137570;
    color: #fff;
    font-size: 20rpx;
    padding: 4rpx 14rpx;
    border-radius: 4px;
    box-shadow: none;
    z-index: 10;
    pointer-events: none;
}

/* 表单区域 */
.form-card {
    width: 100%;
    background: #ffffff;
    border-radius: 32rpx;
    padding: 48rpx;
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
    margin-bottom: 80rpx;
}

.nickname-section {
    width: 100%;
}

.input-label {
    font-size: 26rpx;
    color: #999999;
    margin-bottom: 24rpx;
    display: block;
}

.nickname-input {
    width: 100%;
    height: 80rpx;
    font-size: 32rpx;
    color: #333333;
    border-bottom: 2rpx solid #f5f5f5;
    padding-bottom: 10rpx;
}

.placeholder-style {
    color: #cccccc;
}

/* 操作按钮 */
.action-buttons {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.save-btn {
    width: 100% !important;
    height: 96rpx !important;
    line-height: 96rpx !important;
    background: linear-gradient(135deg, #667eea, #764ba2) !important;
    color: #ffffff !important;
    font-size: 32rpx !important;
    font-weight: 600 !important;
    border-radius: 48rpx !important;
    border: none !important;
    box-shadow: 0 10rpx 20rpx rgba(102, 126, 234, 0.2) !important;
}

.save-btn.disabled {
    background: #cccccc !important;
    box-shadow: none !important;
}

.skip-btn {
    width: 100% !important;
    background: transparent !important;
    color: #999999 !important;
    font-size: 28rpx !important;
    margin-top: 10rpx !important;
}

page { background: #eef1ed; }
.container { background: #eef1ed; }
.content { padding: 24px 20px 40px; }
.header-tip { margin-bottom: 28px; }
.tip-title { color: #1c211b; font-size: 23px; }
.tip-desc { color: #7d8579; font-size: 14px; }
.avatar-section { margin-bottom: 32px; }
.avatar-btn { border-color: rgba(28,33,27,.1) !important; box-shadow: none; }
.form-card { margin-bottom: 40px; padding: 24px; border-radius: 8px; box-shadow: none; }
.input-label { margin-bottom: 12px; color: #737b70; font-size: 13px; }
.nickname-input { min-height: 44px; padding: 0; color: #1c211b; font-size: 15px; border-bottom-color: rgba(28,33,27,.1); }
