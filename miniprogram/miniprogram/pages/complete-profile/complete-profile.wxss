@import "../../styles/orin-polish.wxss";

page {
    min-height: 100%;
    background: #eef1ed;
    color: #1c211b;
}

.container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #eef1ed;
}

.nav-bar {
    position: relative;
    flex: 0 0 auto;
    box-sizing: content-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 64px;
    padding-right: 96px;
    background: rgba(255, 255, 255, .94);
    border-bottom: 1px solid rgba(28, 33, 27, .08);
}

.nav-title {
    overflow: hidden;
    color: #1c211b;
    font-size: 17px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.nav-back {
    position: absolute;
    left: 8px;
    bottom: -6px;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: #31372f;
    line-height: 1;
    border-radius: 8px;
}

.nav-back::after {
    border: 0;
}

.nav-back text {
    transform: translateY(-1px);
    font-size: 30px;
    font-weight: 400;
}

.nav-back-pressed {
    background: rgba(28, 33, 27, .06);
}

.content {
    flex: 1;
    min-height: 0;
    padding: 16px 16px calc(16px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.identity-panel {
    position: relative;
    overflow: hidden;
    padding: 20px 20px 21px;
    background: #121611;
    border: 1px solid rgba(118, 185, 0, .26);
    border-radius: 8px;
    color: #f7f9f5;
}

.identity-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #76b900;
}

.identity-kicker,
.identity-title,
.identity-desc {
    display: block;
}

.identity-kicker {
    color: #9dda39;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 10px;
    font-weight: 700;
}

.identity-title {
    margin-top: 11px;
    color: #ffffff;
    font-size: 21px;
    line-height: 28px;
    font-weight: 720;
}

.identity-desc {
    margin-top: 6px;
    color: #aab1a7;
    font-size: 12px;
    line-height: 18px;
}

.profile-form {
    margin-top: 12px;
    padding: 0 16px;
    background: #ffffff;
    border: 1px solid rgba(28, 33, 27, .09);
    border-radius: 8px;
}

.avatar-row {
    width: 100%;
    height: 96px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    background: transparent;
    border: 0;
    color: #1c211b;
    line-height: normal;
    text-align: left;
    border-radius: 0;
}

.avatar-row::after {
    border: 0;
}

.row-pressed {
    opacity: .72;
}

.avatar-frame {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    overflow: hidden;
    background: #edf4e4;
    border: 2px solid rgba(118, 185, 0, .24);
    border-radius: 50%;
}

.avatar-img {
    width: 100%;
    height: 100%;
    display: block;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4f7f00;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 18px;
    font-weight: 800;
}

.avatar-copy {
    min-width: 0;
    flex: 1;
    margin-left: 14px;
}

.avatar-copy text {
    display: block;
}

.avatar-copy text:first-child {
    color: #1c211b;
    font-size: 15px;
    font-weight: 700;
}

.avatar-copy text:last-child {
    margin-top: 6px;
    overflow: hidden;
    color: #7d8579;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.avatar-action {
    flex: 0 0 auto;
    min-width: 44px;
    height: 44px;
    margin-left: 8px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: #4f7f00;
    font-size: 12px;
    font-weight: 650;
}

.form-divider {
    height: 1px;
    background: rgba(28, 33, 27, .08);
}

.nickname-section {
    padding: 18px 0 20px;
}

.field-head {
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.input-label {
    color: #3c433a;
    font-size: 13px;
    font-weight: 650;
}

.field-state {
    color: #4f7f00;
    font-size: 11px;
}

.nickname-field {
    width: 100%;
    height: 48px;
    margin-top: 9px;
    padding: 0 14px;
    box-sizing: border-box;
    background: #f7f8f5;
    border: 1px solid rgba(28, 33, 27, .11);
    border-radius: 8px;
    color: #1c211b;
    font-size: 15px;
}

.placeholder-style {
    color: #a4aaa1;
}

.field-helper {
    display: block;
    margin-top: 8px;
    color: #858d81;
    font-size: 11px;
    line-height: 16px;
}

.action-buttons {
    width: 100%;
    margin-top: auto;
    padding-top: 24px;
}

.primary-action {
    width: 100%;
    height: 48px;
    margin: 0;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #76b900;
    border: 0;
    border-radius: 8px;
    color: #0b0e0a;
    font-size: 14px;
    font-weight: 750;
    line-height: 48px;
}

.primary-action::after,
.secondary-action::after {
    border: 0;
}

.primary-action.disabled {
    background: #d9ded6;
    color: #737b70;
}

.secondary-action {
    width: 100%;
    height: 44px;
    margin: 6px 0 0;
    padding: 0;
    background: transparent;
    border: 0;
    color: #737b70;
    font-size: 13px;
    line-height: 44px;
}

@media (max-width: 350px) {
    .content {
        padding-left: 12px;
        padding-right: 12px;
    }

    .identity-panel {
        padding: 18px 18px 19px;
    }

    .identity-title {
        font-size: 20px;
    }

    .profile-form {
        padding: 0 14px;
    }

    .avatar-frame {
        flex-basis: 64px;
        width: 64px;
        height: 64px;
    }

    .avatar-copy {
        margin-left: 12px;
    }
}
