<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px; height: {{navBarHeight}}px;">
        <view class="nav-back" bindtap="onGoBack" hover-class="tap-muted" aria-role="button" aria-label="返回上一页"><text>‹</text></view>
        <text class="nav-title">兑换订单</text><view class="nav-placeholder"></view>
    </view>

    <view class="order-anchor">
        <view><view class="anchor-kicker"><view></view><text>兑换订单</text></view><text>设备交付状态</text></view>
        <view class="anchor-count"><text>{{orders.length}}</text><text>当前载入</text></view>
        <view class="anchor-sync {{loading ? 'is-loading' : errorMessage ? 'is-error' : ''}}"><view></view><text>{{loading ? '同步中' : errorMessage ? '异常' : '已同步'}}</text></view>
    </view>

    <scroll-view scroll-x class="tab-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tab-bar"><view class="tab-item {{activeTab === item.value ? 'tab-active' : ''}}" wx:for="{{tabs}}" wx:key="value" bindtap="switchTab" data-value="{{item.value}}">{{item.label}}</view></view>
    </scroll-view>

    <view class="loading-state" wx:if="{{loading && orders.length === 0}}">
        <view class="loading-card" wx:for="{{[1,2,3]}}" wx:key="*this"><view class="loading-line wide jx-skeleton"></view><view class="loading-body"><view class="loading-media jx-skeleton"></view><view><view class="loading-line jx-skeleton"></view><view class="loading-line short jx-skeleton"></view></view></view></view>
    </view>

    <view class="error-state" wx:elif="{{errorMessage && orders.length === 0}}">
        <view class="state-mark"><view></view><text>订单连接异常</text></view><text class="state-title">订单同步中断</text><text class="state-desc">{{errorMessage}}</text><button bindtap="retryOrders">重新加载</button>
    </view>

    <view class="order-list" wx:elif="{{orders.length}}">
        <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-orderno="{{item.orderNo}}" hover-class="card-pressed">
            <view class="order-header"><text class="order-no">NO. {{item.orderNo}}</text><text class="order-status status-{{item.status}}">{{statusTexts[item.status]}}</text></view>
            <view class="order-body">
                <image class="order-product-img" src="{{item.productImage || '/images/product.png'}}" mode="aspectFit"></image>
                <view class="order-product-info"><text class="order-product-name">{{item.productName}}</text><text class="order-qty">数量 {{item.quantity}}</text><view class="order-cost"><image src="/images/menu/earnings.png" mode="aspectFit"></image><text>{{item.hashrateCost}}</text><text>节点权益</text></view></view>
            </view>
            <view class="order-footer"><text class="order-time">{{item.createTime || '--'}}</text><text class="order-arrow">查看详情 ›</text></view>
        </view>
        <view class="loading-more" wx:if="{{loading}}"><view></view><text>正在载入更多</text></view>
        <view class="no-more" wx:elif="{{!hasMore}}">全部订单已载入</view>
    </view>

    <view class="empty-state" wx:else>
        <image src="/images/menu/orders.png" mode="aspectFit"></image><text class="state-title">暂无兑换订单</text><text class="state-desc">提交设备兑换后，处理进度会显示在这里</text>
    </view>
</view>
