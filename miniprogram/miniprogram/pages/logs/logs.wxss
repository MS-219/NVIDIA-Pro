@import "../../styles/orin-polish.wxss";

page { height: 100vh; background: #eef1ed; color: #1c211b; }
.scrollarea { height: 100vh; }
.logs-page { min-height: 100%; padding: 12px; box-sizing: border-box; }
.telemetry-card { position: relative; padding: 18px; overflow: hidden; background: #121611; border: 1px solid rgba(118,185,0,.28); border-radius: 8px; }
.telemetry-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }
.telemetry-head { min-height: 24px; display: flex; align-items: center; justify-content: space-between; color: #9dda39; font-family: "DIN Alternate", Menlo, monospace; font-size: 10px; font-weight: 700; }
.telemetry-head > view { display: flex; align-items: center; color: #aeb6ab; }
.telemetry-head > view > view { width: 5px; height: 5px; margin-right: 5px; background: #76b900; border-radius: 50%; }
.telemetry-title { display: block; margin-top: 10px; color: #f7f9f5; font-size: 22px; font-weight: 750; }
.telemetry-metrics { margin-top: 18px; padding-top: 15px; display: grid; grid-template-columns: 100px 1fr; border-top: 1px solid rgba(255,255,255,.1); }
.telemetry-metrics > view { min-width: 0; border-right: 1px solid rgba(255,255,255,.1); }
.telemetry-metrics > view:last-child { padding-left: 16px; border-right: 0; }
.telemetry-metrics text { display: block; }
.telemetry-metrics text:first-child { overflow: hidden; color: #f7f9f5; font-family: "DIN Alternate", Menlo, monospace; font-size: 18px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.telemetry-metrics > view:last-child text:first-child { font-size: 13px; }
.telemetry-metrics text:last-child { margin-top: 5px; color: #92998f; font-size: 10px; }
.section-head { min-height: 66px; padding: 0 4px; display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 10px; box-sizing: border-box; }
.section-head text { display: block; }
.section-head > view > text:first-child { color: #1c211b; font-size: 16px; font-weight: 700; }
.section-head > view > text:last-child { margin-top: 3px; color: #92998f; font-family: "DIN Alternate", Menlo, monospace; font-size: 10px; font-weight: 700; }
.section-head > text { color: #737b70; font-size: 11px; }
.log-list { overflow: hidden; background: #fff; border: 1px solid rgba(28,33,27,.075); border-radius: 8px; }
.log-item { min-height: 68px; padding: 12px 14px; box-sizing: border-box; display: flex; align-items: center; border-bottom: 1px solid rgba(28,33,27,.065); }
.log-item:last-child { border-bottom: 0; }
.log-code { width: 34px; height: 34px; flex: 0 0 34px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.12); color: #548600; font-family: "DIN Alternate", Menlo, monospace; font-size: 11px; font-weight: 800; border-radius: 6px; }
.log-copy { min-width: 0; flex: 1; margin-left: 12px; }
.log-copy text { display: block; }
.log-copy text:first-child { color: #343a32; font-family: "DIN Alternate", Menlo, monospace; font-size: 10px; font-weight: 700; }
.log-copy text:last-child { margin-top: 5px; color: #737b70; font-family: "DIN Alternate", Menlo, monospace; font-size: 12px; }
.log-status { min-height: 44px; display: flex; align-items: center; color: #6d756b; font-size: 10px; }
.log-status view { width: 5px; height: 5px; margin-right: 5px; background: #76b900; border-radius: 50%; }
.empty-state { min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #737b70; font-size: 13px; }
.empty-state view { width: 54px; height: 44px; margin-bottom: 14px; display: flex; align-items: center; justify-content: center; background: #121611; color: #9dda39; font-family: Menlo, monospace; font-size: 10px; border-radius: 7px; }
.safe-space { height: calc(24px + env(safe-area-inset-bottom)); }
