@import "../../styles/orin-polish.wxss";

page {
    background: linear-gradient(180deg, #DEF1DD 0%, #f0fdf4 30%, #f5f5f5 100%);
    min-height: 100vh;
}

.container {
    padding: 0 24rpx 40rpx;
}

/* 导航栏 */
.custom-nav {
    display: flex;
    align-items: center;
    padding-bottom: 20rpx;
}

.nav-back {
    width: 60px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.back-icon {
    font-size: 28px;
    color: #1a1a1a;
    font-weight: 300;
}

.nav-title {
    flex: 1;
    font-size: 36rpx;
    font-weight: 600;
    color: #1a1a1a;
    text-align: center;
    margin-right: 60px;
}

/* 设备卡片 */
.device-card {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    border-radius: 24rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    border: 1px solid rgba(255, 255, 255, 0.9);
}

.device-header {
    display: flex;
    align-items: center;
    padding-bottom: 24rpx;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    margin-bottom: 20rpx;
}

.device-icon {
    width: 80rpx;
    height: 80rpx;
    background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    overflow: hidden;
}

.device-icon image {
    width: 100%;
    height: 100%;
}

.device-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.device-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
}

.device-code {
    font-size: 24rpx;
    color: #9ca3af;
}

.device-status {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 10rpx 20rpx;
    border-radius: 24rpx;
    font-size: 26rpx;
    font-weight: 500;
}

.device-status.online {
    background: rgba(22, 163, 74, 0.12);
    color: #16a34a;
}

.device-status.offline {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
}

.status-indicator {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
}

.device-status.online .status-indicator {
    background: #16a34a;
    box-shadow: 0 0 10rpx rgba(22, 163, 74, 0.5);
}

.device-status.offline .status-indicator {
    background: #f59e0b;
}

/* 设备所有者 */
.device-owner {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 20rpx;
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.08), rgba(22, 163, 74, 0.04));
    border-radius: 16rpx;
    margin-bottom: 24rpx;
}

.owner-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    overflow: hidden;
    background: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
}

.owner-avatar image {
    width: 100%;
    height: 100%;
}

.avatar-placeholder {
    font-size: 32rpx;
}

.owner-detail {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
}

.owner-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #374151;
}

.owner-label {
    font-size: 22rpx;
    color: #9ca3af;
}

/* 设备统计 */
.device-stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
    flex: 1;
}

.stat-label {
    font-size: 22rpx;
    color: #9ca3af;
}

.stat-value {
    font-size: 26rpx;
    font-weight: 600;
    color: #374151;
}

.stat-value.highlight {
    font-size: 30rpx;
    color: #16a34a;
}

.stat-value.time {
    font-size: 22rpx;
    font-weight: normal;
    color: #6b7280;
}

.stat-divider {
    width: 1rpx;
    height: 50rpx;
    background: #e5e7eb;
}

/* 图表卡片 */
.chart-card {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    border-radius: 24rpx;
    padding: 28rpx;
    border: 1px solid rgba(255, 255, 255, 0.9);
}

.chart-header {
    margin-bottom: 20rpx;
}

.chart-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1a1a1a;
}

.chart-container {
    height: 300rpx;
}

.earnings-chart {
    width: 100%;
    height: 100%;
}

/* 加载状态 */
.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx;
    color: #6b7280;
    font-size: 26rpx;
}

.loading-spinner {
    width: 48rpx;
    height: 48rpx;
    border: 4rpx solid #e5e7eb;
    border-top-color: #16a34a;
    border-radius: 50%;
    margin-bottom: 20rpx;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}
.avatar-placeholder { color: #548600; font-family: "DIN Alternate", Menlo, monospace; font-size: 11px; font-weight: 800; }

/* Precision Edge Console overrides. */
page { background: #eef1ed; }
.container { padding: 0 12px 40px; }
.custom-nav { margin: 0 -12px 12px; padding: 0 12px; box-sizing: content-box; background: rgba(255,255,255,.9); border-bottom: 1px solid rgba(28,33,27,.08); }
.nav-back { width: 44px; flex: 0 0 44px; }
.nav-title { margin-right: 44px; color: #1c211b; font-size: 18px; font-weight: 700; }
.device-card { padding: 0; overflow: hidden; background: #fff !important; border: 1px solid rgba(28,33,27,.075) !important; border-radius: 8px !important; box-shadow: none !important; backdrop-filter: none; -webkit-backdrop-filter: none; }
.device-header { position: relative; min-height: 96px; margin: 0; padding: 18px; box-sizing: border-box; background: #121611; border-bottom: 0; }
.device-header::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }
.device-icon { width: 58px; height: 58px; margin-right: 13px; background: #e7e9e6; border-radius: 7px; }
.device-name { color: #f7f9f5; font-size: 17px; }
.device-code { margin-top: 5px; color: #9ba39a; font-family: "DIN Alternate", Menlo, monospace; font-size: 11px; }
.device-status { min-height: 28px; padding: 0 8px; font-size: 11px; border-radius: 5px; }
.device-status.online { background: rgba(118,185,0,.13); color: #9dda39; }
.device-status.online .status-indicator { background: #76b900; box-shadow: none; }
.device-status.offline { background: rgba(198,90,82,.12); color: #dfa19b; }
.device-status.offline .status-indicator { background: #c65a52; }
.device-owner { min-height: 62px; margin: 14px; padding: 10px 12px; box-sizing: border-box; background: #f3f6f1; border: 1px solid rgba(28,33,27,.06); border-radius: 7px; }
.owner-avatar { width: 40px; height: 40px; background: rgba(118,185,0,.12); }
.owner-name { color: #343a32; font-size: 13px; }
.owner-label { margin-top: 4px; font-size: 10px; }
.device-stats { margin: 0 14px 16px; padding-top: 14px; border-top: 1px solid rgba(28,33,27,.065); }
.stat-label { font-size: 10px; }
.stat-value { color: #343a32; font-family: "DIN Alternate", Menlo, monospace; font-size: 13px; }
.stat-value.time { font-size: 11px; }
.stat-divider { background: rgba(28,33,27,.08); }
