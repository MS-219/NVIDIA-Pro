@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed;
    color: #1c211b;
}

.container {
    box-sizing: border-box;
    padding-bottom: 42px;
}

.custom-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8px;
    background: rgba(238, 241, 237, .94) !important;
    border-bottom: 1px solid rgba(28, 33, 27, .08);
}

.nav-back {
    position: absolute;
    bottom: 4px;
    left: 10px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent !important;
    border: 0 !important;
}

.back-icon {
    color: #2c332b;
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
}

.nav-title {
    color: #20261f !important;
    font-size: 17px;
    font-weight: 700 !important;
}

.hero-card {
    position: relative;
    box-sizing: border-box;
    min-height: 138px;
    display: flex;
    align-items: center;
    gap: 14px;
    overflow: hidden;
    margin: 14px 18px 16px;
    padding: 23px 21px;
    background: #151a14 !important;
    border: 1px solid rgba(118, 185, 0, .26) !important;
    border-radius: 18px !important;
    box-shadow: 0 18px 44px rgba(20, 28, 17, .16) !important;
}

.hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: #76B900 !important;
}

.hero-signal {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 48px;
    border: 1px solid rgba(19, 117, 112, .55);
    border-radius: 7px;
    background: rgba(19, 117, 112, .12);
    color: #5fb5af;
}

.bank-glyph {
    position: relative;
    width: 29px;
    height: 24px;
    box-sizing: border-box;
    border-top: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
}

.bank-glyph::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 5px;
    width: 2px;
    height: 10px;
    background: currentColor;
    box-shadow: 8px 0 0 currentColor, 16px 0 0 currentColor;
}

.bank-glyph::after {
    content: '';
    position: absolute;
    top: -8px;
    left: 3px;
    border-right: 11px solid transparent;
    border-bottom: 5px solid currentColor;
    border-left: 11px solid transparent;
}

.hero-text {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.hero-kicker,
.section-kicker {
    display: block;
    margin-bottom: 5px;
    color: #8d968b;
    font-size: 10px;
    line-height: 1.2;
}

.hero-name {
    color: #f5f7f3;
    font-size: 17px;
    font-weight: 700;
}

.hero-card-no {
    margin-top: 7px;
    overflow: hidden;
    color: #c4cbc1;
    font-family: Menlo, Consolas, monospace;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hero-badge {
    position: absolute;
    top: 13px;
    right: 13px;
    min-height: 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 8px;
    border: 1px solid rgba(118, 185, 0, .3);
    border-radius: 999px;
    background: rgba(118, 185, 0, .1);
    color: #9dd63d;
    font-size: 10px;
    font-weight: 700;
}

.badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #76B900;
}

.badge-grey {
    border-color: rgba(255, 255, 255, .16);
    background: rgba(255, 255, 255, .06);
    color: #aab1a7;
}

.pending-banner {
    box-sizing: border-box;
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 18px 14px;
    padding: 12px 13px;
    background: rgba(255, 255, 255, .94) !important;
    border: 1px solid rgba(192, 138, 47, .28) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.pending-mark {
    position: relative;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border: 1px solid rgba(192, 138, 47, .38);
    border-radius: 6px;
    background: rgba(192, 138, 47, .08);
}

.pending-mark::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 10px;
    width: 18px;
    height: 18px;
    border: 2px solid #C08A2F;
    border-radius: 50%;
}

.pending-mark::after {
    content: '';
    position: absolute;
    top: 15px;
    left: 20px;
    width: 1.5px;
    height: 8px;
    background: #C08A2F;
    transform-origin: bottom center;
    transform: rotate(-35deg);
}

.pending-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.pending-title {
    color: #6f511f;
    font-size: 13px;
    font-weight: 700;
}

.pending-text {
    color: #84724f;
    font-size: 11px;
    line-height: 1.45;
}

.section {
    box-sizing: border-box;
    margin: 0 18px 14px;
    padding: 17px;
    background: rgba(255, 255, 255, .94) !important;
    border: 1px solid rgba(28, 33, 27, .08) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.payment-section {
    position: relative;
}

.contract-section {
    padding: 0;
    background: transparent !important;
    border: 0 !important;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 15px;
}

.outside-header {
    padding: 0 1px;
}

.section-mark {
    position: relative;
    width: 40px;
    height: 40px;
    box-sizing: border-box;
    flex: 0 0 40px;
    border: 1px solid rgba(19, 117, 112, .28);
    border-radius: 6px;
    background: rgba(19, 117, 112, .07);
}

.card-mark::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 8px;
    width: 22px;
    height: 16px;
    border: 2px solid #137570;
    border-radius: 3px;
}

.card-mark::after {
    content: '';
    position: absolute;
    top: 16px;
    left: 10px;
    width: 20px;
    height: 2px;
    background: #137570;
}

.shield-mark::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 10px;
    width: 16px;
    height: 20px;
    border: 2px solid #137570;
    border-radius: 8px 8px 10px 10px;
}

.shield-mark view {
    position: absolute;
    top: 14px;
    left: 17px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #137570;
    box-shadow: 0 7px 0 -1px #137570;
}

.section-title {
    display: block;
    color: #252b24;
    font-size: 16px;
    font-weight: 700;
}

.input-block {
    margin-bottom: 14px;
}

.input-label {
    display: block;
    margin-bottom: 8px;
    color: #596257;
    font-size: 13px;
    font-weight: 600;
}

.card-input {
    width: 100%;
    height: 48px;
    box-sizing: border-box;
    padding: 0 13px;
    background: #f8faf7 !important;
    border: 1px solid rgba(28, 33, 27, .12) !important;
    border-radius: 8px !important;
    color: #242a23 !important;
    font-family: Menlo, Consolas, monospace;
    font-size: 14px !important;
    font-variant-numeric: tabular-nums;
}

.input-hint {
    display: block;
    margin-top: 7px;
    color: #858d83;
    font-size: 11px;
}

.primary-btn {
    width: 100%;
    min-height: 48px;
    margin: 0 0 12px;
    padding: 0;
    font-size: 13px !important;
}

.btn-disabled {
    background: #c9cec7 !important;
    color: #6f776d !important;
}

.tips-row {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.tip-item {
    color: #7e877c;
    font-size: 11px;
    line-height: 1.45;
}

.contract-status-card {
    box-sizing: border-box;
    padding: 17px;
    background: rgba(255, 255, 255, .94);
    border: 1px solid rgba(28, 33, 27, .08);
    border-radius: 8px;
}

.card-muted {
    border-color: rgba(28, 33, 27, .06);
}

.cs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.cs-label,
.cs-value {
    display: block;
}

.cs-label {
    color: #7d857b;
    font-size: 11px;
}

.cs-value {
    margin-top: 3px;
    color: #343b33;
    font-size: 13px;
    font-weight: 700;
}

.cs-tag {
    min-height: 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.tag-green {
    background: rgba(118, 185, 0, .12);
    color: #4f7f00;
}

.tag-grey {
    background: #edf0eb;
    color: #6e766c;
}

.tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
}

.green-dot {
    background: #76B900;
}

.cs-divider {
    height: 1px;
    margin: 14px 0;
    background: rgba(28, 33, 27, .08);
}

.cs-desc {
    display: block;
    margin-bottom: 14px;
    color: #7c857a;
    font-size: 12px;
    line-height: 1.55;
}

.danger-btn {
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font-size: 13px;
}

.safe-footer {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 4px 18px 0;
    padding: 0;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
}

.lock-mark {
    position: relative;
    width: 18px;
    height: 18px;
    box-sizing: border-box;
    margin-top: 4px;
    border: 1.5px solid #137570;
    border-radius: 3px;
}

.lock-mark::before {
    content: '';
    position: absolute;
    top: -7px;
    left: 3px;
    width: 8px;
    height: 8px;
    border: 1.5px solid #137570;
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
}

.lock-mark view {
    position: absolute;
    top: 5px;
    left: 7px;
    width: 2px;
    height: 5px;
    background: #137570;
}

.safe-text {
    color: #7e877c;
    font-size: 11px;
}
