<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px;">
        <view class="nav-back" bindtap="goBack"><text class="back-icon">‹</text></view>
        <text class="nav-title">收款设置</text>
    </view>

    <view class="hero-card">
        <view class="hero-signal"><view class="bank-glyph"><view></view></view></view>
        <view class="hero-text">
            <text class="hero-kicker">PAYMENT IDENTITY</text>
            <text class="hero-name">{{currentInfo.realName || '未设置'}}</text>
            <text class="hero-card-no">{{currentInfo.bankCardNoMask || '暂无银行卡'}}</text>
        </view>
        <view class="hero-badge" wx:if="{{contractStatus === 1}}"><view class="badge-dot"></view><text>已签约</text></view>
        <view class="hero-badge badge-grey" wx:elif="{{contractStatus === 5}}"><text>已解约</text></view>
    </view>

    <view class="pending-banner" wx:if="{{hasPendingApply}}">
        <view class="pending-mark"><view></view></view>
        <view class="pending-copy">
            <text class="pending-title">变更申请审核中</text>
            <text class="pending-text">审核完成前，新的银行卡信息暂不重复提交</text>
        </view>
    </view>

    <view class="section payment-section">
        <view class="section-header">
            <view class="section-mark card-mark"><view></view></view>
            <view>
                <text class="section-kicker">PAYMENT CHANNEL</text>
                <text class="section-title">修改银行卡</text>
            </view>
        </view>
        <view class="input-block">
            <text class="input-label">新银行卡号</text>
            <input class="card-input" type="number" placeholder="请输入 15-19 位银行卡号" value="{{form.cardNo}}" bindinput="onCardNoInput" maxlength="19" />
            <text class="input-hint">银行卡持有人需与当前签约实名一致</text>
        </view>
        <button class="primary-btn {{!canSubmit ? 'btn-disabled' : ''}}" bindtap="submitChange" loading="{{submitting}}" disabled="{{!canSubmit || submitting || hasPendingApply}}">{{hasPendingApply ? '审核中暂不支持再次修改' : (submitting ? '提交中...' : '确认修改')}}</button>
        <view class="tips-row">
            <text class="tip-item">01 · 请核对开户人姓名与银行卡号</text>
            <text class="tip-item">02 · 审核通过后用于后续提现打款</text>
        </view>
    </view>

    <view class="section contract-section" wx:if="{{contractStatus === 1 || contractStatus === 5}}">
        <view class="section-header outside-header">
            <view class="section-mark shield-mark"><view></view></view>
            <view>
                <text class="section-kicker">CONTRACT CONTROL</text>
                <text class="section-title">签约管理</text>
            </view>
        </view>
        <view class="contract-status-card" wx:if="{{contractStatus === 1}}">
            <view class="cs-row">
                <view>
                    <text class="cs-label">当前状态</text>
                    <text class="cs-value">劳务服务协议有效</text>
                </view>
                <view class="cs-tag tag-green"><view class="tag-dot green-dot"></view><text>已签约</text></view>
            </view>
            <view class="cs-divider"></view>
            <text class="cs-desc">解除后提现通道将暂停，如需再次使用需重新完成签约。</text>
            <button class="danger-btn" bindtap="cancelContract" loading="{{cancelling}}" disabled="{{cancelling}}">{{cancelling ? '解约中...' : '解除签约'}}</button>
        </view>
        <view class="contract-status-card card-muted" wx:elif="{{contractStatus === 5}}">
            <view class="cs-row">
                <view>
                    <text class="cs-label">当前状态</text>
                    <text class="cs-value">提现签约已失效</text>
                </view>
                <view class="cs-tag tag-grey"><text>已解约</text></view>
            </view>
            <view class="cs-divider"></view>
            <text class="cs-desc">前往提现页面可重新发起实名签约。</text>
        </view>
    </view>

    <view class="safe-footer">
        <view class="lock-mark"><view></view></view>
        <text class="safe-text">收款信息加密传输，仅用于结算核验</text>
    </view>
</view>
