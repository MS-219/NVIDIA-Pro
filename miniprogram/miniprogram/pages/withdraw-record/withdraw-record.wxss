@import "../../styles/orin-polish.wxss";

page {
    background: #eef1ed;
    min-height: 100vh;
}

.container {
    padding: 0 20px 20px 20px;
}

.custom-nav {
    display: flex;
    align-items: center;
    padding-bottom: 10px;
    background: #fff;
    margin: 0 -20px;
    padding-left: 20px;
    padding-right: 20px;
}

.nav-back {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.back-icon {
    font-size: 24px;
    color: #1a1a1a;
    font-weight: 300;
}

.nav-title {
    flex: 1;
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: center;
    margin-right: 44px;
}

/* Record List */
.record-list {
    margin-top: 16px;
}

.record-item {
    background: #fff;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.record-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.record-type {
    display: flex;
    align-items: center;
    gap: 8px;
}

.type-icon {
    font-size: 20px;
}

.type-name {
    font-size: 15px;
    font-weight: 500;
    color: #1a1a1a;
}

.record-time {
    font-size: 12px;
    color: #9ca3af;
}

.record-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
}

.record-amount {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
}

.record-status {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
}

.record-status.pending {
    background: #fef3c7;
    color: #d97706;
}

.record-status.approved {
    background: #dbeafe;
    color: #2563eb;
}

.record-status.rejected {
    background: #fee2e2;
    color: #dc2626;
}

/* Loaded by ReplaceFileContent tool */
.record-status.paid {
    background: #d1fae5;
    color: #059669;
}

.record-status.processing {
    background: #f3e8ff;
    color: #7c3aed;
}

.record-status.confirming {
    background: #ffedd5;
    color: #c2410c;
}

.record-status.failed {
    background: #fef2f2;
    color: #991b1b;
}

.fail-reason {
    grid-column: 1 / -1;
    font-size: 11px;
    color: #a7524a;
    margin-top: 10px;
    padding: 9px 10px;
    background: rgba(198, 90, 82, .08);
    border-radius: 5px;
    text-align: left;
    line-height: 17px;
}

/* Empty State */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 0;
}

.empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
}

.empty-text {
    font-size: 14px;
    color: #9ca3af;
}

/* Load More */
.load-more {
    text-align: center;
    padding: 20px;
    font-size: 14px;
    color: #6b7280;
}

.type-code {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(19, 117, 112, .11);
    border: 1px solid rgba(19, 117, 112, .18);
    border-radius: 7px;
    color: #137570;
    font-family: "DIN Alternate", Menlo, monospace;
    font-size: 11px;
    font-weight: 800;
}

.type-code.type-1 { background: rgba(118, 185, 0, .12); color: #548600; }
.type-code.type-2 { background: rgba(192, 138, 47, .12); color: #94671c; }
.empty-icon { width: 52px; height: 52px; padding: 14px; box-sizing: border-box; background: rgba(90, 128, 145, .11); border-radius: 8px; }
.load-more { min-height: 44px; box-sizing: border-box; }
.legacy-loading { min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #737b70; font-size: 12px; }
.legacy-loading view { width: 86px; height: 3px; margin-bottom: 16px; background: #76b900; animation: legacy-pulse 1.1s ease-in-out infinite; }

@keyframes legacy-pulse {
    0%, 100% { opacity: .35; transform: scaleX(.55); }
    50% { opacity: 1; transform: scaleX(1); }
}
