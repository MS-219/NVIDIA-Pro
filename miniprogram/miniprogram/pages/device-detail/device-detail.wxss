page { background: #eef1ed; color: #1c211b; }.detail-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #eef1ed; }
.detail-nav { box-sizing: content-box; flex: 0 0 auto; padding: 0 98px 0 10px; display: flex; align-items: center; background: rgba(255,255,255,.8); border-bottom: 1px solid rgba(28,33,27,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.detail-nav > text { margin-left: 7px; color: #1c211b; font-size: 17px; font-weight: 700; }.back-control { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #626a60; font-size: 28px; }.detail-scroll { flex: 1; min-height: 0; }
.device-hero { position: relative; height: 205px; margin: 10px 12px 0; overflow: hidden; background: #121611; border: 1px solid rgba(0,0,0,.12); border-radius: 8px; }.device-hero::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }.hero-info { position: relative; z-index: 2; width: 57%; padding: 22px 0 0 18px; }.hero-info > text { display: block; }.hero-info > text:first-child { max-width: 205px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-size: 19px; font-weight: 700; }.hero-info > text:nth-child(2) { max-width: 190px; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #899185; font-size: 9px; }.hero-status { width: fit-content; margin-top: 15px; padding: 6px 8px; display: flex; align-items: center; background: rgba(255,255,255,.075); color: #9ba398; font-size: 9px; border: 1px solid rgba(255,255,255,.08); border-radius: 5px; }.hero-status > view { width: 6px; height: 6px; margin-right: 6px; background: #899185; border-radius: 50%; }.hero-status.online { color: #9dda39; }.hero-status.online > view { background: #76b900; }.device-hero image { position: absolute; right: -31px; bottom: -10px; width: 198px; height: 198px; border-radius: 8px; opacity: .94; }
.metric-card,.info-card,.chart-card,.unbind-card { background: rgba(255,255,255,.72); border: 1px solid rgba(255,255,255,.84); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.metric-card { min-height: 75px; margin: 10px 12px 0; display: grid; grid-template-columns: repeat(3,1fr); border-radius: 8px; }.metric-card > view { min-width: 0; padding: 15px; border-right: 1px solid rgba(28,33,27,.08); }.metric-card > view:last-child { border-right: 0; }.metric-card text { display: block; }.metric-card text:first-child { color: #7d8579; font-size: 8px; }.metric-card text:last-child { margin-top: 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #1c211b; font-size: 14px; font-weight: 700; }.metric-card .earning { color: #548600; }
.section-head { height: 55px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head text:first-child { color: #1c211b; font-size: 16px; font-weight: 700; }.section-head text:last-child { color: #7d8579; font-size: 8px; }.info-card { margin: 0 12px; overflow: hidden; border-radius: 8px; }.info-card > view { min-height: 46px; padding: 0 14px; display: grid; grid-template-columns: 82px minmax(0,1fr); align-items: center; border-bottom: 1px solid rgba(28,33,27,.07); font-size: 10px; }.info-card > view:last-child { border-bottom: 0; }.info-card text:first-child { color: #7d8579; }.info-card text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #343a32; text-align: right; }
.chart-card { position: relative; height: 225px; margin: 0 12px; border-radius: 8px; }.chart-canvas { width: 100%; height: 220px; }.chart-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #7d8579; font-size: 10px; }.unbind-card { min-height: 72px; margin: 14px 12px 0; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; border-radius: 8px; }.unbind-card text { display: block; }.unbind-card text:first-child { color: #1c211b; font-size: 12px; font-weight: 650; }.unbind-card text:last-child { margin-top: 5px; color: #7d8579; font-size: 8px; }.unbind-card button { width: 68px; height: 31px; margin: 0; padding: 0; line-height: 31px; background: rgba(224,89,76,.08); border: 1px solid rgba(198,92,82,.34); color: #a7524a; font-size: 9px; border-radius: 5px; }.detail-safe-space { height: calc(25px + env(safe-area-inset-bottom)); }
