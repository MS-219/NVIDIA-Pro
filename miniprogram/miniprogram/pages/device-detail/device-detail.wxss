page { background: #f5f6f4; color: #1d211c; }.detail-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.detail-nav { box-sizing: content-box; flex: 0 0 auto; padding: 0 98px 0 10px; display: flex; align-items: center; background: #fff; }.detail-nav > text { margin-left: 7px; font-size: 17px; font-weight: 700; }.back-control { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #4a5148; font-size: 28px; }.detail-scroll { flex: 1; min-height: 0; }
.device-hero { position: relative; height: 205px; margin: 10px 12px 0; overflow: hidden; background: #e8eee5; border-radius: 8px; }.hero-info { position: relative; z-index: 2; width: 57%; padding: 22px 0 0 18px; }.hero-info > text { display: block; }.hero-info > text:first-child { max-width: 205px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 19px; font-weight: 700; }.hero-info > text:nth-child(2) { max-width: 190px; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7d867a; font-size: 9px; }.hero-status { width: fit-content; margin-top: 15px; padding: 6px 8px; display: flex; align-items: center; background: rgba(255,255,255,.7); color: #7d847a; font-size: 9px; border-radius: 5px; }.hero-status > view { width: 6px; height: 6px; margin-right: 6px; background: #a4aaa1; border-radius: 50%; }.hero-status.online { color: #58820f; }.hero-status.online > view { background: #76b900; }.device-hero image { position: absolute; right: -31px; bottom: -10px; width: 198px; height: 198px; }
.metric-card { min-height: 75px; margin: 10px 12px 0; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.metric-card > view { min-width: 0; padding: 15px; border-right: 1px solid #eaede8; }.metric-card > view:last-child { border-right: 0; }.metric-card text { display: block; }.metric-card text:first-child { color: #92988f; font-size: 8px; }.metric-card text:last-child { margin-top: 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 700; }.metric-card .earning { color: #a16b18; }
.section-head { height: 55px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head text:first-child { font-size: 16px; font-weight: 700; }.section-head text:last-child { color: #92988f; font-size: 8px; }
.info-card { margin: 0 12px; overflow: hidden; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.info-card > view { min-height: 46px; padding: 0 14px; display: grid; grid-template-columns: 82px minmax(0,1fr); align-items: center; border-bottom: 1px solid #ebeee9; font-size: 10px; }.info-card > view:last-child { border-bottom: 0; }.info-card text:first-child { color: #8d938a; }.info-card text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #3b403a; text-align: right; }
.chart-card { position: relative; height: 225px; margin: 0 12px; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.chart-canvas { width: 100%; height: 220px; }.chart-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #989e95; font-size: 10px; }
.unbind-card { min-height: 72px; margin: 14px 12px 0; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.unbind-card text { display: block; }.unbind-card text:first-child { font-size: 12px; font-weight: 650; }.unbind-card text:last-child { margin-top: 5px; color: #989e95; font-size: 8px; }.unbind-card button { width: 68px; height: 31px; margin: 0; padding: 0; line-height: 31px; background: #fff7f6; border: 1px solid #dca49e; color: #a65c54; font-size: 9px; border-radius: 5px; }.detail-safe-space { height: calc(25px + env(safe-area-inset-bottom)); }
