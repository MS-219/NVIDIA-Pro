page { background: #080a08; color: #f5f7f3; }.detail-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #080a08; }
.detail-nav { box-sizing: content-box; flex: 0 0 auto; padding: 0 98px 0 10px; display: flex; align-items: center; background: rgba(8,10,8,.82); border-bottom: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.detail-nav > text { margin-left: 7px; color: #fff; font-size: 17px; font-weight: 700; }.back-control { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #b2baaf; font-size: 28px; }.detail-scroll { flex: 1; min-height: 0; }
.device-hero { position: relative; height: 205px; margin: 10px 12px 0; overflow: hidden; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.device-hero::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }.hero-info { position: relative; z-index: 2; width: 57%; padding: 22px 0 0 18px; }.hero-info > text { display: block; }.hero-info > text:first-child { max-width: 205px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-size: 19px; font-weight: 700; }.hero-info > text:nth-child(2) { max-width: 190px; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7f887b; font-size: 9px; }.hero-status { width: fit-content; margin-top: 15px; padding: 6px 8px; display: flex; align-items: center; background: rgba(255,255,255,.075); color: #959e91; font-size: 9px; border: 1px solid rgba(255,255,255,.08); border-radius: 5px; }.hero-status > view { width: 6px; height: 6px; margin-right: 6px; background: #899185; border-radius: 50%; }.hero-status.online { color: #9dda39; }.hero-status.online > view { background: #76b900; }.device-hero image { position: absolute; right: -31px; bottom: -10px; width: 198px; height: 198px; border-radius: 8px; opacity: .92; }
.metric-card { min-height: 75px; margin: 10px 12px 0; display: grid; grid-template-columns: repeat(3,1fr); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.metric-card > view { min-width: 0; padding: 15px; border-right: 1px solid rgba(255,255,255,.09); }.metric-card > view:last-child { border-right: 0; }.metric-card text { display: block; }.metric-card text:first-child { color: #818a7d; font-size: 8px; }.metric-card text:last-child { margin-top: 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #f5f7f3; font-size: 14px; font-weight: 700; }.metric-card .earning { color: #8dd214; }
.section-head { height: 55px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head text:first-child { color: #f5f7f3; font-size: 16px; font-weight: 700; }.section-head text:last-child { color: #818a7d; font-size: 8px; }
.info-card { margin: 0 12px; overflow: hidden; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.info-card > view { min-height: 46px; padding: 0 14px; display: grid; grid-template-columns: 82px minmax(0,1fr); align-items: center; border-bottom: 1px solid rgba(255,255,255,.08); font-size: 10px; }.info-card > view:last-child { border-bottom: 0; }.info-card text:first-child { color: #818a7d; }.info-card text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #dfe3dc; text-align: right; }
.chart-card { position: relative; height: 225px; margin: 0 12px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.chart-canvas { width: 100%; height: 220px; }.chart-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #818a7d; font-size: 10px; }
.unbind-card { min-height: 72px; margin: 14px 12px 0; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.1); border-radius: 8px; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }.unbind-card text { display: block; }.unbind-card text:first-child { color: #f5f7f3; font-size: 12px; font-weight: 650; }.unbind-card text:last-child { margin-top: 5px; color: #818a7d; font-size: 8px; }.unbind-card button { width: 68px; height: 31px; margin: 0; padding: 0; line-height: 31px; background: rgba(224,89,76,.1); border: 1px solid rgba(234,121,110,.48); color: #f09187; font-size: 9px; border-radius: 5px; }.detail-safe-space { height: calc(25px + env(safe-area-inset-bottom)); }
