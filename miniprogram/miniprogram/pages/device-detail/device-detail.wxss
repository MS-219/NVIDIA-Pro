@import "../../styles/orin-polish.wxss";

page {
  background: #eef1ed;
  color: #1d221c;
}

view,
text,
button {
  box-sizing: border-box;
  letter-spacing: 0;
}

.detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #eef1ed;
}

.detail-nav {
  box-sizing: content-box;
  flex: 0 0 auto;
  padding-right: 98px;
  display: flex;
  align-items: center;
  background: rgba(248, 250, 247, .92);
  border-bottom: 1px solid rgba(29, 34, 28, .09);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.nav-back {
  width: 44px;
  min-width: 44px;
  height: 44px;
  margin-left: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-chevron {
  width: 10px;
  height: 10px;
  border-left: 2px solid #31382f;
  border-bottom: 2px solid #31382f;
  transform: rotate(45deg);
}

.nav-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nav-heading text:first-child {
  color: #1c211b;
  font-size: 17px;
  font-weight: 700;
  line-height: 20px;
}

.nav-heading text:last-child {
  margin-top: 1px;
  color: #858d82;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
  line-height: 11px;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
}

.page-loading,
.ready-content {
  padding-top: 10px;
}

.skeleton {
  overflow: hidden;
  background: #dde2dc;
  border: 1px solid rgba(29, 34, 28, .05);
  border-radius: 8px;
  animation: skeleton-pulse 1.35s ease-in-out infinite;
}

.hero-skeleton {
  height: 208px;
  margin: 0 12px;
  background: #20251f;
}

.summary-skeleton {
  height: 80px;
  margin: 10px 12px 0;
}

.loading-label {
  height: 55px;
  padding: 0 16px 8px;
  display: flex;
  align-items: flex-end;
  color: #687066;
  font-size: 12px;
}

.loading-pulse {
  width: 7px;
  height: 7px;
  margin: 0 8px 3px 0;
  background: #76b900;
  border-radius: 50%;
  animation: status-pulse 1.2s ease-out infinite;
}

.skeleton-grid {
  margin: 0 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  overflow: hidden;
  background: rgba(29, 34, 28, .08);
  border: 1px solid rgba(29, 34, 28, .08);
  border-radius: 8px;
}

.skeleton-grid .skeleton {
  height: 105px;
  border: 0;
  border-radius: 0;
}

.page-error {
  min-height: 62vh;
  padding: 64px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.error-mark {
  position: relative;
  width: 52px;
  height: 52px;
  margin-bottom: 20px;
  border: 1px solid rgba(185, 69, 61, .28);
  border-radius: 8px;
  background: rgba(185, 69, 61, .06);
}

.error-mark view {
  position: absolute;
  left: 16px;
  top: 24px;
  width: 20px;
  height: 2px;
  background: #b3453e;
}

.error-mark view:first-child {
  transform: rotate(45deg);
}

.error-mark view:last-child {
  transform: rotate(-45deg);
}

.error-title {
  color: #242a22;
  font-size: 18px;
  font-weight: 700;
}

.error-message {
  max-width: 280px;
  margin-top: 8px;
  color: #747d71;
  font-size: 13px;
  line-height: 20px;
}

.state-action {
  min-width: 116px;
  height: 44px;
  margin: 22px 0 0;
  padding: 0 20px;
  line-height: 44px;
  background: #171c16;
  border-radius: 6px;
  color: #ffffff;
  font-size: 13px;
  font-weight: 650;
}

.state-action::after,
.identity-action::after,
.danger-action::after,
.chart-state button::after {
  border: 0;
}

.node-hero {
  position: relative;
  height: 208px;
  margin: 0 12px;
  overflow: hidden;
  background: #111510;
  border: 1px solid rgba(0, 0, 0, .18);
  border-radius: 8px;
}

.node-hero::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 3;
  width: 4px;
  background: #76b900;
}

.hero-grid {
  position: absolute;
  inset: 0;
  opacity: .32;
  background-image:
    linear-gradient(rgba(255, 255, 255, .055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, .055) 1px, transparent 1px);
  background-size: 32px 32px;
  mask-image: linear-gradient(90deg, #000 0%, transparent 78%);
  -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 78%);
}

.hero-copy {
  position: relative;
  z-index: 4;
  width: 63%;
  padding: 20px 0 0 19px;
}

.hero-kicker {
  display: flex;
  align-items: center;
  color: #99a293;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
  line-height: 12px;
}

.hero-kicker view {
  width: 14px;
  height: 2px;
  margin-right: 7px;
  background: #76b900;
}

.hero-title {
  max-width: 200px;
  margin-top: 10px;
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 20px;
  font-weight: 720;
  line-height: 25px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-line {
  min-height: 44px;
  margin-top: 8px;
  display: flex;
  align-items: center;
}

.identity-text {
  min-width: 0;
  flex: 1;
}

.identity-text text {
  display: block;
}

.identity-text text:first-child {
  color: #6f796c;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
}

.identity-text text:last-child {
  max-width: 145px;
  margin-top: 3px;
  overflow: hidden;
  color: #b1b9ad;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-action {
  width: 48px;
  min-width: 48px;
  height: 44px;
  margin: 0;
  padding: 0;
  line-height: 44px;
  background: transparent;
  color: #9dda39;
  font-size: 11px;
}

.identity-action[disabled] {
  color: #687066;
  opacity: .55;
}

.node-status {
  width: fit-content;
  max-width: 205px;
  margin-top: 9px;
  display: flex;
  align-items: center;
}

.status-light {
  width: 18px;
  height: 18px;
  margin-right: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 4px;
}

.status-light > view {
  width: 6px;
  height: 6px;
  background: #7f887c;
  border-radius: 50%;
}

.node-status > view:last-child text {
  display: block;
}

.node-status > view:last-child text:first-child {
  color: #d2d7cf;
  font-size: 11px;
  font-weight: 650;
  line-height: 14px;
}

.node-status > view:last-child text:last-child {
  max-width: 170px;
  margin-top: 2px;
  overflow: hidden;
  color: #747e71;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 10px;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-status.status-online .status-light {
  border-color: rgba(118, 185, 0, .32);
  background: rgba(118, 185, 0, .08);
}

.node-status.status-online .status-light > view {
  background: #76b900;
  box-shadow: 0 0 0 4px rgba(118, 185, 0, .10);
  animation: status-pulse 1.8s ease-out infinite;
}

.node-status.status-offline .status-light > view {
  background: #c9524a;
}

.hero-product {
  position: absolute;
  right: -31px;
  bottom: -13px;
  z-index: 2;
  width: 203px;
  height: 203px;
  opacity: .95;
}

.node-summary {
  min-height: 80px;
  margin: 10px 12px 0;
  display: grid;
  grid-template-columns: 1.05fr .82fr 1.13fr;
  overflow: hidden;
  background: rgba(255, 255, 255, .86);
  border: 1px solid rgba(29, 34, 28, .08);
  border-radius: 8px;
}

.summary-cell {
  min-width: 0;
  padding: 15px 12px;
  border-right: 1px solid rgba(29, 34, 28, .08);
}

.summary-cell:last-child {
  border-right: 0;
}

.summary-cell > text:first-child {
  display: block;
  color: #7a8377;
  font-size: 11px;
  line-height: 14px;
}

.summary-cell > view,
.summary-cell > .summary-value {
  margin-top: 8px;
}

.summary-cell > .summary-value {
  display: block;
}

.summary-value,
.summary-prefix {
  color: #20261f;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 17px;
  font-weight: 700;
  line-height: 20px;
}

.summary-prefix {
  margin-right: 2px;
  font-size: 11px;
}

.summary-value.accent {
  color: #568a00;
}

.summary-status {
  display: flex;
  align-items: center;
  color: #4f584d;
  font-size: 11px;
  font-weight: 650;
  white-space: nowrap;
}

.summary-status > view {
  width: 6px;
  height: 6px;
  margin-right: 6px;
  background: #858e82;
  border-radius: 50%;
}

.summary-status.status-online {
  color: #4d7b00;
}

.summary-status.status-online > view {
  background: #76b900;
}

.summary-status.status-offline {
  color: #a34d47;
}

.summary-status.status-offline > view {
  background: #c9524a;
}

.section-heading {
  min-height: 63px;
  padding: 17px 16px 9px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-heading > view:first-child {
  min-width: 0;
}

.section-heading > view:first-child text {
  display: block;
}

.section-heading > view:first-child text:first-child {
  color: #20261f;
  font-size: 16px;
  font-weight: 720;
  line-height: 20px;
}

.section-heading > view:first-child text:last-child {
  margin-top: 2px;
  color: #879083;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
  line-height: 10px;
}

.section-heading > text:last-child {
  padding-bottom: 2px;
  color: #7b8478;
  font-size: 11px;
}

.telemetry-board {
  margin: 0 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  background: rgba(255, 255, 255, .9);
  border: 1px solid rgba(29, 34, 28, .09);
  border-radius: 8px;
}

.telemetry-cell {
  position: relative;
  min-width: 0;
  height: 108px;
  padding: 14px;
  border-right: 1px solid rgba(29, 34, 28, .08);
  border-bottom: 1px solid rgba(29, 34, 28, .08);
}

.telemetry-cell:nth-child(2n) {
  border-right: 0;
}

.telemetry-cell:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.telemetry-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14px;
  width: 2px;
  height: 18px;
  background: #76b900;
}

.telemetry-cell.tone-memory::before,
.telemetry-cell.tone-sync::before {
  background: #16847e;
}

.telemetry-cell.tone-thermal::before {
  background: #c08a2f;
}

.telemetry-cell.tone-power::before {
  background: #647064;
}

.telemetry-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.telemetry-top text:first-child {
  color: #697267;
  font-size: 11px;
  line-height: 14px;
}

.telemetry-top text:last-child {
  color: #a1a89e;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
}

.telemetry-reading {
  min-width: 0;
  height: 35px;
  margin-top: 8px;
  display: flex;
  align-items: baseline;
}

.telemetry-reading text:first-child {
  overflow: hidden;
  color: #1d231c;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 23px;
  font-weight: 700;
  line-height: 30px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.telemetry-reading text:last-child {
  margin-left: 4px;
  color: #737c70;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 10px;
}

.telemetry-reading.compact text:first-child {
  width: 100%;
  font-size: 12px;
  font-weight: 650;
}

.metric-track,
.metric-baseline {
  position: relative;
  width: 100%;
  height: 3px;
  margin-top: 7px;
  overflow: hidden;
  background: #e1e5df;
}

.metric-track > view {
  height: 100%;
  background: #76b900;
  transition: width .28s ease;
}

.tone-memory .metric-track > view {
  background: #16847e;
}

.tone-gpu .metric-track > view {
  background: #4f8500;
}

.metric-baseline {
  background: transparent;
}

.metric-baseline > view {
  width: 16px;
  height: 1px;
  margin-top: 1px;
  background: #c6ccc3;
}

.stack-heading {
  min-height: 65px;
}

.software-panel {
  margin: 0 12px;
  padding: 5px 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 0 8px;
  background: #151a14;
  border: 1px solid rgba(0, 0, 0, .16);
  border-radius: 8px;
}

.software-tag {
  min-width: calc(50% - 4px);
  max-width: calc(50% - 4px);
  height: 48px;
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, .07);
}

.software-tag:nth-last-child(-n + 2) {
  border-bottom-color: transparent;
}

.software-tag text:first-child {
  color: #7d8879;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 9px;
}

.software-tag text:last-child {
  min-width: 0;
  overflow: hidden;
  color: #d6dcd2;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 11px;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-panel {
  margin: 0 12px;
  overflow: hidden;
  background: rgba(255, 255, 255, .88);
  border: 1px solid rgba(29, 34, 28, .08);
  border-radius: 8px;
}

.identity-panel > view {
  min-height: 48px;
  padding: 0 14px;
  display: grid;
  grid-template-columns: 82px minmax(0, 1fr);
  align-items: center;
  border-bottom: 1px solid rgba(29, 34, 28, .07);
}

.identity-panel > view:last-child {
  border-bottom: 0;
}

.identity-panel text:first-child {
  color: #737c70;
  font-size: 12px;
}

.identity-panel text:last-child {
  min-width: 0;
  overflow: hidden;
  color: #2b3229;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 12px;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-heading {
  min-height: 70px;
}

.chart-total {
  padding-bottom: 1px;
  text-align: right;
}

.chart-total text {
  display: block;
}

.chart-total text:first-child {
  color: #7a8377;
  font-size: 11px;
}

.chart-total text:last-child {
  margin-top: 2px;
  color: #518300;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 15px;
  font-weight: 700;
}

.earnings-panel {
  min-height: 286px;
  margin: 0 12px;
  overflow: hidden;
  background: rgba(255, 255, 255, .9);
  border: 1px solid rgba(29, 34, 28, .08);
  border-radius: 8px;
}

.chart-meta {
  height: 65px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-bottom: 1px solid rgba(29, 34, 28, .07);
}

.chart-meta > view {
  min-width: 0;
  padding: 11px 12px;
  border-right: 1px solid rgba(29, 34, 28, .07);
}

.chart-meta > view:last-child {
  border-right: 0;
}

.chart-meta text {
  display: block;
}

.chart-meta text:first-child {
  color: #7b8478;
  font-size: 11px;
  line-height: 13px;
}

.chart-meta text:last-child {
  margin-top: 5px;
  overflow: hidden;
  color: #252b23;
  font-family: "DIN Alternate", "SFMono-Regular", monospace;
  font-size: 13px;
  font-weight: 700;
  line-height: 17px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.earnings-canvas {
  width: 100%;
  height: 220px;
}

.chart-loading,
.chart-state {
  height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #747d71;
  font-size: 12px;
}

.chart-loading-line {
  position: relative;
  width: 88px;
  height: 3px;
  margin-bottom: 14px;
  overflow: hidden;
  background: #dde2dc;
}

.chart-loading-line::after {
  content: '';
  position: absolute;
  top: 0;
  width: 34px;
  height: 3px;
  background: #76b900;
  animation: chart-loading 1.1s ease-in-out infinite;
}

.chart-state button {
  min-width: 88px;
  height: 44px;
  margin: 14px 0 0;
  padding: 0 18px;
  line-height: 44px;
  background: #e7eee3;
  border-radius: 5px;
  color: #466f00;
  font-size: 12px;
}

.danger-zone {
  min-height: 88px;
  margin: 14px 12px 0;
  padding: 12px 12px 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, .74);
  border: 1px solid rgba(185, 69, 61, .16);
  border-radius: 8px;
}

.danger-copy {
  min-width: 0;
  padding-right: 12px;
}

.danger-copy text {
  display: block;
}

.danger-copy text:first-child {
  color: #372724;
  font-size: 13px;
  font-weight: 700;
  line-height: 17px;
}

.danger-copy text:last-child {
  max-width: 205px;
  margin-top: 5px;
  color: #81736f;
  font-size: 11px;
  line-height: 15px;
}

.danger-action {
  width: 88px;
  min-width: 88px;
  height: 44px;
  margin: 0;
  padding: 0;
  line-height: 44px;
  background: rgba(185, 69, 61, .07);
  border: 1px solid rgba(185, 69, 61, .28);
  border-radius: 5px;
  color: #a7423b;
  font-size: 12px;
  font-weight: 650;
}

.danger-action[disabled] {
  opacity: .58;
}

.detail-safe-space {
  height: calc(28px + env(safe-area-inset-bottom));
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: .62; }
  50% { opacity: 1; }
}

@keyframes status-pulse {
  0% { box-shadow: 0 0 0 0 rgba(118, 185, 0, .24); }
  75%, 100% { box-shadow: 0 0 0 7px rgba(118, 185, 0, 0); }
}

@keyframes chart-loading {
  0% { left: -34px; }
  100% { left: 88px; }
}

@media (max-width: 340px) {
  .hero-copy {
    width: 68%;
  }

  .hero-product {
    right: -49px;
  }

  .summary-cell {
    padding-left: 9px;
    padding-right: 9px;
  }

  .summary-value {
    font-size: 15px;
  }

  .telemetry-cell {
    padding-left: 11px;
    padding-right: 11px;
  }

  .software-panel {
    gap: 0 6px;
  }

  .software-tag {
    min-width: calc(50% - 3px);
    max-width: calc(50% - 3px);
    grid-template-columns: 42px minmax(0, 1fr);
  }
}
