@import "../../styles/orin-polish.wxss";

page { background: #eef1ed; color: #1c211b; }.page-scroll { height: 100vh; }.home-page { min-height: 100%; background: #eef1ed; }
.home-nav { box-sizing: content-box; padding: 0 98px 0 18px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.8); border-bottom: 1px solid rgba(28,33,27,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.brand { min-width: 0; display: flex; align-items: center; }.brand-logo { width: 142px; height: 29px; display: block; }.service-state { display: flex; align-items: center; color: #70786d; font-size: 9px; white-space: nowrap; }.service-state view { width: 6px; height: 6px; margin-right: 5px; background: #76b900; border-radius: 50%; }
.hero { position: relative; height: 228px; margin: 10px 12px 0; overflow: hidden; background: #121611; border: 1px solid rgba(0,0,0,.12); border-radius: 8px; }.hero::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }.hero-copy { position: relative; z-index: 2; width: 59%; padding: 25px 0 0 20px; }.hero-eyebrow { display: block; color: #8dd214; font-size: 10px; font-weight: 650; }.hero-title { display: block; margin-top: 9px; color: #fff; font-size: 23px; line-height: 29px; font-weight: 760; }.hero-title-second { margin-top: 0; }.hero-action { margin-top: 19px; display: flex; align-items: center; }.hero-action navigator { height: 32px; padding: 0 13px; display: flex; align-items: center; background: #76b900; color: #080a08; font-size: 11px; font-weight: 750; border-radius: 5px; }.hero-action > text { margin-left: 10px; color: #90988c; font-size: 9px; }.hero-product { position: absolute; right: -35px; bottom: -10px; width: 202px; height: 202px; border-radius: 8px; opacity: .94; }
.overview-card,.notice-swiper,.news-list,.service-grid > navigator,.service-grid > view { background: rgba(255,255,255,.7); border: 1px solid rgba(255,255,255,.82); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.overview-card { margin: 10px 12px 0; padding: 15px 14px 13px; border-radius: 8px; }.overview-title { display: flex; align-items: center; justify-content: space-between; }.overview-title text:first-child { color: #1c211b; font-size: 14px; font-weight: 650; }.overview-title text:last-child { color: #858d81; font-size: 9px; }.overview-grid { margin-top: 14px; display: grid; grid-template-columns: repeat(3,1fr); }.overview-grid > view { padding-left: 12px; border-right: 1px solid rgba(28,33,27,.08); }.overview-grid > view:first-child { padding-left: 0; }.overview-grid > view:last-child { border-right: 0; }.overview-grid text { display: block; }.overview-grid > view > text:first-child { color: #1c211b; font-size: 22px; font-weight: 700; }.metric-label { margin-top: 4px; display: flex; align-items: center; color: #7d8579; font-size: 9px; }.dot { width: 5px; height: 5px; margin-right: 5px; background: #858d81; border-radius: 50%; }.dot.online { background: #76b900; }.dot.offline { background: #df7469; }.dot.partner { background: #2faaa1; }
.section-head { height: 54px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head > text { color: #1c211b; font-size: 17px; font-weight: 700; }.section-head navigator { color: #548600; font-size: 10px; }
.income-card { min-height: 126px; margin: 0 12px; display: grid; grid-template-columns: 1.18fr .82fr; overflow: hidden; background: rgba(255,255,255,.72); border: 1px solid rgba(255,255,255,.84); border-radius: 8px; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.income-primary { padding: 19px; background: #76b900; color: #080a08; }.income-primary > text:first-child { color: rgba(8,10,8,.65); font-size: 10px; }.income-primary > view { margin-top: 8px; display: flex; align-items: baseline; }.income-primary > view text:first-child { margin-right: 4px; font-size: 14px; }.income-primary > view text:last-child { max-width: 145px; overflow: hidden; font-size: 27px; font-weight: 800; }.income-primary > text:last-child { display: block; margin-top: 9px; color: rgba(8,10,8,.55); font-size: 8px; }.income-total { padding: 21px 15px; }.income-total > text:first-child { color: #7d8579; font-size: 9px; }.income-total > text:nth-child(2) { display: block; margin-top: 9px; color: #1c211b; font-size: 17px; font-weight: 700; }.income-line { width: 32px; height: 3px; margin-top: 23px; background: #76b900; border-radius: 2px; }
.notice-swiper { height: 62px; margin: 10px 12px 0; border-radius: 8px; }.banner-row { height: 62px; padding: 9px 11px; box-sizing: border-box; display: flex; align-items: center; }.banner-row image,.banner-fallback { flex: 0 0 auto; width: 43px; height: 43px; margin-right: 10px; border-radius: 6px; }.banner-fallback { display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.16); color: #548600; font-size: 15px; font-weight: 700; }.banner-row > view:nth-child(2),.banner-row > view:nth-child(1) + view { min-width: 0; flex: 1; }.banner-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.banner-row view text:first-child { color: #20251f; font-size: 12px; font-weight: 600; }.banner-row view text:last-child { margin-top: 4px; color: #7d8579; font-size: 9px; }.banner-arrow { color: #899185; font-size: 19px; }
.service-grid { margin: 0 12px; display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }.service-grid > navigator,.service-grid > view { min-width: 0; height: 112px; padding: 13px; box-sizing: border-box; border-radius: 8px; }.service-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; background: rgba(28,33,27,.06); color: #687066; font-size: 10px; font-weight: 800; border-radius: 6px; }.service-icon.green { background: #76b900; color: #080a08; }.service-icon.gold { color: #a66d13; font-size: 15px; }.service-icon.cyan { color: #1c817a; }.service-grid text { display: block; }.service-grid > navigator > text:nth-child(2),.service-grid > view > text:nth-child(2) { margin-top: 10px; color: #20251f; font-size: 12px; font-weight: 650; }.service-grid > navigator > text:last-child,.service-grid > view > text:last-child { margin-top: 3px; color: #858d81; font-size: 8px; }
.news-head { height: 58px; }.news-list { margin: 0 12px; overflow: hidden; border-radius: 8px; }.news-row { min-height: 65px; padding: 0 12px; display: flex; align-items: center; border-bottom: 1px solid rgba(28,33,27,.07); }.news-row:last-child { border-bottom: 0; }.news-mark { flex: 0 0 auto; width: 29px; height: 29px; margin-right: 11px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.14); color: #548600; font-size: 10px; font-weight: 700; border-radius: 6px; }.news-row > view:nth-child(2) { min-width: 0; flex: 1; }.news-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.news-row view text:first-child { color: #20251f; font-size: 12px; font-weight: 600; }.news-row view text:last-child { margin-top: 5px; color: #7d8579; font-size: 9px; }.news-row > text { margin-left: 8px; color: #899185; font-size: 19px; }.empty-news { padding: 27px; text-align: center; color: #7d8579; font-size: 10px; }.safe-space { height: calc(82px + env(safe-area-inset-bottom)); }
