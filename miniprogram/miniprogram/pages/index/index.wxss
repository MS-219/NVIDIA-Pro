@import "../../styles/orin-polish.wxss";

page { background: #eef1ed; color: #1c211b; }.page-scroll { height: 100vh; }.home-page { min-height: 100%; background: #eef1ed; }
.home-nav { box-sizing: content-box; padding: 0 98px 0 18px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.8); border-bottom: 1px solid rgba(28,33,27,.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.brand { min-width: 0; display: flex; align-items: center; }.brand-logo { width: 142px; height: 29px; display: block; }.service-state { display: flex; align-items: center; color: #70786d; font-size: 9px; white-space: nowrap; }.service-state view { width: 6px; height: 6px; margin-right: 5px; background: #76b900; border-radius: 50%; }
.hero { position: relative; height: 228px; margin: 12px 12px 0; display: grid; grid-template-columns: 60% 40%; overflow: hidden; background: #121611; border: 1px solid rgba(118,185,0,.25); border-radius: 8px; box-shadow: 0 10px 28px rgba(27,35,24,.13); }.hero::before { content: ''; position: absolute; z-index: 3; left: 0; top: 0; bottom: 0; width: 4px; background: #76b900; }.hero-copy { position: relative; z-index: 2; min-width: 0; padding: 25px 16px 0 20px; box-sizing: border-box; }.hero-eyebrow { display: block; color: #8dd214; font-size: 10px; font-weight: 650; }.hero-title { display: block; margin-top: 9px; color: #fff; font-size: 22px; line-height: 28px; font-weight: 760; }.hero-title-second { margin-top: 0; }.hero-action { margin-top: 19px; display: flex; align-items: center; gap: 8px; }.hero-action navigator { height: 32px; padding: 0 13px; display: flex; align-items: center; background: #76b900; color: #080a08; font-size: 11px; font-weight: 750; border-radius: 5px; }.hero-live { height: 28px; padding: 0 8px; display: flex; align-items: center; box-sizing: border-box; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: #aab1a7; font-size: 9px; border-radius: 6px; white-space: nowrap; }.hero-live > view { width: 5px; height: 5px; margin-right: 5px; background: #8dd214; border-radius: 50%; }.hero-media { position: relative; min-width: 0; overflow: hidden; background: #e7e9e6; }.hero-product { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; opacity: .96; }
.overview-card,.notice-swiper { background: rgba(255,255,255,.78); border: 1px solid rgba(255,255,255,.94); box-shadow: 0 7px 22px rgba(31,42,28,.065); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.news-list,.service-grid > navigator,.service-grid > view { background: rgba(255,255,255,.86); border: 1px solid rgba(255,255,255,.96); box-shadow: 0 6px 18px rgba(31,42,28,.055); }
.overview-card { margin: 11px 12px 0; padding: 16px 14px 14px; border-radius: 8px; }.overview-title { display: flex; align-items: center; justify-content: space-between; }.overview-title > view:first-child > text { display: block; }.overview-title > view:first-child > text:first-child { color: #1c211b; font-size: 14px; font-weight: 700; }.overview-title > view:first-child > text:last-child { margin-top: 3px; color: #8a9286; font-size: 9px; }.overview-badge { height: 25px; padding: 0 8px; display: flex; align-items: center; background: rgba(118,185,0,.1); border: 1px solid rgba(118,185,0,.15); color: #5f820f; font-size: 9px; border-radius: 6px; white-space: nowrap; }.overview-badge > view { width: 5px; height: 5px; margin-right: 5px; background: #76b900; border-radius: 50%; }.overview-grid { margin-top: 14px; padding-top: 14px; display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid rgba(28,33,27,.065); }.overview-metric { min-width: 0; padding-left: 12px; border-right: 1px solid rgba(28,33,27,.075); }.overview-metric:first-child { padding-left: 0; }.overview-metric:last-child { border-right: 0; }.overview-grid text { display: block; }.overview-metric > text:first-child { color: #1c211b; font-size: 22px; font-weight: 750; }.overview-metric:first-child > text:first-child { color: #548600; }.metric-label { margin-top: 5px; display: flex; align-items: center; color: #7d8579; font-size: 9px; }.dot { width: 5px; height: 5px; margin-right: 5px; background: #858d81; border-radius: 50%; }.dot.online { background: #76b900; }.dot.offline { background: #df7469; }.dot.partner { background: #2faaa1; }
.section-head { height: 50px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head > text { color: #1c211b; font-size: 16px; font-weight: 700; }.section-head navigator { color: #548600; font-size: 10px; }
.income-card { min-height: 128px; margin: 0 12px; display: grid; grid-template-columns: 1.18fr .82fr; overflow: hidden; background: rgba(255,255,255,.78); border: 1px solid rgba(255,255,255,.94); border-radius: 8px; box-shadow: 0 7px 22px rgba(31,42,28,.065); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }.income-primary { padding: 17px 18px; background: #edf6df; border-right: 1px solid rgba(118,185,0,.11); color: #213018; }.income-label { display: flex; align-items: center; color: #56741a; font-size: 9px; font-weight: 650; }.income-label > view { width: 24px; height: 24px; margin-right: 7px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.14); border-radius: 6px; }.income-label image { width: 14px; height: 14px; }.income-value { margin-top: 8px; display: flex; align-items: baseline; white-space: nowrap; }.income-value text:first-child { margin-right: 4px; color: #4d7600; font-size: 14px; }.income-value text:last-child { color: #263a17; font-size: 27px; font-weight: 800; }.income-note { display: block; margin-top: 8px; color: #7d8b71; font-size: 9px; }.income-total { min-width: 0; padding: 20px 14px; display: flex; flex-direction: column; }.income-total > text:first-child { color: #7d8579; font-size: 9px; }.income-total > text:nth-child(2) { display: block; margin-top: 9px; white-space: nowrap; color: #1c211b; font-size: 17px; font-weight: 750; }.income-line { width: 29px; height: 3px; margin-top: 16px; background: #76b900; border-radius: 2px; }.income-total > text:last-child { margin-top: 8px; color: #92998f; font-size: 9px; }
.notice-swiper { height: 62px; margin: 11px 12px 0; border-radius: 8px; }.banner-row { height: 62px; padding: 9px 11px; box-sizing: border-box; display: flex; align-items: center; }.banner-row image,.banner-fallback { flex: 0 0 auto; width: 40px; height: 40px; margin-right: 10px; border-radius: 6px; }.banner-fallback { display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.13); color: #548600; font-size: 15px; font-weight: 700; }.banner-row > view:nth-child(2),.banner-row > view:nth-child(1) + view { min-width: 0; flex: 1; }.banner-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.banner-row view text:first-child { color: #20251f; font-size: 12px; font-weight: 650; }.banner-row view text:last-child { margin-top: 4px; color: #7d8579; font-size: 9px; }
.service-grid { margin: 0 12px; display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }.service-grid > navigator,.service-grid > view { position: relative; min-width: 0; height: 116px; padding: 14px 13px 13px; box-sizing: border-box; overflow: hidden; border-radius: 8px; }.service-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 7px; }.service-icon image { width: 19px; height: 19px; }.service-icon.green { background: rgba(118,185,0,.14); }.service-icon.gold { background: rgba(197,138,43,.12); }.service-icon.cyan { background: rgba(47,151,143,.12); }.service-grid text { display: block; }.service-grid > navigator > text:nth-child(2),.service-grid > view > text:nth-child(2) { margin-top: 11px; color: #20251f; font-size: 12px; font-weight: 700; }.service-grid > navigator > text:last-child,.service-grid > view > text:last-child { margin-top: 4px; color: #858d81; font-size: 9px; }
.news-head { height: 58px; }.news-list { margin: 0 12px; overflow: hidden; border-radius: 8px; }.news-row { min-height: 65px; padding: 0 12px; display: flex; align-items: center; border-bottom: 1px solid rgba(28,33,27,.07); }.news-row:last-child { border-bottom: 0; }.news-mark { flex: 0 0 auto; width: 29px; height: 29px; margin-right: 11px; display: flex; align-items: center; justify-content: center; background: rgba(118,185,0,.14); color: #548600; font-size: 10px; font-weight: 700; border-radius: 6px; }.news-row > view:nth-child(2) { min-width: 0; flex: 1; }.news-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.news-row view text:first-child { color: #20251f; font-size: 12px; font-weight: 600; }.news-row view text:last-child { margin-top: 5px; color: #7d8579; font-size: 9px; }.news-row > text { margin-left: 8px; color: #899185; font-size: 19px; }.empty-news { padding: 27px; text-align: center; color: #7d8579; font-size: 10px; }.safe-space { height: calc(82px + env(safe-area-inset-bottom)); }
