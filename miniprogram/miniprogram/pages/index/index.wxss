page { background: #f5f6f4; color: #1d211c; }
.page-scroll { height: 100vh; }.home-page { min-height: 100%; }
.home-nav { box-sizing: content-box; padding: 0 98px 0 18px; display: flex; align-items: center; justify-content: space-between; background: #fff; }
.brand { min-width: 0; display: flex; align-items: center; }.brand-symbol { width: 30px; height: 30px; margin-right: 9px; display: flex; align-items: center; justify-content: center; background: #76b900; color: #fff; font-size: 17px; font-weight: 800; border-radius: 7px; }.brand-name,.brand-desc { display: block; }.brand-name { font-size: 16px; font-weight: 750; }.brand-desc { margin-top: 2px; color: #8c9289; font-size: 9px; }
.service-state { display: flex; align-items: center; color: #777e74; font-size: 9px; white-space: nowrap; }.service-state view { width: 6px; height: 6px; margin-right: 5px; background: #76b900; border-radius: 50%; }
.hero { position: relative; height: 224px; margin: 10px 12px 0; overflow: hidden; background: #e8eee5; border-radius: 8px; }.hero::after { content: ''; position: absolute; right: -32px; top: -50px; width: 190px; height: 190px; border: 1px solid rgba(83,105,78,.12); border-radius: 50%; }
.hero-copy { position: relative; z-index: 2; width: 60%; padding: 25px 0 0 20px; }.hero-eyebrow { display: block; color: #5d7f2b; font-size: 10px; font-weight: 600; }.hero-title { display: block; margin-top: 9px; color: #182017; font-size: 23px; line-height: 29px; font-weight: 750; }.hero-title-second { margin-top: 0; }.hero-action { margin-top: 19px; display: flex; align-items: center; }.hero-action navigator { height: 32px; padding: 0 13px; display: flex; align-items: center; background: #1e241d; color: #fff; font-size: 11px; font-weight: 600; border-radius: 5px; }.hero-action > text { margin-left: 10px; color: #71806d; font-size: 9px; }.hero-product { position: absolute; right: -37px; bottom: -13px; width: 205px; height: 205px; }
.overview-card { margin: 10px 12px 0; padding: 15px 14px 13px; background: #fff; border: 1px solid #e2e6df; border-radius: 8px; }.overview-title { display: flex; align-items: center; justify-content: space-between; }.overview-title text:first-child { font-size: 14px; font-weight: 650; }.overview-title text:last-child { color: #92988f; font-size: 9px; }.overview-grid { margin-top: 14px; display: grid; grid-template-columns: repeat(3,1fr); }.overview-grid > view { padding-left: 12px; border-right: 1px solid #ecefeb; }.overview-grid > view:first-child { padding-left: 0; }.overview-grid > view:last-child { border-right: 0; }.overview-grid text { display: block; }.overview-grid > view > text:first-child { font-size: 21px; font-weight: 700; }.metric-label { margin-top: 4px; display: flex; align-items: center; color: #8c9289; font-size: 9px; }.dot { width: 5px; height: 5px; margin-right: 5px; background: #a4aaa1; border-radius: 50%; }.dot.online { background: #76b900; }.dot.offline { background: #d08379; }.dot.partner { background: #3ba09b; }
.section-head { height: 53px; padding: 0 16px 9px; box-sizing: border-box; display: flex; align-items: flex-end; justify-content: space-between; }.section-head > text { font-size: 17px; font-weight: 700; }.section-head navigator { color: #7e857b; font-size: 10px; }
.income-card { min-height: 126px; margin: 0 12px; display: grid; grid-template-columns: 1.18fr .82fr; overflow: hidden; background: #fff; border: 1px solid #e0e4de; border-radius: 8px; }.income-primary { padding: 19px; background: #20251f; color: #fff; }.income-primary > text:first-child { color: #bbc1b8; font-size: 10px; }.income-primary > view { margin-top: 8px; display: flex; align-items: baseline; }.income-primary > view text:first-child { margin-right: 4px; color: #9ed250; font-size: 14px; }.income-primary > view text:last-child { max-width: 145px; overflow: hidden; font-size: 27px; font-weight: 700; }.income-primary > text:last-child { display: block; margin-top: 9px; color: #7f887d; font-size: 8px; }.income-total { padding: 21px 15px; }.income-total > text:first-child { color: #92988f; font-size: 9px; }.income-total > text:nth-child(2) { display: block; margin-top: 9px; color: #9b6818; font-size: 17px; font-weight: 700; }.income-line { width: 32px; height: 3px; margin-top: 23px; background: #76b900; border-radius: 2px; }
.notice-swiper { height: 62px; margin: 10px 12px 0; background: #fff; border: 1px solid #e2e6df; border-radius: 8px; }.banner-row { height: 62px; padding: 9px 11px; box-sizing: border-box; display: flex; align-items: center; }.banner-row image,.banner-fallback { flex: 0 0 auto; width: 43px; height: 43px; margin-right: 10px; border-radius: 6px; }.banner-fallback { display: flex; align-items: center; justify-content: center; background: #edf3e7; color: #5f8e18; font-size: 15px; font-weight: 700; }.banner-row > view:nth-child(2),.banner-row > view:nth-child(1) + view { min-width: 0; flex: 1; }.banner-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.banner-row view text:first-child { font-size: 12px; font-weight: 600; }.banner-row view text:last-child { margin-top: 4px; color: #939990; font-size: 9px; }.banner-arrow { color: #afb5ac; font-size: 19px; }
.service-grid { margin: 0 12px; display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }.service-grid > navigator,.service-grid > view { min-width: 0; height: 112px; padding: 13px; box-sizing: border-box; background: #fff; border: 1px solid #e1e5df; border-radius: 8px; }.service-icon { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; border-radius: 7px; }.service-icon.green { background: #e9f3dc; color: #568507; }.service-icon.gold { background: #f8eddc; color: #a06b1a; font-size: 15px; }.service-icon.cyan { background: #e1f2f0; color: #1e7d78; }.service-grid text { display: block; }.service-grid > navigator > text:nth-child(2),.service-grid > view > text:nth-child(2) { margin-top: 10px; font-size: 12px; font-weight: 650; }.service-grid > navigator > text:last-child,.service-grid > view > text:last-child { margin-top: 3px; color: #979d94; font-size: 8px; }
.news-head { height: 58px; }.news-list { margin: 0 12px; overflow: hidden; background: #fff; border: 1px solid #e1e5df; border-radius: 8px; }.news-row { min-height: 65px; padding: 0 12px; display: flex; align-items: center; border-bottom: 1px solid #ecefeb; }.news-row:last-child { border-bottom: 0; }.news-mark { flex: 0 0 auto; width: 29px; height: 29px; margin-right: 11px; display: flex; align-items: center; justify-content: center; background: #f0f3ee; color: #6b7567; font-size: 10px; font-weight: 700; border-radius: 6px; }.news-row > view:nth-child(2) { min-width: 0; flex: 1; }.news-row view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.news-row view text:first-child { font-size: 12px; font-weight: 600; }.news-row view text:last-child { margin-top: 5px; color: #959b92; font-size: 9px; }.news-row > text { margin-left: 8px; color: #b2b7af; font-size: 19px; }.empty-news { padding: 27px; text-align: center; color: #999f97; font-size: 10px; }.safe-space { height: calc(80px + env(safe-area-inset-bottom)); }
