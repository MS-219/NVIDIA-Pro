<scroll-view class="page-scroll" scroll-y type="list">
  <view class="home-page">
    <view class="home-nav" style="padding-top: {{navBarTop}}px; height: {{navBarHeight}}px;">
      <view class="brand">
        <image class="brand-logo" src="/images/home-logo.png" mode="aspectFit"></image>
      </view>
      <view class="service-state {{syncState}}"><view></view><text>{{syncLabel}}</text></view>
    </view>

    <view class="hero">
      <view class="hero-copy">
        <view class="hero-protocol"><view></view><text>ORIN EDGE COMPUTE</text></view>
        <text class="hero-eyebrow">我的算力网络</text>
        <text class="hero-title">让每一台设备，</text>
        <text class="hero-title hero-title-second">持续创造价值</text>
        <view class="hero-action">
          <navigator url="/pages/device/device" open-type="switchTab">查看节点</navigator>
          <view class="hero-live {{statisticsError ? 'is-error' : ''}}"><view></view><text>{{statisticsError ? '同步异常' : (statisticsReady ? nodeStats.online + ' 台在线' : '同步中')}}</text></view>
        </view>
      </view>
      <view class="hero-media">
        <image class="hero-product" src="/images/product.png" mode="aspectFit"></image>
        <view class="media-grid"></view>
        <view class="media-status is-error" wx:if="{{statisticsError}}"><view></view><text>DATA LINK ERROR</text></view>
        <view class="media-status is-ready" wx:elif="{{statisticsReady && nodeStats.online}}"><view></view><text>TELEMETRY ACTIVE</text></view>
        <view class="media-status is-standby" wx:elif="{{statisticsReady}}"><view></view><text>TELEMETRY IDLE</text></view>
        <view class="media-status is-syncing" wx:else><view></view><text>SYNCING DATA</text></view>
        <view class="media-specs"><text>CUDA</text><text>ARM64</text><text>EDGE</text></view>
      </view>
    </view>

    <view class="overview-card">
      <view class="overview-title">
        <view><text>节点概况</text><text>设备状态实时同步</text></view>
        <view class="overview-badge"><view></view><text>{{statisticsReady ? nodeStats.total : '--'}} 台已接入</text></view>
      </view>
      <view class="overview-grid">
        <view class="overview-metric"><text>{{statisticsReady ? nodeStats.online : '--'}}</text><view class="metric-label"><view class="dot online"></view><text>在线运行</text></view></view>
        <view class="overview-metric"><text>{{statisticsReady ? nodeStats.offline : '--'}}</text><view class="metric-label"><view class="dot offline"></view><text>离线设备</text></view></view>
        <view class="overview-metric is-action" bindtap="goToPartnerDevices" hover-class="is-pressed"><text>{{statisticsReady ? (nodeStats.partnerDevices || 0) : '--'}}</text><view class="metric-label"><view class="dot partner"></view><text>团队节点</text></view></view>
      </view>
      <view class="network-health">
        <view class="network-health-head">
          <view><text>节点在线率</text><text wx:if="{{nodeStats.total}}">LIVE NETWORK</text><text wx:else>等待节点接入</text></view>
          <text wx:if="{{nodeStats.total}}">{{nodeStats.onlineRate}}%</text><text wx:else>--</text>
        </view>
        <view class="health-track"><view style="width: {{nodeStats.onlineRate}}%;"></view></view>
      </view>
    </view>

    <view class="section-head"><view class="section-title"><text>收益概览</text><text>COMPUTE REWARDS</text></view><navigator url="/pages/earnings-detail/earnings-detail">全部明细 ›</navigator></view>
    <view class="income-card">
      <view class="income-primary">
        <view class="income-label"><view><image src="/images/menu/earnings.png" mode="aspectFit"></image></view><text>昨日收益</text></view>
        <view class="income-value {{earnings.yesterdayClass}}"><text>¥</text><text>{{statisticsReady ? earnings.yesterday : '--'}}</text></view>
        <text class="income-note">每日完成结算后更新</text>
      </view>
      <view class="income-total"><text>累计收益</text><text class="income-total-value {{earnings.totalClass}}">¥{{statisticsReady ? earnings.total : '--'}}</text><view class="income-line"></view><text>全部结算记录</text></view>
    </view>

    <swiper class="notice-swiper" wx:if="{{bannerList.length}}" autoplay circular interval="5000" duration="350">
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <view class="banner-row" bindtap="onBannerTap" data-index="{{index}}" hover-class="is-pressed">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view class="banner-fallback" wx:else>讯</view>
          <view><text>{{item.title || '平台通知'}}</text><text>{{item.subtitle || '查看节点平台最新动态'}}</text></view>
          <text class="banner-arrow">›</text>
        </view>
      </swiper-item>
    </swiper>

    <view class="section-head"><view class="section-title"><text>常用服务</text><text>NODE OPERATIONS</text></view></view>
    <view class="service-grid">
      <navigator url="/pages/device/device" open-type="switchTab"><view class="service-icon green"><image src="/images/home-services/devices.png" mode="aspectFit"></image></view><text>节点设备</text><text>状态与管理</text></navigator>
      <navigator url="/pages/earnings-detail/earnings-detail"><view class="service-icon gold"><image src="/images/home-services/earnings.png" mode="aspectFit"></image></view><text>收益记录</text><text>结算与明细</text></navigator>
      <view bindtap="goToPartnerDevices"><view class="service-icon cyan"><image src="/images/home-services/team.png" mode="aspectFit"></image></view><text>团队节点</text><text>伙伴与设备</text></view>
    </view>

    <view class="section-head news-head"><view class="section-title"><text>平台动态</text><text>SYSTEM FEED</text></view></view>
    <view class="news-list">
      <block wx:if="{{notices.length}}">
        <view class="news-row" wx:for="{{notices}}" wx:key="id" bindtap="onNoticeTap" data-id="{{item.id}}">
          <view class="news-mark">{{index + 1}}</view>
          <view><text>{{item.title}}</text><text>{{item.content}}</text></view>
          <text>›</text>
        </view>
      </block>
      <view class="empty-news" wx:else>暂无平台动态</view>
    </view>
    <view class="safe-space"></view>
  </view>
</scroll-view>
