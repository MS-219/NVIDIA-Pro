@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed !important;
    color: #20251f;
}

.container {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 0 16px calc(28px + env(safe-area-inset-bottom));
}

page .custom-nav {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-bottom: 8px;
    background: transparent !important;
    border-bottom: 0 !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.nav-back {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    transition: opacity 120ms ease, transform 120ms ease;
}

.back-icon {
    color: #20251f;
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
}

.nav-title {
    flex: 1;
    margin-right: 44px;
    color: #20251f !important;
    font-size: 18px;
    font-weight: 700 !important;
    letter-spacing: 0;
    text-align: center;
}

page .overview-card {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    margin: 4px 0 14px;
    padding: 18px;
    background: #111510 !important;
    border: 1px solid rgba(118, 185, 0, .28) !important;
    border-radius: 8px !important;
    box-shadow: 0 9px 24px rgba(20, 28, 17, .14) !important;
    color: #f5f8f3;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.overview-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 18px;
    width: 58px;
    height: 3px;
    background: #76b900;
}

.console-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.console-copy,
.overview-main,
.item-info,
.result-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.console-kicker {
    color: #8dd214;
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
}

.console-caption {
    margin-top: 4px;
    color: rgba(245, 248, 243, .56);
    font-size: 12px;
}

.sync-state {
    flex: 0 0 auto;
    min-height: 24px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(118, 185, 0, .1);
    border: 1px solid rgba(118, 185, 0, .22);
    border-radius: 4px;
    color: #b9df78;
    font-size: 11px;
}

.sync-dot,
.source-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    background: #8dd214;
    border-radius: 50%;
}

.sync-state.is-loading .sync-dot {
    animation: pulse 1.1s ease-in-out infinite;
}

.sync-state.is-error {
    background: rgba(183, 122, 22, .12);
    border-color: rgba(217, 159, 61, .26);
    color: #e5bb71;
}

.sync-state.is-error .sync-dot {
    background: #d99f3d;
}

.overview-main {
    margin-top: 25px;
}

.overview-label {
    color: rgba(245, 248, 243, .62);
    font-size: 13px;
}

.amount-line {
    min-width: 0;
    margin-top: 5px;
    display: flex;
    align-items: baseline;
}

.amount-currency {
    margin-right: 5px;
    color: #8dd214;
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
    font-size: 19px;
    font-weight: 700;
}

.overview-amount {
    min-width: 0;
    color: #f7faf5;
    font-family: "DIN Alternate", "Avenir Next Condensed", "SFMono-Regular", monospace;
    font-size: 39px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    overflow-wrap: anywhere;
}

.amount-unit {
    margin-left: 8px;
    color: rgba(245, 248, 243, .42);
    font-family: "SFMono-Regular", monospace;
    font-size: 11px;
}

.overview-stats {
    margin-top: 20px;
    padding-top: 14px;
    display: flex;
    align-items: stretch;
    border-top: 1px solid rgba(245, 248, 243, .1);
}

.stat-item {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.stat-item:nth-child(3),
.stat-item:nth-child(5) {
    padding-left: 13px;
}

.stat-value {
    color: #f5f8f3;
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
}

.stat-unit {
    color: rgba(245, 248, 243, .5);
    font-size: 11px;
    font-weight: 500;
}

.stat-label {
    margin-top: 6px;
    color: rgba(245, 248, 243, .5);
    font-size: 11px;
}

.stat-divider {
    width: 1px;
    min-height: 34px;
    flex: 0 0 auto;
    background: rgba(245, 248, 243, .1);
}

.filter-panel {
    box-sizing: border-box;
    padding: 9px 12px;
    background: rgba(255, 255, 255, .8);
    border: 1px solid rgba(28, 33, 27, .08);
    border-radius: 8px;
}

.filter-row {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.filter-label {
    width: 54px;
    flex: 0 0 auto;
    color: #687065;
    font-size: 12px;
    font-weight: 600;
}

.filter-tabs {
    min-width: 0;
    flex: 1;
    display: flex;
    gap: 3px;
    padding: 3px;
    background: #edf0eb;
    border-radius: 6px;
}

.filter-tab {
    min-width: 0;
    min-height: 44px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 1px solid transparent;
    border-radius: 5px !important;
    color: #687065;
    font-size: 13px;
    transition: background 140ms ease, color 140ms ease, transform 120ms ease;
}

page .filter-tab.active {
    background: #ffffff !important;
    border-color: rgba(28, 33, 27, .08) !important;
    color: #375b00 !important;
    box-shadow: 0 2px 6px rgba(28, 33, 27, .06) !important;
    font-weight: 700;
}

.filter-divider {
    height: 1px;
    margin-left: 64px;
    background: rgba(28, 33, 27, .07);
}

page .sub-tabs-bar {
    min-width: 0;
    flex: 1;
    margin: 0;
    padding: 3px !important;
    background: #edf0eb !important;
    border: 0 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.sub-tabs {
    display: flex;
    gap: 3px;
}

.sub-tab {
    min-width: 0;
    min-height: 44px;
    flex: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 5px !important;
    color: #687065;
    font-size: 13px;
    transition: background 140ms ease, color 140ms ease, transform 120ms ease;
}

page .sub-tab.active {
    background: #ffffff !important;
    border-color: rgba(28, 33, 27, .08) !important;
    color: #375b00 !important;
    box-shadow: 0 2px 6px rgba(28, 33, 27, .06) !important;
    font-weight: 700;
}

.result-head {
    min-height: 58px;
    padding: 0 2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.result-title {
    color: #20251f;
    font-size: 15px;
    font-weight: 700;
}

.result-meta {
    margin-top: 3px;
    color: #858d82;
    font-size: 11px;
}

.source-label {
    min-height: 28px;
    flex: 0 0 auto;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(118, 185, 0, .09);
    border: 1px solid rgba(118, 185, 0, .18);
    border-radius: 4px;
    color: #4d7707;
    font-size: 11px;
}

.source-label.reward {
    background: rgba(183, 122, 22, .08);
    border-color: rgba(183, 122, 22, .18);
    color: #8d5d10;
}

.source-label.reward .source-dot {
    background: #b77a16;
}

.earnings-list {
    overflow: hidden;
    background: rgba(255, 255, 255, .82);
    border: 1px solid rgba(28, 33, 27, .08);
    border-radius: 8px;
}

.earnings-item {
    box-sizing: border-box;
    min-height: 76px;
    padding: 13px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid rgba(28, 33, 27, .07);
}

.earnings-item:last-child {
    border-bottom: 0;
}

.item-left {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
}

.source-mark {
    position: relative;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    box-sizing: border-box;
    padding: 8px 7px;
    background: rgba(118, 185, 0, .1);
    border: 1px solid rgba(118, 185, 0, .2);
    border-radius: 6px;
}

.source-mark .mark-node {
    width: 5px;
    height: 5px;
    background: #76b900;
    border-radius: 1px;
}

.source-mark .mark-line {
    height: 2px;
    margin-top: 4px;
    background: rgba(76, 118, 3, .72);
    border-radius: 1px;
}

.source-mark .mark-line.short {
    width: 12px;
}

.source-mark.reward-mark {
    background: rgba(183, 122, 22, .09);
    border-color: rgba(183, 122, 22, .2);
}

.reward-mark .mark-node {
    background: #b77a16;
}

.reward-mark .mark-line {
    background: rgba(141, 93, 16, .68);
}

.item-title {
    color: #252a24;
    font-size: 14px;
    font-weight: 650;
}

.item-desc {
    max-width: 100%;
    margin-top: 5px;
    overflow: hidden;
    color: #7b8378;
    font-family: "SFMono-Regular", monospace;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.item-right {
    max-width: 44%;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.item-amount {
    max-width: 100%;
    overflow: hidden;
    color: #4f7f00;
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
    font-size: 16px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.item-amount.reward-color {
    color: #9b6611 !important;
}

.item-time {
    max-width: 100%;
    margin-top: 6px;
    overflow: hidden;
    color: #8b9289;
    font-family: "SFMono-Regular", monospace;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

page .daily-table,
page .monthly-table {
    overflow: hidden;
    margin: 0;
    background: rgba(255, 255, 255, .82) !important;
    border: 1px solid rgba(28, 33, 27, .08) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.table-header,
.table-row {
    min-height: 46px;
    padding: 0 12px;
    display: flex;
    align-items: center;
}

.table-header {
    background: #1a2018;
}

.table-row {
    min-height: 56px;
    border-bottom: 1px solid rgba(28, 33, 27, .07);
}

.table-row:last-child {
    border-bottom: 0;
}

.th {
    color: rgba(247, 250, 245, .65);
    font-size: 11px;
    font-weight: 600;
}

.td {
    min-width: 0;
    color: #40473e;
    font-size: 12px;
}

.numeric,
.amount-col {
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
}

.month-col,
.date-col {
    flex: 1.12;
}

.device-col {
    min-width: 0;
    flex: 1.2;
    text-align: center;
}

.amount-col {
    flex: 1;
    color: #4f7f00;
    font-weight: 700;
    text-align: right;
}

.th.amount-col {
    color: #a7cf66;
}

.td.device-col.multi-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.25;
}

.td.device-col.multi-line .main-text,
.td.device-col.multi-line .sub-text {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.td.device-col.multi-line .main-text {
    color: #40473e;
    font-size: 12px;
    font-weight: 600;
}

.td.device-col.multi-line .sub-text {
    margin-top: 4px;
    color: #8b9289;
    font-family: "SFMono-Regular", monospace;
    font-size: 11px;
}

.state-panel {
    box-sizing: border-box;
    min-height: 238px;
    padding: 45px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, .68);
    border: 1px solid rgba(28, 33, 27, .08);
    border-radius: 8px;
    color: #747c71;
    text-align: center;
}

.loading-spinner {
    width: 30px;
    height: 30px;
    box-sizing: border-box;
    margin-bottom: 18px;
    border: 3px solid rgba(118, 185, 0, .18);
    border-top-color: #76b900;
    border-radius: 50%;
    animation: spin .72s linear infinite;
}

.state-title {
    color: #343a32;
    font-size: 15px;
    font-weight: 700;
}

.state-desc {
    max-width: 250px;
    margin-top: 8px;
    color: #7b8378;
    font-size: 12px;
    line-height: 1.55;
}

.error-glyph {
    width: 38px;
    height: 38px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(183, 122, 22, .08);
    border: 1px solid rgba(183, 122, 22, .28);
    border-radius: 50%;
    color: #9b6611;
    font-family: "SFMono-Regular", monospace;
    font-size: 20px;
    font-weight: 700;
}

.retry-button {
    box-sizing: border-box;
    min-width: 128px;
    min-height: 44px;
    margin-top: 20px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #76b900;
    border-radius: 6px;
    color: #111510;
    font-size: 13px;
    font-weight: 700;
    transition: opacity 120ms ease, transform 120ms ease;
}

.empty-glyph {
    position: relative;
    width: 48px;
    height: 42px;
    margin-bottom: 18px;
    border-left: 1px solid #a8afa5;
    border-bottom: 1px solid #a8afa5;
}

.glyph-bar {
    position: absolute;
    bottom: 0;
    width: 7px;
    background: #d7dbd4;
    border-top: 2px solid #76b900;
}

.glyph-bar.bar-one {
    left: 8px;
    height: 13px;
}

.glyph-bar.bar-two {
    left: 21px;
    height: 24px;
}

.glyph-bar.bar-three {
    left: 34px;
    height: 8px;
}

.load-more {
    min-height: 48px;
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #5e675b;
    font-size: 12px;
    transition: opacity 120ms ease, transform 120ms ease;
}

.load-more-spinner {
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 2px solid rgba(118, 185, 0, .2);
    border-top-color: #76b900;
    border-radius: 50%;
    animation: spin .72s linear infinite;
}

.list-end {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #92998f;
    font-size: 11px;
}

.list-end view {
    width: 26px;
    height: 1px;
    background: rgba(28, 33, 27, .12);
}

.tap-muted {
    opacity: .68;
    transform: scale(.985);
}

.tap-strong {
    opacity: .82;
    transform: scale(.98);
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes pulse {
    0%,
    100% {
        opacity: .35;
        transform: scale(.82);
    }

    50% {
        opacity: 1;
        transform: scale(1);
    }
}
