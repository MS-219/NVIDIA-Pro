<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px;">
        <view
            class="nav-back"
            bindtap="goBack"
            hover-class="tap-muted"
            hover-stay-time="80"
            aria-role="button"
            aria-label="返回"
        >
            <text class="back-icon">‹</text>
        </view>
        <text class="nav-title">收益明细</text>
    </view>

    <view class="overview-card">
        <view class="console-head">
            <view class="console-copy">
                <text class="console-kicker">ORIN EARNINGS LEDGER</text>
                <text class="console-caption">边缘节点收益账本</text>
            </view>
            <view class="sync-state {{overviewLoading ? 'is-loading' : overviewError ? 'is-error' : ''}}">
                <view class="sync-dot"></view>
                <text>{{overviewLoading ? '同步中' : overviewError ? '数据延迟' : '已同步'}}</text>
            </view>
        </view>

        <view class="overview-main">
            <text class="overview-label">累计收益</text>
            <view class="amount-line">
                <text class="amount-currency">¥</text>
                <text class="overview-amount">{{totalEarnings}}</text>
                <text class="amount-unit">CNY</text>
            </view>
        </view>

        <view class="overview-stats">
            <view class="stat-item">
                <text class="stat-value">¥{{yesterdayEarnings}}</text>
                <text class="stat-label">昨日收益</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-value">¥{{monthEarnings}}</text>
                <text class="stat-label">本月收益</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-value">{{deviceCount}}<text class="stat-unit"> 台</text></text>
                <text class="stat-label">在线设备</text>
            </view>
        </view>
    </view>

    <view class="filter-panel">
        <view class="filter-row">
            <text class="filter-label">统计周期</text>
            <view class="filter-tabs">
                <view
                    class="filter-tab {{filter === 'all' ? 'active' : ''}}"
                    bindtap="setFilter"
                    data-filter="all"
                    hover-class="tap-muted"
                    hover-stay-time="80"
                >全部</view>
                <view
                    class="filter-tab {{filter === 'day' ? 'active' : ''}}"
                    bindtap="setFilter"
                    data-filter="day"
                    hover-class="tap-muted"
                    hover-stay-time="80"
                >按日</view>
                <view
                    class="filter-tab {{filter === 'month' ? 'active' : ''}}"
                    bindtap="setFilter"
                    data-filter="month"
                    hover-class="tap-muted"
                    hover-stay-time="80"
                >按月</view>
            </view>
        </view>

        <view class="filter-divider"></view>

        <view class="filter-row">
            <text class="filter-label">收益来源</text>
            <view class="sub-tabs-bar">
                <view class="sub-tabs">
                    <view
                        class="sub-tab {{subFilter === 'device' ? 'active' : ''}}"
                        bindtap="setSubFilter"
                        data-sub="device"
                        hover-class="tap-muted"
                        hover-stay-time="80"
                    >设备收益</view>
                    <view
                        class="sub-tab {{subFilter === 'reward' ? 'active' : ''}}"
                        bindtap="setSubFilter"
                        data-sub="reward"
                        hover-class="tap-muted"
                        hover-stay-time="80"
                    >分润收益</view>
                </view>
            </view>
        </view>
    </view>

    <view class="result-head">
        <view class="result-copy">
            <text class="result-title">{{filter === 'month' ? '月度汇总' : filter === 'day' ? '日度结算' : '收益记录'}}</text>
            <text class="result-meta">{{contentState === 'ready' ? currentCount + ' 条结果' : '按结算时间排序'}}</text>
        </view>
        <view class="source-label {{subFilter === 'reward' ? 'reward' : ''}}">
            <view class="source-dot"></view>
            <text>{{subFilter === 'device' ? '设备节点' : '团队分润'}}</text>
        </view>
    </view>

    <block wx:if="{{contentState === 'ready'}}">
        <view class="earnings-list" wx:if="{{filter === 'all' && subFilter === 'device'}}">
            <view class="earnings-item" wx:for="{{records}}" wx:key="id">
                <view class="item-left">
                    <view class="source-mark device-mark" aria-hidden="true">
                        <view class="mark-node"></view>
                        <view class="mark-line"></view>
                        <view class="mark-line short"></view>
                    </view>
                    <view class="item-info">
                        <text class="item-title">设备收益</text>
                        <text class="item-desc">{{item.deviceSn || '设备收益结算'}}</text>
                    </view>
                </view>
                <view class="item-right">
                    <text class="item-amount">+¥{{item.earnings || item.amount || '0.00'}}</text>
                    <text class="item-time">{{item.createTimeFormatted || item.earningsDate || item.date || '--'}}</text>
                </view>
            </view>
        </view>

        <view class="earnings-list" wx:if="{{filter === 'all' && subFilter === 'reward'}}">
            <view class="earnings-item" wx:for="{{rewards}}" wx:key="id">
                <view class="item-left">
                    <view class="source-mark reward-mark" aria-hidden="true">
                        <view class="mark-node"></view>
                        <view class="mark-line"></view>
                        <view class="mark-line short"></view>
                    </view>
                    <view class="item-info">
                        <text class="item-title">团队分润</text>
                        <text class="item-desc">{{item.inviteeName || '团队成员'}} · {{item.deviceSn || '节点设备'}}</text>
                    </view>
                </view>
                <view class="item-right">
                    <text class="item-amount reward-color">+¥{{item.reward || '0.00'}}</text>
                    <text class="item-time">{{item.createTime || '--'}}</text>
                </view>
            </view>
        </view>

        <view class="daily-table" wx:if="{{filter === 'day'}}">
            <view class="table-header">
                <text class="th date-col">日期</text>
                <text class="th device-col">收益来源</text>
                <text class="th amount-col">{{subFilter === 'device' ? '设备收益' : '分润收益'}}</text>
            </view>
            <view class="table-row" wx:for="{{visibleDailyData}}" wx:key="index">
                <text class="td date-col numeric">{{item.date}}</text>
                <view class="td device-col multi-line">
                    <block wx:if="{{subFilter === 'reward'}}">
                        <text class="main-text">{{item.inviteeName || '团队成员'}}</text>
                        <text class="sub-text">{{item.deviceSn || '节点设备'}}</text>
                    </block>
                    <block wx:else>
                        <text class="main-text">{{item.deviceSn || '节点设备'}}</text>
                        <text class="sub-text">我的设备</text>
                    </block>
                </view>
                <text class="td amount-col numeric">+¥{{subFilter === 'device' ? (item.deviceAmount || item.amount || '0.00') : (item.rewardAmount || '0.00')}}</text>
            </view>
        </view>

        <view class="monthly-table" wx:if="{{filter === 'month'}}">
            <view class="table-header">
                <text class="th month-col">月份</text>
                <text class="th device-col">{{subFilter === 'device' ? '我的设备' : '团队设备'}}</text>
                <text class="th amount-col">{{subFilter === 'device' ? '设备收益' : '分润收益'}}</text>
            </view>
            <view class="table-row" wx:for="{{visibleMonthlyData}}" wx:key="month">
                <text class="td month-col numeric">{{item.month}}</text>
                <text class="td device-col numeric">{{subFilter === 'device' ? (item.deviceCount || 0) : (item.rewardDeviceCount || 0)}} 台</text>
                <text class="td amount-col numeric">+¥{{subFilter === 'device' ? (item.deviceAmount || item.totalAmount || '0.00') : (item.rewardAmount || '0.00')}}</text>
            </view>
        </view>
    </block>

    <view class="state-panel loading-state" wx:if="{{contentState === 'loading'}}">
        <view class="loading-spinner"></view>
        <text class="state-title">正在同步收益数据</text>
        <text class="state-desc">正在读取最新结算记录</text>
    </view>

    <view class="state-panel error-state" wx:if="{{contentState === 'error'}}">
        <view class="error-glyph"><text>!</text></view>
        <text class="state-title">数据同步中断</text>
        <text class="state-desc">{{contentError}}</text>
        <view
            class="retry-button"
            bindtap="retryContent"
            hover-class="tap-strong"
            hover-stay-time="80"
            aria-role="button"
        >重新加载</view>
    </view>

    <view class="state-panel empty-state" wx:if="{{contentState === 'empty'}}">
        <view class="empty-glyph" aria-hidden="true">
            <view class="glyph-bar bar-one"></view>
            <view class="glyph-bar bar-two"></view>
            <view class="glyph-bar bar-three"></view>
        </view>
        <text class="state-title">{{emptyTitle}}</text>
        <text class="state-desc">{{emptyDescription}}</text>
    </view>

    <view
        class="load-more {{loading ? 'is-loading' : ''}}"
        wx:if="{{filter === 'all' && subFilter === 'device' && records.length > 0 && (hasMore || errorMessage)}}"
        bindtap="loadMore"
        hover-class="tap-muted"
        hover-stay-time="80"
        aria-role="button"
    >
        <view class="load-more-spinner" wx:if="{{loading}}"></view>
        <text>{{loading ? '正在加载' : errorMessage ? '加载中断，点击重试' : '加载更多'}}</text>
    </view>

    <view class="list-end" wx:if="{{filter === 'all' && subFilter === 'device' && records.length > 0 && !hasMore && !loading}}">
        <view></view>
        <text>记录已全部加载</text>
        <view></view>
    </view>
</view>
