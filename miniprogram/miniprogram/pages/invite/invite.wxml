<view class="container">
    <view class="custom-nav" style="padding-top: {{navBarTop}}px;">
        <view class="nav-back" bindtap="goBack" hover-class="tap-muted" hover-stay-time="80" aria-role="button" aria-label="返回">
            <text class="back-icon">‹</text>
        </view>
        <text class="nav-title">邀请好友</text>
    </view>

    <view class="invite-card">
        <view class="console-head">
            <view class="console-identity">
                <view class="anchor-icon"><image src="/images/menu/invite.png" mode="aspectFit"></image></view>
                <view class="console-copy">
                    <text class="console-kicker">团队邀请</text>
                    <text class="console-caption">邀请网络</text>
                </view>
            </view>
            <view class="sync-state {{loading ? 'is-loading' : inviteError ? 'is-error' : ''}}">
                <view class="sync-dot"></view>
                <text>{{loading ? '同步中' : inviteError ? '数据延迟' : '已激活'}}</text>
            </view>
        </view>

        <view class="card-header">
            <text class="card-title">共享算力收益</text>
            <text class="card-subtitle">邀请好友绑定设备，持续积累团队奖励</text>
        </view>

        <view class="invite-code-section">
            <text class="code-label">专属邀请码</text>
            <view class="code-box">
                <text class="code-text">{{inviteCode || '------'}}</text>
                <button class="copy-btn" bindtap="copyInviteCode" hover-class="tap-strong" hover-stay-time="80">复制</button>
            </view>
        </view>

        <button class="share-btn" open-type="share" hover-class="tap-strong" hover-stay-time="80">
            <image class="share-icon" src="/images/menu/invite.png" mode="aspectFit"></image>
            <text>分享邀请链接</text>
        </button>
    </view>

    <view class="stats-card">
        <view class="section-heading">
            <text class="section-title">团队遥测</text>
            <text class="section-code">实时数据</text>
        </view>
        <view class="stats-row">
            <view class="stat-item">
                <text class="stat-num">{{inviteCount}}</text>
                <text class="stat-label">邀请人数</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-num reward">¥{{totalReward}}</text>
                <text class="stat-label">累计奖励</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-num online">{{onlineDeviceCount}}</text>
                <text class="stat-label">在线设备</text>
            </view>
        </view>
    </view>

    <view class="level-status-card">
        <view class="section-heading">
            <view class="current-level">
                <text class="level-tag">当前等级</text>
                <text class="level-name">{{currentLevelName}}</text>
            </view>
            <text class="device-total">{{totalDeviceCount}} 台团队设备</text>
        </view>
        <view class="progress-section">
            <text class="next-tip">{{nextLevelDesc || '等级数据同步中'}}</text>
            <view class="progress-bar-bg" wx:if="{{nextLevelConfig}}">
                <view class="progress-bar-fill" style="width: {{(totalDeviceCount / nextLevelConfig.threshold) * 100 > 100 ? 100 : (totalDeviceCount / nextLevelConfig.threshold) * 100}}%"></view>
            </view>
        </view>
    </view>

    <view class="inviter-card">
        <view class="section-heading">
            <text class="section-title">我的邀请人</text>
            <text class="section-code">邀请入口</text>
        </view>
        <view class="inviter-bound" wx:if="{{hasInviter}}">
            <view class="inviter-avatar">
                <image src="{{inviterAvatar}}" mode="aspectFill" wx:if="{{inviterAvatar}}"></image>
                <image class="avatar-fallback" src="/images/menu/invite.png" mode="aspectFit" wx:else></image>
            </view>
            <text class="inviter-name">{{inviterNickname}}</text>
            <text class="bound-tag">已绑定</text>
        </view>
        <view class="inviter-unbound" wx:else>
            <view class="bind-input-row" wx:if="{{showBindInput}}">
                <input class="code-input" placeholder="请输入邀请码" value="{{inputCode}}" bindinput="onInputCode" maxlength="20" />
                <button class="bind-btn" bindtap="submitBindCode" hover-class="tap-strong" hover-stay-time="80">绑定</button>
                <button class="cancel-btn" bindtap="cancelBind" hover-class="tap-muted" hover-stay-time="80">取消</button>
            </view>
            <view class="bind-prompt" wx:else bindtap="showBindInput" hover-class="tap-muted" hover-stay-time="80" aria-role="button">
                <text class="prompt-text">还没有邀请人</text>
                <text class="prompt-link">填写邀请码</text>
            </view>
        </view>
    </view>

    <view class="users-card">
        <view class="section-heading">
            <view>
                <text class="section-title">已邀请用户</text>
                <text class="section-subtitle">按注册时间排列</text>
            </view>
            <text class="section-count">{{invitedUsers.length}} 人</text>
        </view>

        <view class="user-list" wx:if="{{!loading && !inviteError && invitedUsers.length > 0}}">
            <view class="user-item" wx:for="{{invitedUsers}}" wx:key="id">
                <view class="user-avatar">
                    <image src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}"></image>
                    <image class="avatar-fallback" src="/images/menu/invite.png" mode="aspectFit" wx:else></image>
                </view>
                <view class="user-info">
                    <text class="user-name">{{item.nickname}}</text>
                    <text class="user-time">{{item.registerTime || '--'}} 注册</text>
                </view>
                <view class="user-reward">
                    <text class="reward-amount {{item.deviceCount > 0 ? '' : 'zero'}}">{{item.deviceCount || 0}} 台</text>
                    <text class="reward-label">设备</text>
                    <text class="reward-amount highlight">+¥{{item.reward || '0.00'}}</text>
                    <text class="reward-label">贡献收益</text>
                </view>
            </view>
        </view>

        <view class="users-state" wx:if="{{loading}}">
            <view class="loading-spinner"></view>
            <text class="state-title">正在同步团队数据</text>
            <text class="state-desc">正在读取最新邀请关系</text>
        </view>

        <view class="users-state" wx:if="{{!loading && inviteError}}">
            <view class="error-glyph">!</view>
            <text class="state-title">团队数据同步中断</text>
            <text class="state-desc">{{inviteError}}</text>
            <view class="retry-btn" bindtap="retryInviteInfo" hover-class="tap-strong" hover-stay-time="80" aria-role="button">重新加载</view>
        </view>

        <view class="users-state" wx:if="{{!loading && !inviteError && invitedUsers.length === 0}}">
            <image class="empty-image" src="/images/menu/invite.png" mode="aspectFit"></image>
            <text class="state-title">暂无邀请用户</text>
            <text class="state-desc">分享邀请码后，成功加入的好友会显示在这里</text>
        </view>
    </view>

    <view class="rules-card">
        <view class="section-heading">
            <text class="section-title">邀请规则</text>
            <text class="section-code">三步完成</text>
        </view>
        <view class="rule-item">
            <text class="rule-num">01</text>
            <text class="rule-text">分享专属邀请链接给好友</text>
        </view>
        <view class="rule-item">
            <text class="rule-num">02</text>
            <text class="rule-text">好友通过链接注册并绑定设备</text>
        </view>
        <view class="rule-item">
            <text class="rule-num">03</text>
            <text class="rule-text">好友产生收益，您获得相应奖励</text>
        </view>
    </view>
</view>
