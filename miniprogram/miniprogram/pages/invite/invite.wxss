@import "../../styles/orin-polish.wxss";

page {
    min-height: 100vh;
    background: #eef1ed !important;
    color: #20251f;
}

.container {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 0 16px calc(30px + env(safe-area-inset-bottom));
}

page .custom-nav {
    min-height: 44px;
    padding-bottom: 8px;
    display: flex;
    align-items: center;
    background: transparent !important;
    border-bottom: 0;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.nav-back {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    transition: opacity 120ms ease, transform 120ms ease;
}

.back-icon {
    color: #20251f;
    font-size: 30px;
    line-height: 1;
}

.nav-title {
    flex: 1;
    margin-right: 44px;
    color: #20251f !important;
    font-size: 18px;
    font-weight: 700 !important;
    text-align: center;
}

page .invite-card {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    margin-bottom: 12px;
    padding: 18px;
    background: #111510 !important;
    border: 1px solid rgba(118, 185, 0, .27) !important;
    border-radius: 8px !important;
    box-shadow: 0 9px 24px rgba(20, 28, 17, .14) !important;
    color: #f6f9f4;
}

.invite-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 18px;
    width: 58px;
    height: 3px;
    background: #76b900;
}

.console-head,
.console-identity,
.section-heading,
.code-box,
.stats-row,
.inviter-bound,
.bind-input-row {
    display: flex;
    align-items: center;
}

.console-head,
.section-heading {
    justify-content: space-between;
    gap: 12px;
}

.console-identity {
    min-width: 0;
    gap: 10px;
}

.anchor-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(118, 185, 0, .13);
    border: 1px solid rgba(118, 185, 0, .24);
    border-radius: 6px;
}

.anchor-icon image {
    width: 22px;
    height: 22px;
}

.console-copy,
.current-level,
.user-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.console-kicker,
.section-code,
.code-text,
.stat-num,
.device-total,
.section-count,
.user-time,
.reward-amount,
.rule-num {
    font-family: "DIN Alternate", "SFMono-Regular", monospace;
}

.console-kicker {
    color: #8dd214;
    font-size: 11px;
    font-weight: 700;
}

.console-caption {
    margin-top: 3px;
    color: rgba(246, 249, 244, .56);
    font-size: 12px;
}

.sync-state {
    min-height: 26px;
    flex: 0 0 auto;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(118, 185, 0, .1);
    border: 1px solid rgba(118, 185, 0, .22);
    border-radius: 4px;
    color: #b9df78;
    font-size: 11px;
}

.sync-dot {
    width: 6px;
    height: 6px;
    background: #8dd214;
    border-radius: 50%;
}

.sync-state.is-loading .sync-dot {
    animation: pulse 1.1s ease-in-out infinite;
}

.sync-state.is-error {
    background: rgba(183, 122, 22, .12);
    border-color: rgba(183, 122, 22, .26);
    color: #e2b76e;
}

.sync-state.is-error .sync-dot {
    background: #d99f3d;
}

.card-header {
    margin-top: 23px;
}

.card-title,
.card-subtitle {
    display: block;
}

.card-title {
    color: #f6f9f4;
    font-size: 22px;
    font-weight: 700;
}

.card-subtitle {
    margin-top: 7px;
    color: rgba(246, 249, 244, .58);
    font-size: 13px;
    line-height: 1.45;
}

.invite-code-section {
    margin-top: 23px;
}

.code-label {
    display: block;
    margin-bottom: 8px;
    color: rgba(246, 249, 244, .58);
    font-size: 12px;
}

.code-box {
    min-height: 58px;
    box-sizing: border-box;
    padding: 7px 7px 7px 13px;
    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: 6px;
}

.code-text {
    min-width: 0;
    flex: 1;
    color: #f7faf5;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0;
}

page .copy-btn {
    width: 72px;
    min-width: 72px;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, .94) !important;
    border: 0 !important;
    border-radius: 5px !important;
    color: #385d00 !important;
    font-size: 13px !important;
    font-weight: 700;
    line-height: 44px;
}

.copy-btn::after,
.share-btn::after,
.bind-btn::after,
.cancel-btn::after {
    border: 0;
}

page .share-btn {
    width: 100%;
    height: 46px;
    min-height: 46px;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #76b900 !important;
    border-radius: 6px !important;
    color: #111510 !important;
    font-size: 14px !important;
    font-weight: 700;
    line-height: 46px;
}

.share-icon {
    width: 20px;
    height: 20px;
}

.stats-card,
.level-status-card,
.inviter-card,
.users-card,
.rules-card {
    box-sizing: border-box;
    margin-bottom: 12px;
    padding: 16px;
    background: rgba(255, 255, 255, .94) !important;
    border: 1px solid rgba(28, 33, 27, .075) !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

.section-heading {
    min-height: 34px;
    margin-bottom: 13px;
}

.section-title {
    display: block;
    color: #252a24;
    font-size: 14px;
    font-weight: 700;
}

.section-subtitle {
    display: block;
    margin-top: 3px;
    color: #848c81;
    font-size: 11px;
}

.section-code,
.section-count {
    color: #7f887c;
    font-size: 11px;
}

.stats-row {
    min-height: 70px;
}

.stat-item {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.stat-item:nth-child(3),
.stat-item:nth-child(5) {
    padding-left: 12px;
}

.stat-num {
    max-width: 100%;
    color: #20251f;
    font-size: 20px;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.stat-num.reward {
    color: #4f7f00;
}

.stat-num.online {
    color: #237973;
}

.stat-label {
    margin-top: 7px;
    color: #7b8378;
    font-size: 11px;
}

.stat-divider {
    width: 1px;
    height: 42px;
    background: rgba(28, 33, 27, .09);
}

.level-tag {
    color: #7b8378;
    font-size: 11px;
}

.level-name {
    margin-top: 3px;
    color: #4f7f00;
    font-size: 17px;
    font-weight: 700;
}

.device-total {
    color: #5f675d;
    font-size: 12px;
}

.progress-section {
    display: flex;
    flex-direction: column;
}

.next-tip {
    color: #687065;
    font-size: 12px;
}

.progress-bar-bg {
    height: 7px;
    margin-top: 12px;
    overflow: hidden;
    background: #e5e9e2;
    border-radius: 4px;
}

.progress-bar-fill {
    height: 100%;
    background: #76b900;
    border-radius: 4px;
    transition: width 260ms ease;
}

.inviter-bound {
    min-height: 54px;
}

.inviter-avatar,
.user-avatar {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #edf0eb;
    border-radius: 50%;
}

.inviter-avatar {
    margin-right: 11px;
}

.inviter-avatar image,
.user-avatar image {
    width: 100%;
    height: 100%;
}

.inviter-avatar .avatar-fallback,
.user-avatar .avatar-fallback {
    width: 21px;
    height: 21px;
}

.inviter-name {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    color: #30362e;
    font-size: 14px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bound-tag {
    min-height: 26px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    background: rgba(118, 185, 0, .11);
    border: 1px solid rgba(118, 185, 0, .19);
    border-radius: 4px;
    color: #4f7f00;
    font-size: 11px;
}

.inviter-unbound {
    min-height: 44px;
}

.bind-prompt {
    min-height: 44px;
    padding: 0 !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    transition: opacity 120ms ease, transform 120ms ease;
}

.prompt-text {
    color: #747c71;
    font-size: 13px;
}

.prompt-link {
    color: #4f7f00;
    font-size: 13px;
    font-weight: 700;
}

.bind-input-row {
    gap: 8px;
}

.code-input {
    min-width: 0;
    height: 44px;
    flex: 1;
    padding: 0 11px;
    font-family: "SFMono-Regular", monospace;
}

page .bind-btn,
page .cancel-btn {
    width: 58px !important;
    min-width: 58px;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 6px !important;
    font-size: 12px !important;
    line-height: 44px;
}

page .bind-btn {
    background: #76b900 !important;
    color: #111510 !important;
}

page .cancel-btn {
    background: #ecefeb !important;
    color: #626a60 !important;
}

.user-list {
    border-top: 1px solid rgba(28, 33, 27, .07);
}

.user-item {
    min-height: 78px;
    padding: 12px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid rgba(28, 33, 27, .07);
}

.user-item:last-child {
    border-bottom: 0;
}

.user-name {
    overflow: hidden;
    color: #30362e;
    font-size: 14px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.user-time {
    margin-top: 5px;
    color: #848c81;
    font-size: 11px;
}

.user-reward {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 6px;
    row-gap: 3px;
    align-items: baseline;
    text-align: right;
}

.reward-amount {
    color: #4f7f00;
    font-size: 13px;
    font-weight: 700;
}

.reward-amount.highlight {
    color: #976311;
}

.reward-amount.zero {
    color: #899185;
    font-weight: 500;
}

.reward-label {
    color: #899185;
    font-size: 11px;
}

.users-state {
    min-height: 190px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.loading-spinner {
    width: 28px;
    height: 28px;
    box-sizing: border-box;
    margin-bottom: 15px;
    border: 3px solid rgba(118, 185, 0, .17);
    border-top-color: #76b900;
    border-radius: 50%;
    animation: spin .72s linear infinite;
}

.error-glyph {
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(183, 122, 22, .08);
    border: 1px solid rgba(183, 122, 22, .25);
    border-radius: 50%;
    color: #976311;
    font-family: "SFMono-Regular", monospace;
    font-size: 18px;
    font-weight: 700;
}

.empty-image {
    width: 38px;
    height: 38px;
    margin-bottom: 14px;
    opacity: .62;
}

.state-title {
    color: #343a32;
    font-size: 14px;
    font-weight: 700;
}

.state-desc {
    max-width: 250px;
    margin-top: 7px;
    color: #7b8378;
    font-size: 12px;
    line-height: 1.5;
}

.retry-btn {
    min-width: 124px;
    min-height: 44px;
    margin-top: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #76b900;
    border-radius: 6px;
    color: #111510;
    font-size: 13px;
    font-weight: 700;
    transition: opacity 120ms ease, transform 120ms ease;
}

.rule-item {
    min-height: 44px;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(28, 33, 27, .07);
}

.rule-num {
    width: 34px;
    flex: 0 0 auto;
    color: #4f7f00;
    font-size: 11px;
    font-weight: 700;
}

.rule-text {
    flex: 1;
    color: #4a5147;
    font-size: 13px;
}

.tap-muted {
    opacity: .68;
    transform: scale(.985);
}

.tap-strong {
    opacity: .82;
    transform: scale(.98);
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes pulse {
    0%,
    100% {
        opacity: .35;
        transform: scale(.82);
    }

    50% {
        opacity: 1;
        transform: scale(1);
    }
}
