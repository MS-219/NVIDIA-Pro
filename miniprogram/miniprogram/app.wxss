/**app.wxss**/
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  height: 100%;
  background: #f4f5f3;
  color: #171a17;
}

.container {
  min-height: 100%;
  height: auto;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.jx-nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 20px;
  padding-right: 100px;
  background: #ffffff;
  border-bottom: 1px solid #e5e8e3;
}

.jx-nav-title {
  font-size: 18px;
  font-weight: 700;
  color: #171a17;
}

.jx-kicker {
  display: block;
  font-size: 10px;
  line-height: 1.2;
  color: #6f756d;
  text-transform: uppercase;
}

.jx-section-title {
  font-size: 17px;
  font-weight: 700;
  color: #171a17;
}

.jx-section-subtitle {
  font-size: 12px;
  color: #858b82;
}
