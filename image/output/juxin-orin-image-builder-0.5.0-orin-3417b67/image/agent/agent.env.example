# Image-wide values written into image.env by the image builder.
ORIN_API_BASE_URL=https://nvidia.juxinsuanli.cn
ORIN_AGENT_VERSION=0.5.0-orin
ORIN_IMAGE_VERSION=orin-l4t-36.4.7-v1
ORIN_HEARTBEAT_INTERVAL=60
ORIN_TASK_POLL_INTERVAL=60
ORIN_TASK_TIMEOUT=240
ORIN_REQUEST_RETRIES=2
ORIN_STATE_DIR=/var/lib/juxin-orin

# These values are generated independently on every device during first boot.
# ORIN_DEVICE_SN=ORIN-XXXXXXXXXXXX
# ORIN_HARDWARE_FINGERPRINT=<64 hex characters>
