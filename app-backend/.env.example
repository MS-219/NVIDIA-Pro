# Independent APP backend. Keep this file as a template; never commit real values.
APP_SERVER_PORT=8091
APP_DB_URL=jdbc:mysql://127.0.0.1:3306/orin_app?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
APP_DB_USERNAME=orin_app
APP_DB_PASSWORD=replace-with-a-strong-password
# Optional legacy二开库同步（按手机号同步二开后台创建的虚拟设备）
APP_NODE_DB_URL=jdbc:mysql://juxin-node-mysql:3306/juxin_node?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
APP_NODE_DB_USERNAME=juxin_node
APP_NODE_DB_PASSWORD=replace-with-juxin-node-db-password
APP_MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
APP_BACKEND_PORT=18091
APP_PUBLIC_BASE_URL=https://jd.ldjuxin.yun
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_SMS_PROVIDER=aliyun
APP_SMS_PEPPER=replace-with-a-separate-random-secret
APP_SMS_CODE_TTL_SECONDS=300
APP_SMS_COOLDOWN_SECONDS=60
APP_SMS_MAX_ATTEMPTS=5

# Alibaba Cloud RAM sub-account credentials. Do not put these in the mobile app.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=
ALI_SMS_CODE_PARAMETER_NAME=code
ALI_SMS_CONNECT_TIMEOUT_MILLIS=5000
ALI_SMS_READ_TIMEOUT_MILLIS=10000
